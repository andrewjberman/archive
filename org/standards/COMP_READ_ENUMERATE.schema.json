{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opal.local/schemas/COMP_READ_ENUMERATE.schema.json",
  "title": "comp-read enumerate result",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "rows"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hits", "lines", "sections", "whole", "sub", "bands", "warn"],
      "properties": {
        "hits": {"type": "integer", "minimum": 0},
        "lines": {"type": "integer", "minimum": 0},
        "sections": {"type": "integer", "minimum": 0},
        "whole": {"type": "integer", "minimum": 0},
        "sub": {"type": "integer", "minimum": 0},
        "bands": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "warn": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "band", "match", "hit", "text"],
        "properties": {
          "line": {"type": "integer", "minimum": 0},
          "band": {"type": "string", "minLength": 1},
          "match": {"enum": ["WHOLE", "SUB", "ABSENT", "ERROR"]},
          "hit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "total"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0}
            }
          },
          "text": {"type": "string"}
        }
      }
    }
  }
}

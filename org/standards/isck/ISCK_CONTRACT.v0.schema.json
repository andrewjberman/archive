{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opal:standards:isck:contract:v0.1",
  "title": "ISCK Identity-State Contract v0.1 (DRAFT - boundary revision of the adversarial pass round 1; see ISCK_CONTRACT.md)",
  "oneOf": [
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/entity_binding"
    },
    {
      "$ref": "#/$defs/state_observation"
    },
    {
      "$ref": "#/$defs/identity_relation"
    },
    {
      "$ref": "#/$defs/materializer"
    },
    {
      "$ref": "#/$defs/materializer_version"
    },
    {
      "$ref": "#/$defs/materialization_run"
    },
    {
      "$ref": "#/$defs/source_frontier"
    },
    {
      "$ref": "#/$defs/surface_version"
    },
    {
      "$ref": "#/$defs/coherence_evaluation"
    }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
    },
    "ent_serial": {
      "type": "string",
      "pattern": "^ent:[0-9a-hjkmnp-tv-z]{26}$"
    },
    "mat_serial": {
      "type": "string",
      "pattern": "^mat:[0-9a-hjkmnp-tv-z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "iso_ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      },
      "minItems": 1
    },
    "claim_origin": {
      "enum": [
        "producer_declared",
        "independently_observed",
        "rule_derived",
        "model_inferred",
        "human_adjudicated"
      ]
    },
    "verification_standing": {
      "enum": [
        "unverified",
        "corroborated",
        "contradicted",
        "superseded"
      ]
    },
    "registry_standing": {
      "enum": [
        "candidate",
        "admitted",
        "held",
        "rejected",
        "retired",
        "inadmissible"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "entity_serial",
        "entity_class",
        "plane",
        "entity_grain",
        "identity_scope",
        "minted_at",
        "minting_authority",
        "identity_policy",
        "current_status"
      ],
      "properties": {
        "record_type": {
          "const": "entity"
        },
        "entity_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "entity_class": {
          "$ref": "#/$defs/nonempty"
        },
        "plane": {
          "$ref": "#/$defs/nonempty"
        },
        "entity_grain": {
          "$ref": "#/$defs/nonempty"
        },
        "identity_scope": {
          "enum": [
            "logical",
            "fabric_instance",
            "device_instance",
            "run_occurrence"
          ]
        },
        "minted_at": {
          "$ref": "#/$defs/iso_ts"
        },
        "minting_authority": {
          "$ref": "#/$defs/nonempty"
        },
        "identity_policy": {
          "$ref": "#/$defs/nonempty"
        },
        "current_status": {
          "enum": [
            "provisional",
            "active",
            "retired",
            "contested"
          ]
        },
        "canonicalized_as": {
          "$ref": "#/$defs/ent_serial"
        },
        "adjudicated_by": {
          "$ref": "#/$defs/nonempty"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "current_status": {
                "const": "contested"
              }
            },
            "required": [
              "current_status"
            ]
          },
          "then": {
            "required": [
              "adjudicated_by"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "current_status": {
                "enum": [
                  "provisional",
                  "active",
                  "retired"
                ]
              }
            },
            "required": [
              "current_status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "adjudicated_by"
              ]
            }
          }
        }
      ]
    },
    "entity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding_id",
        "entity_serial",
        "identity_space",
        "native_key",
        "valid_from",
        "valid_to",
        "binding_basis",
        "status",
        "referent_scope"
      ],
      "properties": {
        "record_type": {
          "const": "entity_binding"
        },
        "binding_id": {
          "type": "string",
          "pattern": "^bind:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "entity_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "identity_space": {
          "$ref": "#/$defs/nonempty"
        },
        "native_key": {
          "$ref": "#/$defs/nonempty"
        },
        "valid_from": {
          "$ref": "#/$defs/nonempty"
        },
        "valid_to": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_basis": {
          "$ref": "#/$defs/claim_origin"
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "disputed"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "referent_scope": {
          "$ref": "#/$defs/referent_scope"
        },
        "referent_fabric_id": {
          "$ref": "#/$defs/nonempty"
        },
        "referent_device_id": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "closed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "valid_to": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_basis": {
                "const": "independently_observed"
              }
            },
            "required": [
              "binding_basis"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "binding_basis": {
                "enum": [
                  "rule_derived",
                  "model_inferred"
                ]
              }
            },
            "required": [
              "binding_basis"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referent_scope": {
                "const": "fabric_invariant"
              }
            },
            "required": [
              "referent_scope"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "referent_fabric_id"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "referent_device_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referent_scope": {
                "const": "fabric_local"
              }
            },
            "required": [
              "referent_scope"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "referent_fabric_id"
                ]
              },
              {
                "not": {
                  "required": [
                    "referent_device_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referent_scope": {
                "const": "device_local"
              }
            },
            "required": [
              "referent_scope"
            ]
          },
          "then": {
            "required": [
              "referent_fabric_id",
              "referent_device_id"
            ]
          }
        }
      ]
    },
    "state_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "observation_id",
        "entity_serial",
        "identity_space",
        "source_vintage",
        "observed_at",
        "failure_state",
        "observed_on_fabric",
        "referent_scope"
      ],
      "properties": {
        "record_type": {
          "const": "state_observation"
        },
        "observation_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^obs:[0-9a-hjkmnp-tv-z]{26}$"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "entity_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "identity_space": {
          "$ref": "#/$defs/nonempty"
        },
        "source_native_key": {
          "$ref": "#/$defs/nonempty"
        },
        "source_vintage": {
          "$ref": "#/$defs/nonempty"
        },
        "observed_at": {
          "$ref": "#/$defs/iso_ts"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint_method": {
          "$ref": "#/$defs/nonempty"
        },
        "normalization_version": {
          "$ref": "#/$defs/nonempty"
        },
        "producer_serial": {
          "$ref": "#/$defs/nonempty"
        },
        "failure_state": {
          "enum": [
            "observed",
            "observed_absent",
            "partial",
            "substrate_unavailable",
            "instrument_error",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "observed_on_fabric": {
          "$ref": "#/$defs/nonempty"
        },
        "observed_on_device": {
          "$ref": "#/$defs/nonempty"
        },
        "referent_scope": {
          "$ref": "#/$defs/referent_scope"
        },
        "referent_fabric_id": {
          "$ref": "#/$defs/nonempty"
        },
        "referent_device_id": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "dependentRequired": {
        "fingerprint": [
          "fingerprint_method",
          "normalization_version"
        ],
        "fingerprint_method": [
          "fingerprint"
        ],
        "normalization_version": [
          "fingerprint"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "failure_state": {
                "const": "observed"
              }
            },
            "required": [
              "failure_state"
            ]
          },
          "then": {
            "required": [
              "fingerprint",
              "fingerprint_method",
              "normalization_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "failure_state": {
                "enum": [
                  "substrate_unavailable",
                  "instrument_error",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "failure_state"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "fingerprint"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "fingerprint_method"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "normalization_version"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referent_scope": {
                "const": "fabric_invariant"
              }
            },
            "required": [
              "referent_scope"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "referent_fabric_id"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "referent_device_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referent_scope": {
                "const": "fabric_local"
              }
            },
            "required": [
              "referent_scope"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "referent_fabric_id"
                ]
              },
              {
                "not": {
                  "required": [
                    "referent_device_id"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "referent_scope": {
                "const": "device_local"
              }
            },
            "required": [
              "referent_scope"
            ]
          },
          "then": {
            "required": [
              "referent_fabric_id",
              "referent_device_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "failure_state": {
                "const": "observed_absent"
              }
            },
            "required": [
              "failure_state"
            ]
          },
          "then": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "fingerprint"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "fingerprint_method"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "normalization_version"
                  ]
                }
              },
              {
                "required": [
                  "evidence_refs"
                ]
              }
            ]
          }
        }
      ]
    },
    "identity_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "relation_id",
        "relation_type",
        "subject_serial",
        "object_serial",
        "claim_origin",
        "verification_standing",
        "asserted_at",
        "asserted_by"
      ],
      "properties": {
        "record_type": {
          "const": "identity_relation"
        },
        "relation_id": {
          "type": "string",
          "pattern": "^rel:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "relation_type": {
          "enum": [
            "candidate_equivalence",
            "canonicalized_as",
            "merged_into",
            "split_from",
            "successor_of",
            "replaces",
            "instance_of"
          ]
        },
        "subject_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "object_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "claim_origin": {
          "$ref": "#/$defs/claim_origin"
        },
        "verification_standing": {
          "$ref": "#/$defs/verification_standing"
        },
        "asserted_at": {
          "$ref": "#/$defs/iso_ts"
        },
        "asserted_by": {
          "$ref": "#/$defs/nonempty"
        },
        "adjudicated_by": {
          "$ref": "#/$defs/nonempty"
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^rel:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_standing": {
                "enum": [
                  "corroborated",
                  "contradicted"
                ]
              }
            },
            "required": [
              "verification_standing"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification_standing": {
                "const": "contradicted"
              }
            },
            "required": [
              "verification_standing"
            ]
          },
          "then": {
            "required": [
              "adjudicated_by"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification_standing": {
                "const": "superseded"
              }
            },
            "required": [
              "verification_standing"
            ]
          },
          "then": {
            "required": [
              "superseded_by"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_origin": {
                "const": "independently_observed"
              }
            },
            "required": [
              "claim_origin"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim_origin": {
                "enum": [
                  "rule_derived",
                  "model_inferred"
                ]
              }
            },
            "required": [
              "claim_origin"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification_standing": {
                "enum": [
                  "unverified",
                  "corroborated",
                  "superseded"
                ]
              }
            },
            "required": [
              "verification_standing"
            ]
          },
          "then": {
            "not": {
              "required": [
                "adjudicated_by"
              ]
            }
          }
        }
      ]
    },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "materializer_serial",
        "semantic_layer",
        "canonical_role",
        "owner",
        "current_status"
      ],
      "properties": {
        "record_type": {
          "const": "materializer"
        },
        "materializer_serial": {
          "$ref": "#/$defs/mat_serial"
        },
        "semantic_layer": {
          "$ref": "#/$defs/nonempty"
        },
        "canonical_role": {
          "$ref": "#/$defs/nonempty"
        },
        "owner": {
          "$ref": "#/$defs/nonempty"
        },
        "current_status": {
          "enum": [
            "active",
            "superseded",
            "retired",
            "unknown"
          ]
        },
        "superseded_by_version": {
          "type": "string",
          "pattern": "^matv:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "current_status": {
                "const": "superseded"
              }
            },
            "required": [
              "current_status"
            ]
          },
          "then": {
            "required": [
              "superseded_by_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "current_status": {
                "enum": [
                  "active",
                  "unknown"
                ]
              }
            },
            "required": [
              "current_status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "superseded_by_version"
              ]
            }
          }
        }
      ]
    },
    "materializer_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "version_id",
        "materializer_serial",
        "bundle_completeness",
        "bundle_digest",
        "valid_from"
      ],
      "properties": {
        "record_type": {
          "const": "materializer_version"
        },
        "version_id": {
          "type": "string",
          "pattern": "^matv:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "materializer_serial": {
          "$ref": "#/$defs/mat_serial"
        },
        "source_tree_digest": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_lock_digest": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_digest": {
          "$ref": "#/$defs/sha256"
        },
        "declared_opinions_digest": {
          "$ref": "#/$defs/sha256"
        },
        "normalizer_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "runtime_contract_version": {
          "$ref": "#/$defs/nonempty"
        },
        "bundle_completeness": {
          "enum": [
            "complete",
            "partial_legacy"
          ]
        },
        "absent_components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 1
        },
        "bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "valid_from": {
          "$ref": "#/$defs/iso_ts"
        },
        "supersedes": {
          "type": "string",
          "pattern": "^matv:[0-9a-hjkmnp-tv-z]{26}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bundle_completeness": {
                "const": "complete"
              }
            },
            "required": [
              "bundle_completeness"
            ]
          },
          "then": {
            "required": [
              "source_tree_digest",
              "dependency_lock_digest",
              "configuration_digest",
              "declared_opinions_digest",
              "normalizer_versions",
              "runtime_contract_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "bundle_completeness": {
                "const": "partial_legacy"
              }
            },
            "required": [
              "bundle_completeness"
            ]
          },
          "then": {
            "required": [
              "absent_components"
            ]
          }
        }
      ]
    },
    "materialization_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "run_id",
        "materializer_serial",
        "materializer_version_id",
        "source_frontier_id",
        "started_at",
        "run_status",
        "random_seeds",
        "output_surface_version_ids",
        "executed_on_fabric"
      ],
      "properties": {
        "record_type": {
          "const": "materialization_run"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "materializer_serial": {
          "$ref": "#/$defs/mat_serial"
        },
        "materializer_version_id": {
          "type": "string",
          "pattern": "^matv:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "source_frontier_id": {
          "type": "string",
          "pattern": "^sf:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "started_at": {
          "$ref": "#/$defs/iso_ts"
        },
        "completed_at": {
          "oneOf": [

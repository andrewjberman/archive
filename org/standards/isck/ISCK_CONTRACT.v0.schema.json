              "$ref": "#/$defs/iso_ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters_digest": {
          "$ref": "#/$defs/sha256"
        },
        "random_seeds": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 1
            },
            {
              "const": "not_applicable"
            }
          ]
        },
        "run_status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "partial"
          ]
        },
        "output_surface_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sv:[0-9a-hjkmnp-tv-z]{26}$"
          }
        },
        "run_receipt_digest": {

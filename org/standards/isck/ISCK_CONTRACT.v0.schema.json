        },
        "source_frontier_id": {
          "type": "string",
          "pattern": "^sf:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_serial",
              "identity_space",
              "authority_ref",
              "source_version",
              "observed_at",
              "observed_on_fabric"
            ],
            "properties": {
              "source_serial": {
                "$ref": "#/$defs/ent_serial"
              },
              "identity_space": {
                "$ref": "#/$defs/nonempty"
              },
              "authority_ref": {
                "$ref": "#/$defs/nonempty"
              },
              "source_version": {
                "$ref": "#/$defs/nonempty"
              },
              "observed_at": {
                "$ref": "#/$defs/iso_ts"
              },
              "observed_on_fabric": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        }
      }
    },
    "surface_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "surface_version_id",
        "logical_surface_serial",
        "producing_run_id",
        "content_digest",
        "fingerprint_method",
        "normalization_version",
        "source_frontier_id",
        "built_at",
        "built_on_fabric"
      ],
      "properties": {
        "record_type": {
          "const": "surface_version"
        },
        "surface_version_id": {
          "type": "string",
          "pattern": "^sv:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "logical_surface_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "physical_instance_serial": {
          "$ref": "#/$defs/ent_serial"
        },
        "producing_run_id": {
          "type": "string",
          "pattern": "^run:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint_method": {
          "$ref": "#/$defs/nonempty"
        },
        "normalization_version": {
          "$ref": "#/$defs/nonempty"
        },
        "source_frontier_id": {
          "type": "string",
          "pattern": "^sf:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "published_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "built_at": {
          "$ref": "#/$defs/iso_ts"
        },
        "built_on_fabric": {
          "$ref": "#/$defs/nonempty"
        },
        "built_on_device": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "coherence_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "evaluation_id",
        "subject_ref",
        "target_policy",
        "target_ref",
        "evaluated_at",
        "evaluator",
        "evaluated_on_fabric",
        "availability",
        "integrity",
        "currency",
        "provenance",
        "fabric_validity"
      ],
      "properties": {
        "record_type": {
          "const": "coherence_evaluation"
        },
        "evaluation_id": {
          "type": "string",
          "pattern": "^ce:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "subject_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "target_policy": {
          "enum": [
            "latest_authority",
            "declared_release",
            "as_of_frontier",
            "historical_replay"
          ]
        },
        "target_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "target_source_frontier": {
          "type": "string",
          "pattern": "^sf:[0-9a-hjkmnp-tv-z]{26}$"
        },
        "evaluated_at": {
          "$ref": "#/$defs/iso_ts"
        },
        "evaluator": {
          "$ref": "#/$defs/nonempty"
        },
        "availability": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "integrity": {
          "enum": [
            "verified",
            "mismatch",
            "unverified"
          ]
        },
        "currency": {
          "enum": [
            "at_target",
            "behind_target",
            "ahead_of_target",
            "unknown"
          ]
        },
        "provenance": {
          "enum": [
            "complete",
            "incomplete",
            "unresolved"
          ]
        },
        "fabric_validity": {
          "enum": [
            "valid_for_fabric",
            "foreign_fabric",
            "unknown"
          ]
        },
        "delta_summary": {
          "$ref": "#/$defs/nonempty"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "evaluated_on_fabric": {
          "$ref": "#/$defs/nonempty"
        },
        "evaluated_on_device": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "integrity": {
                "enum": [
                  "verified",
                  "mismatch"
                ]
              }
            },
            "required": [
              "integrity"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "integrity": {
                "const": "mismatch"
              }
            },
            "required": [
              "integrity"
            ]
          },
          "then": {
            "required": [
              "delta_summary"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "currency": {
                "enum": [
                  "at_target",
                  "behind_target",
                  "ahead_of_target"
                ]
              }
            },
            "required": [
              "currency"
            ]
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }

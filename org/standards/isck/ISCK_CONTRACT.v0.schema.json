        "executed_on_fabric": {
          "$ref": "#/$defs/nonempty"
        },
        "executed_on_device": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "run_status": {
                "const": "running"
              }
            },
            "required": [
              "run_status"
            ]
          },
          "then": {
            "properties": {
              "completed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "partial"
                ]
              }
            },
            "required": [
              "run_status"
            ]
          },
          "then": {
            "required": [
              "completed_at"
            ],
            "properties": {
              "completed_at": {
                "$ref": "#/$defs/iso_ts"
              }
            }
          }
        }
      ]
    },
    "source_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "source_frontier_id",
        "entries"

python - <<'PY'
import json, subprocess
HOOK = ".tools/hooks/never-rules-gate.sh"
# arms: (label, command, expected)  expected: DENY | PASS
arms = [
 ("P1 rebase on CLOUD",        "git rebase origin/CLOUD",                              "DENY"),
 ("P2 pull --rebase",          "git pull --rebase origin CLOUD",                        "DENY"),
 ("P3 bare terraform apply",   "terraform apply -auto-approve",                         "DENY"),
 ("P4 git stash push",         "git stash push -m wip",                                 "DENY"),
 ("P5 git clean -fd",          "git clean -fd",                                         "DENY"),
 ("N1 commit MENTIONING rebase","git commit -m \"doctrine: we NEVER rebase a shared branch\"", "PASS"),
 ("N2 stash list (read)",      "git stash list",                                        "PASS"),
 ("N3 clean -n (dry run)",     "git clean -n",                                          "PASS"),
 ("N4 safe-apply (sanctioned)","bash .tools/safe-apply.sh",                             "PASS"),
 ("N5 ordinary commit",        "git status",                                            "PASS"),
 ("O1 audited override",       "git rebase origin/CLOUD # never-override: RV-0048 gate exercise", "PASS"),
]
rows=[]; fails=0; denies=0
for label, cmd, exp in arms:
    payload = json.dumps({"tool_name":"Bash","tool_input":{"command":cmd}})  # REAL json encoder
    p = subprocess.run(["bash",HOOK], input=payload, capture_output=True, text=True)
    out = p.stdout.strip()
    got = "PASS"
    if out:
        try:
            d = json.loads(out)
            if d.get("hookSpecificOutput",{}).get("permissionDecision")=="deny": got="DENY"
        except json.JSONDecodeError:
            got = "MALFORMED-OUT"      # would otherwise silently score PASS
    if got=="DENY": denies+=1
    ok = (got==exp)
    if not ok: fails+=1
    rows.append((("ok " if ok else "FAIL"), label, exp, got))
w=max(len(r[1]) for r in rows)
for st,label,exp,got in rows:
    print(f"  [{st}] {label:<{w}}  expect={exp:<4} got={got}")
print()
print(f"  arms={len(arms)}  mismatches={fails}  denies_observed={denies}")
print("  INSTRUMENT-VALIDITY: a gate never observed to DENY has not been shown able to." )
print(f"  -> denies_observed={denies} (must be >0 or this harness measured NOTHING)")
PY
run_arm () {  # label | cmd | expect
  local label="$1" cmd="$2" exp="$3"
  # build JSON with python's real encoder (NOT sed -- a malformed payload scores PASS silently)
  python -c "import json,sys;print(json.dumps({'tool_name':'Bash','tool_input':{'command':sys.argv[1]}}))" "$cmd" > /tmp/arm.json
  local out rc got
  out=$(timeout 20 bash .tools/hooks/never-rules-gate.sh < /tmp/arm.json 2>/dev/null); rc=$?
  if [ $rc -eq 124 ]; then got="TIMEOUT"
  elif [ -z "$out" ]; then got="PASS"
  elif printf '%s' "$out" | grep -q '"permissionDecision":"deny"'; then got="DENY"
  else got="OTHER"; fi
  if [ "$got" = "$exp" ]; then printf '  [ ok ] %-32s expect=%-4s got=%s\n' "$label" "$exp" "$got"
  else printf '  [FAIL] %-32s expect=%-4s got=%s\n' "$label" "$exp" "$got"; fi
  echo "$got" >> /tmp/gotlist
}
rm -f /tmp/gotlist
run_arm "P1 rebase on CLOUD"        'git rebase origin/CLOUD'                                   DENY
run_arm "P2 pull --rebase"          'git pull --rebase origin CLOUD'                            DENY
run_arm "P3 bare terraform apply"   'terraform apply -auto-approve'                             DENY
run_arm "P4 git stash push"         'git stash push -m wip'                                     DENY
run_arm "P5 git clean -fd"          'git clean -fd'                                             DENY
run_arm "N1 commit MENTIONING rbse" 'git commit -m "doctrine: we NEVER rebase a shared branch"' PASS
run_arm "N2 stash list (read)"      'git stash list'                                            PASS
run_arm "N3 clean -n (dry-run)"     'git clean -n'                                              PASS
run_arm "N4 git status"             'git status'                                                PASS
run_arm "O1 audited override"       'git rebase origin/CLOUD # never-override: RV-0048 exercise' PASS
echo
echo "  arms=$(wc -l < /tmp/gotlist)  denies_observed=$(grep -c DENY /tmp/gotlist)  timeouts=$(grep -c TIMEOUT /tmp/gotlist)"
echo "  INSTRUMENT VALIDITY: denies_observed must be >0, else the harness measured nothing."
terraform apply -auto-approve
git stash push -m wip

+def _forcing_spec(event) -> str:
+    """The ONLY way a `--fixture-remove` spec reaches the renderer
+    (ETFS_GUARDRAIL.TO-EG-s-24). Returns the validated spec, or "" for OFF.
+
+    "" IS THE DEFAULT AND "" APPENDS NOTHING, so any event that does not ask for
+    forcing explicitly produces the byte-identical command this function's caller
+    built before this change.
+
+    THREE GATES, ALL OF WHICH MUST PASS, AND THE SCHEDULED PAYLOAD PASSES NONE:
+      1. the invocation carries TEST_MARKER (so forcing can never ride a run whose
+         recipients include aj@ -- see the block above FORCING_KEY);
+      2. it carries FORCING_KEY as a TOP-LEVEL, non-empty str (a nested value, a
+         list, a dict, a number, None or a differently-cased key is NOT the key);
+      3. the value matches FORCING_SPEC_RE exactly -- `<partner>:<YYYY-MM-DD>[,...]`.
+
+    A value that fails 2 or 3 is REFUSED LOUDLY and resolves to OFF: a malformed
+    forcing spec must never silently become a normal publishing run that the reader
+    then mistakes for a forced one."""
+    ev = event or {}
+    if not _is_test_invocation(ev):
+        return ""
+    raw = ev.get(FORCING_KEY)
+    if raw is None:
+        return ""
+    if not isinstance(raw, str) or not raw.strip():
+        print("SKIP: %s ignored -- not a non-empty string (got %s); forcing is OFF"
+              % (FORCING_KEY, type(raw).__name__))
+        return ""
+    spec = raw.strip()
+    if not FORCING_SPEC_RE.match(spec):
+        print("SKIP: %s REFUSED -- %r does not match <partner>:<YYYY-MM-DD>[,...]; "
+              "forcing is OFF" % (FORCING_KEY, spec[:120]))
+        return ""
+    print("OK: forcing spec accepted -- --fixture-remove %s (TEST invocation)" % spec)
+    return spec
+

diff --git a/data/cot/scripts/gold/test_s00_missing_tier2.py b/data/cot/scripts/gold/test_s00_missing_tier2.py
new file mode 100644
index 0000000000..2658695262
--- /dev/null
+++ b/data/cot/scripts/gold/test_s00_missing_tier2.py
@@ -0,0 +1,93 @@
+"""MDPF_DEMQUE DQ-t-8: build_canonical_prices_v2 tolerates absent Tier-2 objects (S3 stubbed, no AWS)."""
+from __future__ import annotations
+
+import io
+import json
+import os
+import sys
+
+import pandas as pd
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+os.environ.setdefault("AWS_DEFAULT_REGION", "us-east-1")
+import build_canonical_prices_v2 as m  # noqa: E402
+
+
+class _ClientError(Exception):
+    def __init__(self, code, status):
+        self.response = {"Error": {"Code": code}, "ResponseMetadata": {"HTTPStatusCode": status}}
+
+
+class _Body:
+    def __init__(self, b):
+        self._b = b
+
+    def read(self):
+        return self._b
+
+
+class _S3:
+    def __init__(self, objects):
+        self.objects = objects
+
+    def get_object(self, Bucket, Key):
+        if Key not in self.objects:
+            raise _ClientError("NoSuchKey", 404)
+        return {"Body": _Body(self.objects[Key])}
+
+
+def _parquet():
+    buf = io.BytesIO()
+    pd.DataFrame({"ticker": ["AAA"], "date": ["2026-01-02"], "close": [10.5]}).to_parquet(buf)
+    return buf.getvalue()
+
+
+HIST_KEY = "silver/historical_prices.parquet"
+LOOK_KEY = "config/ticker_lookup.json"
+LOOKUP = json.dumps([{"asset_name": "Alpha", "ticker": "AAA"}]).encode()
+
+
+def test_missing_historical_prices_skips_tier2_and_writes(monkeypatch, capsys):
+    monkeypatch.setattr(m, "s3", _S3({LOOK_KEY: LOOKUP}))
+    df, mp = m._load_tier2()
+    assert list(df.columns) == ["ticker", "date", "close"] and len(df) == 0
+    assert "WARN:" in capsys.readouterr().out
+    assert mp["Alpha"] == "AAA"
+    # the empty frame still merges onto a spine without error, leaving t2 empty
+    spine = pd.DataFrame({"ticker": ["AAA"], "date": pd.to_datetime(["2026-01-02"])})
+    out = spine.merge(df.rename(columns={"close": "t2_price"}), on=["ticker", "date"], how="left")
+    assert len(out) == 1 and out["t2_price"].isna().all()
+
+    # any other S3 error still raises
+    class Boom(_S3):
+        def get_object(self, Bucket, Key):
+            raise _ClientError("AccessDenied", 403)
+    monkeypatch.setattr(m, "s3", Boom({}))
+    with pytest.raises(_ClientError):
+        m._load_tier2()
+
+
+def test_missing_ticker_lookup_skips_tier2_and_writes(monkeypatch, capsys):
+    monkeypatch.setattr(m, "s3", _S3({HIST_KEY: _parquet()}))
+    df, mp = m._load_tier2()
+    assert "WARN:" in capsys.readouterr().out
+    assert len(df) == 1
+    assert isinstance(mp, dict) and "Alpha" not in mp
+    for k, v in m.YF_OVERRIDES.items():
+        if m.TICKER_CORRECTIONS.get(k, v) is not None:
+            assert k in mp
+            break
+
+
+def test_present_tier2_is_still_joined(monkeypatch, capsys):
+    monkeypatch.setattr(m, "s3", _S3({HIST_KEY: _parquet(),
+                                      LOOK_KEY: LOOKUP}))
+    df, mp = m._load_tier2()
+    assert "WARN:" not in capsys.readouterr().out
+    assert len(df) == 1 and df["close"].iloc[0] == 10.5
+    assert mp["Alpha"] == "AAA"
+    spine = pd.DataFrame({"asset_name": ["Alpha"], "date": pd.to_datetime(["2026-01-02"])})
+    spine["ticker"] = spine["asset_name"].map(mp)
+    out = spine.merge(df.rename(columns={"close": "t2_price"}), on=["ticker", "date"], how="left")
+    assert out["t2_price"].iloc[0] == 10.5

+def _is_missing_key(e: Exception) -> bool:
+    """True only for an S3 NoSuchKey / 404; any other error must still raise."""
+    err = getattr(e, 'response', None) or {}
+    code = str(err.get('Error', {}).get('Code', ''))
+    status = err.get('ResponseMetadata', {}).get('HTTPStatusCode')
+    return code in ('NoSuchKey', '404') or status == 404
+
+
+def _load_tier2():

+                              'date': pd.Series(dtype='datetime64[ns]'),
+                              'close': pd.Series(dtype='float64')})
+    try:
+        name_to_ticker = load_ticker_lookup()
+    except Exception as e:
+        if not _is_missing_key(e):
+            raise
+        print("WARN: ticker lookup object absent -- starting from an empty mapping")
+        name_to_ticker = dict(YF_OVERRIDES)
+        for asset_name, corrected_ticker in TICKER_CORRECTIONS.items():
+            if asset_name in name_to_ticker:
+                if corrected_ticker is None:
+                    del name_to_ticker[asset_name]
+                else:
+                    name_to_ticker[asset_name] = corrected_ticker
+    return yahoo, name_to_ticker

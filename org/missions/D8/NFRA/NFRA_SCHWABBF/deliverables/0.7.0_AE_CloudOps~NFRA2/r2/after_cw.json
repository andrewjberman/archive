{
  "Statement": [
    {
      "Action": "s3:*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::313476888478:role/*-cot-*",
            "arn:aws:iam::313476888478:user/Andrew_Berman",
            "arn:aws:iam::313476888478:user/Andrew_Berman_Console",
            "arn:aws:iam::313476888478:user/Opal_Terminal",
            "arn:aws:iam::313476888478:role/irpt-holdings-role",
            "arn:aws:iam::313476888478:user/cloudops-dell2-agent-user",
            "arn:aws:iam::313476888478:user/cloudops-dell1-agent-user",
            "arn:aws:iam::313476888478:role/opal-ticket-api-role",
            "arn:aws:iam::313476888478:role/opal-assets-silver-schwab-role",
            "arn:aws:iam::313476888478:role/schwab-alongside-si2-box-role"
          ]
        }
      },
      "Effect": "Deny",
      "Principal": "*",
      "Resource": [
        "arn:aws:s3:::opal-data-cottonwood",
        "arn:aws:s3:::opal-data-cottonwood/*"
      ],
      "Sid": "DenyForeignFirmPrincipals"
    },
    {
      "Action": [
        "s3:GetObject*",
        "s3:GetObjectVersion*",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::313476888478:user/Andrew_Berman_Console",
            "arn:aws:iam::313476888478:role/cloudops-cot-restricted-breakglass-role"
          ]
        }
      },
      "Effect": "Deny",
      "Principal": "*",
      "Resource": "arn:aws:s3:::opal-data-cottonwood/commonwealth/cottonwood/bronze/crm/*",
      "Sid": "DenyRestrictedReadExceptReaders"
    },
    {
      "Action": "s3:ListBucket*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::313476888478:user/Andrew_Berman_Console",
            "arn:aws:iam::313476888478:role/cloudops-cot-restricted-breakglass-role"
          ]
        },
        "StringLike": {
          "s3:prefix": [
            "commonwealth/cottonwood/bronze/crm/",
            "commonwealth/cottonwood/bronze/crm/*"
          ]
        }
      },
      "Effect": "Deny",
      "Principal": "*",
      "Resource": "arn:aws:s3:::opal-data-cottonwood",
      "Sid": "DenyRestrictedListExceptReaders"
    },
    {
      "Action": [
        "s3:PutObject*",
        "s3:DeleteObject*",
        "s3:RestoreObject"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/cloudops-cot-restricted-breakglass-role"
        }
      },
      "Effect": "Deny",
      "Principal": "*",
      "Resource": "arn:aws:s3:::opal-data-cottonwood/commonwealth/cottonwood/bronze/crm/*",
      "Sid": "DenyRestrictedWriteExceptBreakglass"
    },
    {
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/opal-ticket-api-role"
        }
      },
      "Effect": "Deny",
      "NotAction": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Principal": "*",
      "Resource": [
        "arn:aws:s3:::opal-data-cottonwood",
        "arn:aws:s3:::opal-data-cottonwood/*"
      ],
      "Sid": "DenyScopedExemption1AnyOtherAction"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/opal-ticket-api-role"
        }
      },
      "Effect": "Deny",
      "NotResource": "arn:aws:s3:::opal-data-cottonwood/portal/cottonwood/state/ticket_attachments/trade-form/*",
      "Principal": "*",
      "Sid": "DenyScopedExemption1ObjectsOutsidePrefix"
    },
    {
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/opal-assets-silver-schwab-role"
        }
      },
      "Effect": "Deny",
      "NotAction": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Principal": "*",
      "Resource": [
        "arn:aws:s3:::opal-data-cottonwood",
        "arn:aws:s3:::opal-data-cottonwood/*"
      ],
      "Sid": "DenyScopedExemption2AnyOtherAction"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/opal-assets-silver-schwab-role"
        }
      },
      "Effect": "Deny",
      "NotResource": [
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/complete/*",
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/conversions/*",
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/backfill_status/*"
      ],
      "Principal": "*",
      "Sid": "DenyScopedExemption2ObjectsOutsidePrefix"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/opal-assets-silver-schwab-role"
        },
        "StringNotLike": {
          "s3:prefix": [
            "schwab/cottonwood/state/complete/*",
            "schwab/cottonwood/state/conversions/*",
            "schwab/cottonwood/state/backfill_status/*"
          ]
        }
      },
      "Effect": "Deny",
      "Principal": "*",
      "Resource": "arn:aws:s3:::opal-data-cottonwood",
      "Sid": "DenyScopedExemption2ListingOutsidePrefix"
    },
    {
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/schwab-alongside-si2-box-role"
        }
      },
      "Effect": "Deny",
      "NotAction": "s3:PutObject",
      "Principal": "*",
      "Resource": [
        "arn:aws:s3:::opal-data-cottonwood",
        "arn:aws:s3:::opal-data-cottonwood/*"
      ],
      "Sid": "DenyScopedExemption3AnyOtherAction"
    },
    {
      "Action": "s3:PutObject",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::313476888478:role/schwab-alongside-si2-box-role"
        }
      },
      "Effect": "Deny",
      "NotResource": [
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/pulls/*",
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/daily_pull/*"
      ],
      "Principal": "*",
      "Sid": "DenyScopedExemption3ObjectsOutsidePrefix"
    },
    {
      "Action": "s3:GetObject",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::313476888478:role/opal-ticket-api-role"
      },
      "Resource": "arn:aws:s3:::opal-data-cottonwood/portal/cottonwood/state/ticket_attachments/trade-form/*",
      "Sid": "AllowScopedExemption1Objects"
    },
    {
      "Action": "s3:GetObject",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::313476888478:role/opal-assets-silver-schwab-role"
      },
      "Resource": [
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/complete/*",
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/conversions/*",
        "arn:aws:s3:::opal-data-cottonwood/schwab/cottonwood/state/backfill_status/*"
      ],
      "Sid": "AllowScopedExemption2Objects"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "schwab/cottonwood/state/complete/*",
            "schwab/cottonwood/state/conversions/*",
            "schwab/cottonwood/state/backfill_status/*"
          ]
        }
      },
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::313476888478:role/opal-assets-silver-schwab-role"
      },
      "Resource": "arn:aws:s3:::opal-data-cottonwood",
      "Sid": "AllowScopedExemption2Listing"
    }
  ],
  "Version": "2012-10-17"
}
{
  "Statement": [
    {
      "Action": [
        "s3:GetObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::opal-data-assets/code/alongside-schwab-si2/*"
      ],
      "Sid": "AlongsideCodeRead"
    },
    {
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:313476888478:secret:schwab/alongside/sdd-credentials-9IP0UA"
      ],
      "Sid": "AlongsideSddCredentialsRead"
    },
    {
      "Action": [
        "secretsmanager:PutSecretValue"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:313476888478:secret:schwab/alongside/ec2-credentials-5lZi8L"
      ],
      "Sid": "AlongsideEc2CredentialsWrite"
    },
    {
      "Action": [
        "s3:ListBucket"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "schwab/cottonwood/bronze/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::opal-data-assets"
      ],
      "Sid": "MonolithSchwabList"
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::opal-data-assets/schwab/cottonwood/bronze/*/date=*/08134043.*",
        "arn:aws:s3:::opal-data-assets/schwab/cottonwood/bronze/*/date=*/08165601.*",
        "arn:aws:s3:::opal-data-assets/schwab/cottonwood/bronze/*/date=*/08480305.*",
        "arn:aws:s3:::opal-data-assets/schwab/cottonwood/bronze/*/date=*/08719286.*"
      ],
      "Sid": "MonolithSchwabWrite"
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::opal-data-assets/schwab/08134043/_ops/*",
        "arn:aws:s3:::opal-data-assets/schwab/08165601/_ops/*",
        "arn:aws:s3:::opal-data-assets/schwab/08480305/_ops/*",
        "arn:aws:s3:::opal-data-assets/schwab/08719286/_ops/*"
      ],
      "Sid": "MonolithSchwabOpsWrite"
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::opal-data-assets/schwab/08134043/meta/pulls/*",
        "arn:aws:s3:::opal-data-assets/schwab/08165601/meta/pulls/*",
        "arn:aws:s3:::opal-data-assets/schwab/08480305/meta/pulls/*",
        "arn:aws:s3:::opal-data-assets/schwab/08719286/meta/pulls/*"
      ],
      "Sid": "MonolithSchwabMetaPullsWrite"
    },
    {
      "Action": [
        "s3:*"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::opal-data-bd",
        "arn:aws:s3:::opal-data-bd/*"
      ],
      "Sid": "DenyBdPlane"
    },
    {
      "Action": [
        "s3:*"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::opal-data-cot",
        "arn:aws:s3:::opal-data-cot/*"
      ],
      "Sid": "DenyCotPlane"
    },
    {
      "Action": [
        "s3:*"
      ],
      "Effect": "Deny",
      "Resource": [
        "arn:aws:s3:::opal-data-inf",
        "arn:aws:s3:::opal-data-inf/*"
      ],
      "Sid": "DenyInfPlane"
    }
  ],
  "Version": "2012-10-17"
}

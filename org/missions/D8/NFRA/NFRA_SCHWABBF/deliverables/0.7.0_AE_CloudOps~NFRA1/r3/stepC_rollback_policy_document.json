{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "schwab/08242234/bronze/*",
                        "schwab/08335338/bronze/*",
                        "schwab/08403355/bronze/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-assets"
            ],
            "Sid": "MonolithSchwabList"
        },
        {
            "Action": [
                "s3:PutObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-assets/schwab/08242234/bronze/*",
                "arn:aws:s3:::opal-data-assets/schwab/08335338/bronze/*",
                "arn:aws:s3:::opal-data-assets/schwab/08403355/bronze/*"
            ],
            "Sid": "MonolithSchwabWrite"
        },
        {
            "Action": [
                "s3:PutObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-assets/schwab/08242234/_ops/*",
                "arn:aws:s3:::opal-data-assets/schwab/08335338/_ops/*",
                "arn:aws:s3:::opal-data-assets/schwab/08403355/_ops/*"
            ],
            "Sid": "MonolithSchwabOpsWrite"
        },
        {
            "Action": [
                "s3:PutObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-assets/schwab/08242234/meta/pulls/*",
                "arn:aws:s3:::opal-data-assets/schwab/08335338/meta/pulls/*",
                "arn:aws:s3:::opal-data-assets/schwab/08403355/meta/pulls/*"
            ],
            "Sid": "MonolithSchwabMetaPullsWrite"
        }
    ]
}

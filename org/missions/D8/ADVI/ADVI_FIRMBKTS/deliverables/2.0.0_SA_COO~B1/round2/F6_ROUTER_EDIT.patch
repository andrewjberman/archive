--- /dev/null
+++ b/infra/aws/lambda-edge/shared-advisor-router/test/canonical-platinum.spec.mjs
@@ -0,0 +1,89 @@
+// ADVI_FIRMBKTS round 2 (FB-e-6) -- the router's canonical platinum key path, DORMANT: it engages only for a bucket named in
+// the explicit canonical list, which is EMPTY in the shipped router. Every arm passes the list (or relies on its empty
+// default) through handleWithMap(); no registry value is edited here and no firm name is typed: the firms below are read
+// from the registry's generated view (FIRM_CONFIG), and a canonical bucket is built from a firm's own key.
+import { handler, handleWithMap, CANONICAL_PLATINUM_CLASSES } from "../index.mjs";
+import { FIRM_CONFIG, FIRM_BUCKET_MAP } from "../../_shared/firm-config.mjs";
+import assert from "node:assert/strict";
+
+const A = "/api/scoped/advisor-intelligence/";
+const BUCKET_PREFIX = "opal-data-";
+const ownBucket = (k) => BUCKET_PREFIX + k;
+// the firms whose registry bucket is NOT their own long-form bucket: the legacy-bucket firms
+const legacyFirms = Object.keys(FIRM_CONFIG).filter((k) => FIRM_BUCKET_MAP[k] !== ownBucket(k));
+const FIRM = legacyFirms[0];                                                    // a legacy firm whose data will cut over
+const ALIAS = legacyFirms.find((k) => k !== FIRM && FIRM_BUCKET_MAP[k] === FIRM_BUCKET_MAP[FIRM]);  // shares its bucket
+const OTHER = legacyFirms.find((k) => FIRM_BUCKET_MAP[k] !== FIRM_BUCKET_MAP[FIRM]);                // another firm
+const CANON = [ownBucket(FIRM)];
+// the advisor-intelligence suffix that reaches a served class, read from the router's own table (never typed here)
+const suffixOf = (from) => from.replace(/^\/(gold\/)?/, "");
+const PASS_THROUGH = CANONICAL_PLATINUM_CLASSES[0];                              // the class whose legacy key is the platinum prefix
+const PLAT = suffixOf(PASS_THROUGH[0]);
+const CANON_ROOT = (scope) => `/advi/${scope}/${PLAT}`;
+const MAP = { ...FIRM_BUCKET_MAP, [FIRM]: ownBucket(FIRM), [ALIAS]: ownBucket(FIRM) };
+const domain = (b) => `${b}.s3.us-east-1.amazonaws.com`;
+
+function ev({ firmId, suffix, qs = "" }) {
+  const headers = {};
+  if (firmId !== undefined) headers["x-firm-id"] = [{ key: "X-Firm-Id", value: firmId }];
+  headers["x-user-tier"] = [{ key: "X-User-Tier", value: "internal" }];
+  return { Records: [{ cf: { request: {
+    method: "GET", uri: A + suffix, querystring: qs, headers,
+    origin: { s3: { domainName: domain(FIRM_BUCKET_MAP[FIRM]), region: "us-east-1",
+      authMethod: "origin-access-identity", customHeaders: {} } },
+  } } }] };
+}
+const quiet = async (fn) => { const l = console.log, w = console.warn; console.log = () => {}; console.warn = () => {};
+  try { return await fn(); } finally { console.log = l; console.warn = w; } };
+
+describe("ADVI_FIRMBKTS FB-e-6 -- canonical platinum key path (dormant)", () => {
+  it("the fixture finds a legacy firm, its alias and another firm in the registry's own view", () => {
+    assert.ok(FIRM && ALIAS && OTHER, JSON.stringify({ FIRM, ALIAS, OTHER }));
+  });
+
+  it("shipped router: a platinum request keeps its legacy key and its legacy bucket", async () => {
+    const r = await quiet(() => handler(ev({ firmId: FIRM, suffix: PLAT + "accounts/z1/s.json" })));
+    assert.equal(r.uri, "/" + PLAT + "accounts/z1/s.json");
+    assert.equal(r.origin.s3.domainName, domain(FIRM_BUCKET_MAP[FIRM]));
+  });
+
+  it("shipped router: even a map that names the firm's own bucket changes nothing while the list is empty", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: FIRM, suffix: "views/firm_composition.json" }), MAP));
+    assert.equal(r.uri, "/gold/views/firm_composition.json");
+    assert.equal(r.origin.s3.domainName, domain(ownBucket(FIRM)));
+  });
+
+  it("a listed bucket: platinum passes to advi/{firm}/platinum/, the alias resolves to the same scope", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: FIRM, suffix: PLAT + "accounts/z1/s.json" }), MAP, CANON));
+    assert.equal(r.uri, CANON_ROOT(FIRM) + "accounts/z1/s.json");
+    assert.equal(r.origin.s3.domainName, domain(ownBucket(FIRM)));
+    const a = await quiet(() => handleWithMap(ev({ firmId: ALIAS, suffix: PLAT + "firm/x.json" }), MAP, CANON));
+    assert.equal(a.uri, CANON_ROOT(FIRM) + "firm/x.json");
+  });
+
+  it("a listed bucket: every class of the table maps to its canonical table, by the table's own rows", async () => {
+    for (const [from, table] of CANONICAL_PLATINUM_CLASSES) {
+      const r = await quiet(() => handleWithMap(ev({ firmId: FIRM, suffix: suffixOf(from) + "t/x.json" }), MAP, CANON));
+      assert.equal(r.uri, CANON_ROOT(FIRM) + table + "t/x.json", from);
+    }
+  });
+
+  it("a listed bucket: a class the table does not place is refused with the router's own 404, never guessed", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: FIRM, suffix: "timeseries/t.json" }), MAP, CANON));
+    assert.equal(r.status, "404");
+    assert.equal(JSON.parse(r.body).error, "unplaced_canonical_resource");
+  });
+
+  it("a listed bucket: another firm on a legacy bucket keeps its legacy key and bucket", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: OTHER, suffix: "views/v.json" }), MAP, CANON));
+    assert.equal(r.uri, "/gold/views/v.json");
+    assert.equal(r.origin.s3.domainName, domain(FIRM_BUCKET_MAP[OTHER]));
+  });
+
+  it("the platinum/advi/{firm}/ twin class is untouched and its tenant assertion still refuses a mismatch", async () => {
+    const ok = await quiet(() => handleWithMap(ev({ firmId: FIRM, suffix: `${PLAT}advi/${FIRM}/m.json` }), MAP, CANON));
+    assert.equal(ok.uri, `/${PLAT}advi/${FIRM}/m.json`);
+    const bad = await quiet(() => handleWithMap(ev({ firmId: FIRM, suffix: `${PLAT}advi/${OTHER}/m.json` }), MAP, CANON));
+    assert.equal(bad.status, "401");
+  });
+});

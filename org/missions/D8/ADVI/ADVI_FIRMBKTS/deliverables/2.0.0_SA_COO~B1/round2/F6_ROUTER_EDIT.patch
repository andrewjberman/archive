@@ -0,0 +1,74 @@
+// a firm's own bucket for it. Every arm drives handleWithMap() with an explicit firm map so the registry's map is never
+// edited here. The firm map is the single switch (FWD-3); nothing in this file changes a bucket value.
+import { handler, handleWithMap } from "../index.mjs";
+import { FIRM_BUCKET_MAP } from "../../_shared/firm-config.mjs";
+import assert from "node:assert/strict";
+
+const A = "/api/scoped/advisor-intelligence/";
+const CUT = { ...FIRM_BUCKET_MAP, "49financial": "opal-data-49financial", mockadv: "opal-data-49financial" };
+
+function ev({ firmId, suffix, qs = "" }) {
+  const headers = {};
+  if (firmId !== undefined) headers["x-firm-id"] = [{ key: "X-Firm-Id", value: firmId }];
+  headers["x-user-tier"] = [{ key: "X-User-Tier", value: "internal" }];
+  return { Records: [{ cf: { request: {
+    method: "GET", uri: A + suffix, querystring: qs, headers,
+    origin: { s3: { domainName: "opal-data-bd.s3.us-east-1.amazonaws.com", region: "us-east-1",
+      authMethod: "origin-access-identity", customHeaders: {} } },
+  } } }] };
+}
+const quiet = async (fn) => { const l = console.log, w = console.warn; console.log = () => {}; console.warn = () => {};
+  try { return await fn(); } finally { console.log = l; console.warn = w; } };
+
+describe("ADVI_FIRMBKTS FB-e-6 -- canonical platinum key path (dormant)", () => {
+  it("registry map: a 49financial platinum request keeps its legacy key and the legacy bucket", async () => {
+    const r = await quiet(() => handler(ev({ firmId: "49financial", suffix: "platinum/accounts/z1/summary.json" })));
+    assert.equal(r.uri, "/platinum/accounts/z1/summary.json");
+    assert.equal(r.origin.s3.domainName, "opal-data-bd.s3.us-east-1.amazonaws.com");
+  });
+
+  it("registry map: the staff proxy ?firm=49financial is unchanged (legacy key, as today)", async () => {
+    const r = await quiet(() => handler(ev({ firmId: "opal-capital", suffix: "views/firm_composition.json", qs: "firm=49financial" })));
+    assert.equal(r.uri, "/gold/views/firm_composition.json");
+  });
+
+  it("firm map names the firm's own bucket: platinum passes to advi/{firm}/platinum/", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "platinum/accounts/z1/summary.json" }), CUT));
+    assert.equal(r.uri, "/advi/49financial/platinum/accounts/z1/summary.json");
+    assert.equal(r.origin.s3.domainName, "opal-data-49financial.s3.us-east-1.amazonaws.com");
+  });
+
+  it("firm map names the firm's own bucket: the alias mockadv resolves to the same scope", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: "mockadv", suffix: "platinum/firm/advisor_nna_canonical.json" }), CUT));
+    assert.equal(r.uri, "/advi/49financial/platinum/firm/advisor_nna_canonical.json");
+  });
+
+  it("gold entities, views and artifacts map to platinum entities, views and artifacts", async () => {
+    const e = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "entities/accounts/z1/aua_timeseries.json" }), CUT));
+    const v = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "views/firm_composition.json" }), CUT));
+    const a = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "artifacts/implementor_leaderboard.json" }), CUT));
+    assert.equal(e.uri, "/advi/49financial/platinum/entities/accounts/z1/aua_timeseries.json");
+    assert.equal(v.uri, "/advi/49financial/platinum/views/firm_composition.json");
+    assert.equal(a.uri, "/advi/49financial/platinum/artifacts/implementor_leaderboard.json");
+  });
+
+  it("a class the table does not place is refused with the router's own 404, never guessed", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "timeseries/synthetic_positions_index.json" }), CUT));
+    assert.equal(r.status, "404");
+    assert.equal(JSON.parse(r.body).error, "unplaced_canonical_resource");
+  });
+
+  it("another firm on a legacy bucket keeps its legacy key even when 49financial is cut over", async () => {
+    const r = await quiet(() => handleWithMap(ev({ firmId: "inflection", suffix: "views/firm_composition.json" }), CUT));
+    assert.equal(r.uri, "/gold/views/firm_composition.json");
+    assert.equal(r.origin.s3.domainName, "opal-data-inf.s3.us-east-1.amazonaws.com");
+  });
+
+  it("the platinum/advi/{firm}/ twin class is untouched and its tenant assertion still refuses a mismatch", async () => {
+    const ok = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "platinum/advi/49financial/mix_summary.json" }), CUT));
+    assert.equal(ok.uri, "/platinum/advi/49financial/mix_summary.json");
+    assert.equal(ok.origin.s3.domainName, "opal-data-portal-v2.s3.us-east-1.amazonaws.com");
+    const bad = await quiet(() => handleWithMap(ev({ firmId: "49financial", suffix: "platinum/advi/inflection/mix_summary.json" }), CUT));
+    assert.equal(bad.status, "401");
+  });
+});

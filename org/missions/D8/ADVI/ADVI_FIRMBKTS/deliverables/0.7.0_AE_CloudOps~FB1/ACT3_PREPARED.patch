diff --git a/infra/aws/terraform/inf-pipeline/inf-portal-publisher-floor.tf b/infra/aws/terraform/inf-pipeline/inf-portal-publisher-floor.tf
index e6b070ab82..cac97ffbac 100644
--- a/infra/aws/terraform/inf-pipeline/inf-portal-publisher-floor.tf
+++ b/infra/aws/terraform/inf-pipeline/inf-portal-publisher-floor.tf
@@ -27,6 +27,15 @@ module "inf_portal_publisher_floor_schedule_name" {
   kind     = "daily"
 }
 
+module "inf_portal_publisher_catchup_schedule_name" {
+  source    = "../modules/opal_name"
+  system    = "advi"
+  scope     = "inflection"
+  function  = "publish"
+  qualifier = "catchup"
+  kind      = "daily"
+}
+
 module "inf_portal_publisher_floor_dlq_name" {
   source   = "../modules/opal_name"
   system   = "advi"
@@ -98,7 +107,7 @@ resource "aws_iam_role_policy" "inf_portal_publisher_floor_scheduler" {
 resource "aws_scheduler_schedule" "inf_portal_publisher_floor" {
   name       = module.inf_portal_publisher_floor_schedule_name.name
   group_name = "default"
-  state      = "DISABLED" # created DISABLED; enabling is FB-l-5 act 3, held on the readiness halt (C4)
+  state      = "ENABLED" # FB-l-5 act 3: enabled with the readiness guard live (FB-m-2); the gold/meta/ notification is removed in the same apply
 
   flexible_time_window {
     mode = "OFF"
@@ -110,6 +119,39 @@ resource "aws_scheduler_schedule" "inf_portal_publisher_floor" {
   target {
     arn      = module.inf_portal_publisher.function_arn
     role_arn = aws_iam_role.inf_portal_publisher_floor_scheduler.arn
+    # {} reproduces the S3-notification path into inf-portal-advisor-publisher (no run_date: it falls back to today);
+    # the Scheduler's own payload has a string detail that breaks its _extract_run_date (row D1-S58).
+    input = jsonencode({})
+
+    retry_policy {
+      maximum_retry_attempts       = 1
+      maximum_event_age_in_seconds = 3600
+    }
+
+    dead_letter_config {
+      arn = aws_sqs_queue.inf_portal_publisher_floor_dlq.arn
+    }
+  }
+}
+
+# The catch-up fire (FB-l-5 act 3, CTO msg 5603): without it a gold day that finishes after 13:30Z publishes nothing.
+# With the readiness guard it is a no-op on a normal day (halts not-after-served) and a publish on a late one.
+resource "aws_scheduler_schedule" "inf_portal_publisher_catchup" {
+  name       = module.inf_portal_publisher_catchup_schedule_name.name
+  group_name = "default"
+  state      = "ENABLED"
+
+  flexible_time_window {
+    mode = "OFF"
+  }
+
+  schedule_expression          = "cron(30 16 * * ? *)"
+  schedule_expression_timezone = "UTC"
+
+  target {
+    arn      = module.inf_portal_publisher.function_arn
+    role_arn = aws_iam_role.inf_portal_publisher_floor_scheduler.arn
+    input    = jsonencode({})
 
     retry_policy {
       maximum_retry_attempts       = 1

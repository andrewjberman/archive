{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Action": [
    "s3:PutObject",
    "s3:GetObject"
   ],
   "Effect": "Allow",
   "Resource": [
    "arn:aws:s3:::opal-data-49financial/advi/49financial/platinum/*"
   ],
   "Sid": "AdviPlatinumCanonicalObjects"
  },
  {
   "Action": [
    "s3:ListBucket"
   ],
   "Condition": {
    "StringLike": {
     "s3:prefix": [
      "advi/49financial/platinum/*"
     ]
    }
   },
   "Effect": "Allow",
   "Resource": [
    "arn:aws:s3:::opal-data-49financial"
   ],
   "Sid": "AdviPlatinumCanonicalList"
  }
 ]
}

{
 "predicate": {
  "full_outflow": "FULL_OUTFLOW_RECENT: let O be the sum, over the account's own value rows dated in the 28 calendar days before today (today excluded), of each day's net external outflow as the form values it (the table's flow column, negative days only: withdrawals lo, in-kind transfers out trfo/trco, cancelled contributions LIX, short contributions si, the charge flows and riding tax withholdings of method_r28, a zero-Amount row valued at the close; a day with a deposit and a withdrawal counts only its net outflow; an unvalued flow counts 0). Let B be the account's value at the close of the previous row (the prior value the return divides by). The account had a full outflow when O / (O + B) is at least 0.99, i.e. O is at least 99 times B. Undefined when B is not positive (no base): then the predicate does not apply.",
  "receipt_types": {
   "income": {
    "types": [
     "dv",
     "dvlt",
     "dvst",
     "int",
     "roy",
     "ileu",
     "dvr",
     "ac",
     "DVX",
     "INTX",
     "DVRX"
    ],
    "source": "commonwealth_flows.py INTERNAL lines 59-70 (income and its cancels, reinvestment dvr :69 and its cancel DVRX :70); all INTERNAL, i.e. kept inside the return"
   },
   "fee_refund": {
    "types": [
     "man with a positive Amount"
    ],
    "source": "commonwealth_flows.py :86 (man INTERNAL) and :121 (man a drag under the method); the positive Amount is the refund/rebate"
   },
   "fee_credit_12b1": {
    "types": [
     "12b1"
    ],
    "source": "commonwealth_flows.py :85 (a fund fee credit booked on the cash sweep; all 1,466 estate rows are positive)",
    "belongs": "yes, as a fee credit of the same shape as the refund; RECOMMENDED in; it changes 2 blanked days of 410 (408 without it)"
   },
   "allowed_beside_a_receipt": {
    "types": [
     "sweep buy by and sweep sell sl of a listed sweep (INTERNAL, the same money, commonwealth_flows.internal_sweep_trade)",
     "lo of the cash balance (CFNCASH or a sweep) i.e. the withdrawal of the receipt",
     "frntax (foreign tax withheld at source out of the same income, :109)"
    ],
    "why": "none of these makes the day a market return: the sweep leg and the cash withdrawal move the same money, and a receipt plus a withdrawal of it is still a receipt on a residual base (the account being swept out)"
   }
  },
  "excludes": {
   "rule": "The day is NOT a receipt day if any row of the account that day (its effective trading day) has a type outside the receipt and allowed lists. In particular:",

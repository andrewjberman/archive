+++ b/infra/aws/terraform/nfra-ctlpln-identity/tests/derive_protected_functions.py
@@ -0,0 +1,263 @@
+"""Census of the Lambda functions that decide access, and the explicit Deny rendered from it (NFRA_CTLPLN CT-c-5, FWD-10).
+
+The CTO's ruling (msg 106008): a Dell may not update the code or configuration of a function that decides access (authorizers, the edge
+auth validator, user and key management); everywhere else the Allow on Resource * stands. The protected list is DERIVED here, by census of
+the live functions, and printed with its denominator; the Deny statement is RENDERED from it, never typed.
+
+  --live (default)      list the functions in every region `ec2 describe-regions` returns, plus the API Gateway authorizers and the
+                        CloudFront Lambda@Edge associations, with the repo's .tools/aws shim. READ-ONLY calls only (list/get/describe).
+  --from-file <json>    take a saved listing (protected_functions_listing.json) instead of calling AWS.
+  --check (default)     compare the saved files with a fresh census; write nothing.
+  --write               write protected_functions.json, protected_functions_listing.json and the rendered statement.
+
+The statement DenyProtectedFunctions goes into dell_deploy_policy.json when the document stays within 6,144 characters without
+whitespace, else into its own policy dell_protect_policy.json (and the other file never carries it).
+"""
+import argparse
+import json
+import os
+import re
+import subprocess
+import sys
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+REPO = ROOT.parents[3]
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import render_passrole as rp  # noqa: E402  (block_text, BLOCK_SEP: the same hand-formatted statement layout)
+
+AWS = str(REPO / ".tools" / ("aws.cmd" if os.name == "nt" else "aws"))
+DEPLOY = ROOT / "dell_deploy_policy.json"
+PROTECT = ROOT / "dell_protect_policy.json"
+PROTECTED = ROOT / "protected_functions.json"
+LISTING = ROOT / "protected_functions_listing.json"
+SID = "DenyProtectedFunctions"
+LIMIT = 6144
+ACCOUNT = "313476888478"
+ACTIONS = ["lambda:UpdateFunctionCode", "lambda:UpdateFunctionConfiguration", "lambda:PublishVersion", "lambda:CreateAlias",
+           "lambda:UpdateAlias", "lambda:DeleteFunction", "lambda:DeleteAlias", "lambda:PutFunctionConcurrency",
+           "lambda:UpdateFunctionUrlConfig", "lambda:CreateFunctionUrlConfig"]
+
+# ---- the rule table (the record) --------------------------------------------------------------------------------------------
+# (a) the target of an API Gateway authorizer; (b) associated with a CloudFront distribution as Lambda@Edge; (c) the NAME matches one of
+# these words on a word boundary, case-insensitive. A boundary is a non-alphanumeric character or the string end, so `opal-auth-fn` and
+# `user_mgmt` match and `author` does not match `auth`.
+NAME_WORDS = ["auth", "authorizer", "authz", "login", "signin", "sso", "cognito", "user", "users", "apikey", "api-key", "credential",
+              "token", "session", "mfa", "password"]
+NAME_RE = re.compile(r"(?<![A-Za-z0-9])(%s)(?![A-Za-z0-9])" % "|".join(re.escape(w) for w in sorted(NAME_WORDS, key=len, reverse=True)),
+                     re.I)
+RULES = {"a": "authorizer", "b": "lambda-at-edge", "c": "name"}
+# -----------------------------------------------------------------------------------------------------------------------------
+
+FN_ARN = re.compile(r"(arn:aws:lambda:[a-z0-9-]+:\d{12}:function:[A-Za-z0-9_-]+)")
+URI_ARN = re.compile(r"functions/(arn:aws:lambda:[^/]+)/invocations")
+
+
+def aws(*args):
+    """One read-only AWS CLI call through the repo shim. Returns (rc, parsed json | None, stderr)."""
+    r = subprocess.run([AWS, *args, "--output", "json"], capture_output=True, text=True, encoding="utf-8",
+                       errors="replace", timeout=100)
+    if r.returncode != 0:
+        return r.returncode, None, r.stderr.strip()[-200:]
+    try:
+        return 0, (json.loads(r.stdout) if r.stdout.strip() else {}), ""
+    except ValueError as e:
+        return 1, None, "unparseable output: %s" % e
+
+
+def base_arn(arn):
+    """Strip a version or alias qualifier: arn:aws:lambda:<region>:<acct>:function:<name>[:<qual>] -> the unqualified function ARN."""
+    m = FN_ARN.match(arn or "")
+    return m.group(1) if m else None
+
+
+def census_region(region):
+    """Everything one region contributes: its functions and the Lambda ARNs its API Gateway authorizers point at."""
+    out = {"region": region, "functions": [], "authorizer_targets": [], "unresolved": [], "refused": []}
+
+    def call(label, *args):
+        rc, data, err = aws(*args, "--region", region)
+        if rc != 0:
+            out["refused"].append("%s: %s" % (label, err.replace("\n", " ")[-120:]))
+        return data
+
+    d = call("lambda list-functions", "lambda", "list-functions")
+    for f in (d or {}).get("Functions", []):
+        out["functions"].append({"region": region, "name": f["FunctionName"], "arn": base_arn(f["FunctionArn"])})
+
+    def targets(items):
+        for a in items:
+            uri = a.get("authorizerUri") or ""
+            m = URI_ARN.search(uri)
+            b = base_arn(m.group(1)) if m else None
+            if b:
+                out["authorizer_targets"].append(b)
+            elif uri:
+                out["unresolved"].append("%s %s" % (region, uri[:120]))
+
+    d = call("apigatewayv2 get-apis", "apigatewayv2", "get-apis")
+    for api in (d or {}).get("Items", []):
+        a = call("apigatewayv2 get-authorizers", "apigatewayv2", "get-authorizers", "--api-id", api["ApiId"])
+        targets((a or {}).get("Items", []))
+    d = call("apigateway get-rest-apis", "apigateway", "get-rest-apis")
+    for api in (d or {}).get("items", []):
+        a = call("apigateway get-authorizers", "apigateway", "get-authorizers", "--rest-api-id", api["id"])
+        targets((a or {}).get("items", []))
+    return out
+
+
+def live_listing():
+    rc, d, err = aws("ec2", "describe-regions", "--region", "us-east-1")
+    if rc != 0:
+        raise SystemExit("ERROR: ec2 describe-regions refused: %s" % err)
+    regions = sorted(r["RegionName"] for r in d["Regions"])
+    with ThreadPoolExecutor(max_workers=8) as ex:
+        per = list(ex.map(census_region, regions))
+    edge, refused_edge = [], None
+    rc, d, err = aws("cloudfront", "list-distributions", "--region", "us-east-1")
+    if rc != 0:
+        refused_edge = err.replace("\n", " ")[-120:]
+    else:
+        for dist in (d.get("DistributionList") or {}).get("Items") or []:
+            behaviours = [dist.get("DefaultCacheBehavior") or {}] + list(((dist.get("CacheBehaviors") or {}).get("Items")) or [])
+            for b in behaviours:
+                for assoc in ((b.get("LambdaFunctionAssociations") or {}).get("Items")) or []:
+                    arn = base_arn(assoc.get("LambdaFunctionARN"))
+                    if arn:
+                        edge.append(arn)
+    listing = {
+        "regions": {p["region"]: len(p["functions"]) for p in per},
+        "refused": sorted(["%s %s" % (p["region"], x) for p in per for x in p["refused"]]
+                          + (["cloudfront list-distributions: %s" % refused_edge] if refused_edge else [])),
+        "refused_regions": sorted({p["region"] for p in per if p["refused"]} | ({"cloudfront"} if refused_edge else set())),
+        "functions": sorted((f for p in per for f in p["functions"]), key=lambda f: (f["region"], f["name"])),
+        "authorizer_targets": sorted({t for p in per for t in p["authorizer_targets"]}),
+        "unresolved_authorizer_uris": sorted(u for p in per for u in p["unresolved"]),
+        "edge_targets": sorted(set(edge)),
+    }
+    return listing
+
+
+def derive(listing):
+    """Apply the rule table. Returns {arn: [rules]} over the protected functions (own-account ARNs only)."""
+    prot = {}
+    by_arn = {f["arn"]: f for f in listing["functions"]}
+    for arn in listing["authorizer_targets"]:
+        if arn.split(":")[4] == ACCOUNT:
+            prot.setdefault(arn, set()).add("a")
+    for arn in listing["edge_targets"]:
+        if arn.split(":")[4] == ACCOUNT:
+            prot.setdefault(arn, set()).add("b")
+    for f in listing["functions"]:
+        if NAME_RE.search(f["name"]):
+            prot.setdefault(f["arn"], set()).add("c")
+    return {a: sorted(prot[a]) for a in sorted(prot)}, by_arn
+
+
+def statement(arns):
+    res = []
+    for a in arns:
+        res += [a, a + ":*"]
+    return {"Sid": SID, "Effect": "Deny", "Action": ACTIONS, "Resource": res}
+
+
+def strip_statement(text):
+    """Return the policy text with DenyProtectedFunctions removed (byte-identical otherwise), and the file's EOL."""
+    eol = "\r\n" if "\r\n" in text else "\n"
+    t = text.replace("\r\n", "\n")
+    head, sep, rest = t.partition('"Statement": [\n')
+    inner, tail_sep, tail = rest.rpartition("\n  ]")
+    open_b, close_b = "    {\n", "\n    }"
+    if not sep or not tail_sep or not inner.startswith(open_b) or not inner.endswith(close_b):
+        raise ValueError("policy text does not have the expected statement array layout")
+    cores = inner[len(open_b):-len(close_b)].split(rp.BLOCK_SEP)
+    blocks = [open_b + c + close_b for c in cores]
+    keep = [b for b in blocks if re.search(r'"Sid":\s*"([^"]+)"', b).group(1) != SID]
+    return head, sep, keep, tail_sep, tail, eol
+
+
+def render_deploy(text, stmt):
+    head, sep, keep, tail_sep, tail, eol = strip_statement(text)
+    if stmt is not None:
+        keep.append(rp.block_text(stmt))
+    return (head + sep + ",\n".join(keep) + tail_sep + tail).replace("\n", eol)
+
+
+def size(text):
+    return len(re.sub(r"\s", "", text))
+
+
+def render_all(arns):
+    """Return (deploy text, protect text or None, where the statement lives)."""
+    cur = DEPLOY.read_bytes().decode("utf-8")
+    stmt = statement(arns)
+    inline = render_deploy(cur, stmt)
+    if size(inline) <= LIMIT:
+        return inline, None, "dell_deploy_policy.json"
+    protect = json.dumps({"Version": "2012-10-17", "Statement": [stmt]}, indent=2) + "\n"
+    return render_deploy(cur, None), protect, "dell_protect_policy.json"
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    src = ap.add_mutually_exclusive_group()
+    src.add_argument("--live", action="store_true", help="census the live account (default)")
+    src.add_argument("--from-file", metavar="JSON", help="a saved listing instead of calling AWS")
+    mode = ap.add_mutually_exclusive_group()
+    mode.add_argument("--check", action="store_true", help="compare, write nothing (default)")
+    mode.add_argument("--write", action="store_true", help="write the saved files and the rendered statement")
+    a = ap.parse_args(argv)
+
+    listing = json.loads(Path(a.from_file).read_text(encoding="utf-8")) if a.from_file else live_listing()
+    n_regions = len(listing["regions"])
+    n_functions = len(listing["functions"])
+    print("REGIONS %d; per-region function counts: %s" % (n_regions, ", ".join("%s=%d" % kv for kv in sorted(listing["regions"].items()))))
+    print("FUNCTIONS listed=%d (sum of the per-region counts=%d)" % (n_functions, sum(listing["regions"].values())))
+    for x in listing["refused"]:
+        print("REFUSED " + x)
+    for x in listing["unresolved_authorizer_uris"]:
+        print("UNRESOLVED-AUTHORIZER-URI " + x)
+    print("authorizer targets=%d edge associations=%d" % (len(listing["authorizer_targets"]), len(listing["edge_targets"])))
+
+    prot, by_arn = derive(listing)
+    for arn, rules in prot.items():
+        listed = "" if arn in by_arn else "  [NOT-LISTED: a reference to a function the census did not list]"
+        print("PROTECTED %s rules=%s%s" % (arn, "+".join("(%s) %s" % (r, RULES[r]) for r in rules), listed))
+    name_only = [arn for arn, rules in prot.items() if rules == ["c"]]
+    for arn in name_only:
+        print("NAME-ONLY %s" % arn)
+
+    arns = sorted(prot)
+    saved = {"protected": arns, "rules": {k: prot[k] for k in arns}}
+    deploy_text, protect_text, where = render_all(arns)
+    print("STATEMENT %s rendered into %s; deploy chars=%d, protect chars=%s" %
+          (SID, where, size(deploy_text), size(protect_text) if protect_text else "n/a"))
+
+    if a.write:
+        PROTECTED.write_text(json.dumps(saved, indent=2) + "\n", encoding="utf-8", newline="\n")
+        LISTING.write_text(json.dumps(listing, indent=1) + "\n", encoding="utf-8", newline="\n")
+        DEPLOY.write_bytes(deploy_text.encode("utf-8"))
+        if protect_text:
+            PROTECT.write_text(protect_text, encoding="utf-8", newline="\n")
+        elif PROTECT.exists():
+            print("NOTE: %s exists but the statement now fits the deploy policy; the file is not edited here" % PROTECT.name)
+        print("WROTE %s, %s, %s" % (PROTECTED.name, LISTING.name, DEPLOY.name if not protect_text else DEPLOY.name + " + " + PROTECT.name))
+
+    try:
+        have = json.loads(PROTECTED.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        have = None
+    in_sync = (have == saved and DEPLOY.read_bytes().decode("utf-8") == deploy_text and
+               ((PROTECT.read_bytes().decode("utf-8") == protect_text) if protect_text else True))
+    by_a = sum(1 for r in prot.values() if "a" in r)
+    by_e = sum(1 for r in prot.values() if "b" in r)
+    refused_regions = len(listing["refused_regions"])
+    ok = len(arns) > 0 and refused_regions == 0 and in_sync
+    print("PROTECTED-CENSUS functions=%d regions=%d refused_regions=%d protected=%d by_authorizer=%d by_edge=%d name_only=%d in_sync=%s ok=%s"
+          % (n_functions, n_regions, refused_regions, len(arns), by_a, by_e, len(name_only), in_sync, ok))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

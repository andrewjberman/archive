+def protected_arms():
+    """Third block (CT-c-5), on the REAL files: six denied arms on three protected functions (one per rule where the census has one),
+    one allowed arm on a function the census did not protect, one allowed CreateFunction on a new name."""
+    saved = json.loads(PROTECTED_JSON.read_text(encoding="utf-8"))
+    listing = json.loads(LISTING_JSON.read_text(encoding="utf-8"))
+    rules = saved["rules"]
+    chosen, none_for = [], []
+    for rule in ("a", "b", "c"):
+        pool = [a for a in saved["protected"] if rule in rules[a] and a not in chosen]
+        only = [a for a in pool if rules[a] == [rule]]  # prefer a function this rule alone caught
+        if pool:
+            chosen.append((only or pool)[0])
+        else:
+            none_for.append(rule)
+    for a in saved["protected"]:
+        if len(chosen) < 3 and a not in chosen:

+    free = next(f["arn"] for f in listing["functions"] if f["arn"] not in rules)
+    arms.append(("lambda:UpdateFunctionCode", free, True))
+    arms.append(("lambda:CreateFunction", "arn:aws:lambda:us-east-1:313476888478:function:ctlpln-new-function", True))
+    return arms
+
+
 def decide(iam, docs, action, resource):

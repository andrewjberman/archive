# Put this block in the Terraform CLI config file (%APPDATA%/terraform.rc on Windows), with path set to the
# absolute path of the mirror directory on THIS box. 'verify --from <dir> --write-config <file>' writes it filled in.
provider_installation {
  filesystem_mirror {
    path    = "<ABSOLUTE-PATH-OF-THE-MIRROR-DIRECTORY>"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}

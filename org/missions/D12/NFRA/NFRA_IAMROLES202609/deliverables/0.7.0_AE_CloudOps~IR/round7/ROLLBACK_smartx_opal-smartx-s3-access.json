{
    "RoleName": "opal-smartx-lambda-role",
    "PolicyName": "opal-smartx-s3-access",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket"
                ],
                "Resource": [
                    "arn:aws:s3:::opal-data-smartx",
                    "arn:aws:s3:::opal-data-smartx/*",
                    "arn:aws:s3:::opal-code-smartx",
                    "arn:aws:s3:::opal-code-smartx/*"
                ]
            }
        ]
    }
}

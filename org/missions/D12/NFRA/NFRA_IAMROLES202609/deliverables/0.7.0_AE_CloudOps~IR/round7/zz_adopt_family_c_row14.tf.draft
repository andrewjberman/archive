# -----------------------------------------------------------------------------
# ROW 14 -- sentiment_query_api-role
# Live at 2026-10-11 (get-role, list-role-policies, list-attached-role-policies,
#   list-role-tags): created 2025-11-24T20:33:48Z, RoleLastUsed
#   2026-01-02T17:29:32Z in us-east-2, path "/", MaxSessionDuration 3600, NO
#   description, no permissions boundary, 0 tags.
#
#   1 inline policy:            DynamoDBAccess
#   1 ATTACHED MANAGED policy:  AWSLambdaBasicExecutionRole
#
# THREE THINGS ABOUT THIS ROLE THAT THE DECLARATION HAS TO RESPECT:
#
#   1. AN UNDERSCORE IN THE NAME. `sentiment_query_api-role` mixes an underscore
#      and hyphens. The NAME is a live string and is reproduced exactly; the
#      Terraform LABEL below is a separate namespace and uses underscores
#      throughout, as every label does. The two are not required to match and
#      must not be "tidied" into each other.
#
#   2. THE OMISSION RULE PROTECTS A MANAGED ATTACHMENT, as for row 6: setting
#      `managed_policy_arns`, even to `[]`, would detach
#      AWSLambdaBasicExecutionRole and with it this role's CloudWatch Logs
#      access.
#
#   3. ITS LAST USE WAS IN us-east-2, while its consumer Lambda, log group and
#      API route all live in us-east-1 (served graph, vintage 2026-10-11
#      04:06:44Z). That is recorded as an OBSERVATION, not acted on: a role is
#      global, so a us-east-2 assumption is not itself a defect, and this cell
#      moves custody only. It is in the survey because a reader homing this role
#      by region would reach a different answer than one homing it by consumer.
#
# DESCRIPTION IS OMITTED, not set to "": the live role has none.
# -----------------------------------------------------------------------------
resource "aws_iam_role" "sentiment_query_api_role" {
  name                 = "sentiment_query_api-role"
  path                 = "/"
  max_session_duration = 3600

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })

  # DELIBERATELY ABSENT: `inline_policy` and `managed_policy_arns` (the omission
  # rule; see note 2 above -- this role carries a managed attachment).
  # Also deliberately absent: `description`, which the live role does not have.
  # C-TWO-REMEDIES: this cell moves CUSTODY only. No permission, trust
  # relationship or usage of this role is touched.
}

# -----------------------------------------------------------------------------
# Adoption block. The id of an aws_iam_role is its NAME, underscore included.
# The label is fully namespaced and matches 0 of the 270 `aws_iam_role`
# declarations under infra/aws/terraform (measured).
# -----------------------------------------------------------------------------
import {
  to = aws_iam_role.sentiment_query_api_role
  id = "sentiment_query_api-role"
}

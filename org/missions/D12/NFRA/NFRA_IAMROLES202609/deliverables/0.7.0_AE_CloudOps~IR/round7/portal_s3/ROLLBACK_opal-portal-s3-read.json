{
  "RoleName": "opal-portal-lambda-role",
  "PolicyName": "opal-portal-s3-read",
  "PolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
          "s3:ListBucket"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:s3:::opal-data-smartx",
          "arn:aws:s3:::opal-data-smartx/*",
          "arn:aws:s3:::opal-data-smartx-v2",
          "arn:aws:s3:::opal-data-smartx-v2/*",
          "arn:aws:s3:::opal-portal-data",
          "arn:aws:s3:::opal-portal-data/*",
          "arn:aws:s3:::opal-data-portal-s3",
          "arn:aws:s3:::opal-data-portal-s3/*",
          "arn:aws:s3:::opal-data-portal-v2",
          "arn:aws:s3:::opal-data-portal-v2/*",
          "arn:aws:s3:::opal-data-news-v2",
          "arn:aws:s3:::opal-data-news-v2/*",
          "arn:aws:s3:::opal-market-data-v2",
          "arn:aws:s3:::opal-market-data-v2/*",
          "arn:aws:s3:::opal-data-aaii-sentiment",
          "arn:aws:s3:::opal-data-aaii-sentiment/*"
        ],
        "Sid": "S3ReadWrite"
      }
    ]
  }
}

{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "StopSelf",
            "Effect": "Allow",
            "Action": "ec2:StopInstances",
            "Resource": "arn:aws:ec2:us-east-1:313476888478:instance/*",
            "Condition": {
                "StringEquals": {
                    "ec2:ResourceTag/Name": "smartx-exporter"
                }
            }
        }
    ]
}

{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SmartXDataReadWrite",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::opal-data-smartx-v2",
                "arn:aws:s3:::opal-data-smartx-v2/*"
            ]
        },
        {
            "Sid": "SmartXLegacyRead",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::opal-data-smartx",
                "arn:aws:s3:::opal-data-smartx/*"
            ]
        },
        {
            "Sid": "PortalViewsSync",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::opal-data-portal-v2",
                "arn:aws:s3:::opal-data-portal-v2/*"
            ]
        }
    ]
}

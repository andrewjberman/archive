                "arn:aws:s3:::opal-data-portal-v2/*"
            ]
        },
        {
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-mdpf",
                "arn:aws:s3:::opal-data-mdpf/*"
            ],
            "Sid": "MdpfFeedReadForDistribution"
        }
    ]
}

{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SmartXCredentials",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret"
            ],
            "Resource": [
                "arn:aws:secretsmanager:us-east-1:313476888478:secret:smartx/credentials/username-*",
                "arn:aws:secretsmanager:us-east-1:313476888478:secret:smartx/credentials/password-*"
            ]
        },
        {
            "Sid": "SmartXConfig",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret"
            ],
            "Resource": [
                "arn:aws:secretsmanager:us-east-1:313476888478:secret:opal/smartx/config-*",
                "arn:aws:secretsmanager:us-east-1:313476888478:secret:opal/external-apis-*"
            ]
        }
    ]
}

+def _capability(static_bearer: str) -> str:
+    """FWD-12: trade the long-lived static bearer for a short-TTL capability token at the gateway's
+    exchange endpoint, so the credential presented to the PROBE url EXPIRES rather than being held.
+    The static bearer is presented ONCE, to the exchange endpoint only. Raising here is deliberate:
+    the caller runs this inside the probe's EXISTING try, so a failed exchange is a failed probe on
+    the path that already exists -- no new alert trigger, no new branch."""
+    req = urllib.request.Request(
+        TOKEN_URL, data=b"", method="POST", headers={"Authorization": f"Bearer {static_bearer}"}
+    )
+    with urllib.request.urlopen(req, timeout=20) as r:
+        tok = json.loads(r.read().decode())
+    print(f"cred_path=exchange url={TOKEN_URL} aud={tok.get('aud')} ttl={tok.get('expires_in')}s")
+    return tok["capability_token"]
+
+

+# AMGT-bj-5 (Andrew-direct 2026-10-13, TWR pricing on every surface; census row A4 of DEMQUE_QUEUE_FORM_ANDREW_20261013.md): the research price axis also pulls
+# DAY_TO_DAY_TOT_RETURN_GROSS_DVDS over the LAST FIVE TRADING DAYS (lib.trading_calendar), about 500 history cells a day, and keeps it beside the PX_LAST history.
+# The rankings stay on PRICE: nothing below changes a ranking, the PX_LAST request, its writes or this script's exit code.
+TR_FIELD = "DAY_TO_DAY_TOT_RETURN_GROSS_DVDS"
+TR_WINDOW_TRADING_DAYS = 5
+
+
+def tr_window_start(as_of, days: int = TR_WINDOW_TRADING_DAYS):
+    """The first of the `days` trading days ending at `as_of` (inclusive), walking back with lib.trading_calendar, never BDay."""
+    start = as_of
+    for _ in range(days - 1):
+        start = trading_calendar.prev_trading_day(start)
+    return start
+
+
+def pull_total_return(blp, securities: list, sec_to_ticker: dict, start, as_of) -> dict:
+    """{ticker: [(date, value), ...]} of the total-return field for the window `start`..`as_of`, in requests of 20 securities; a row without the field is dropped."""
+    series: dict = {}
+    start_ymd, end_ymd = start.strftime("%Y%m%d"), as_of.strftime("%Y%m%d")
+    for grp in _chunks(securities, 20):
+        resp = blp.historical_data(grp, [TR_FIELD], start_ymd, end_ymd, "DAILY", timeout_s=180.0)
+        for sec, rows in resp.items():
+            ticker = sec_to_ticker.get(sec, sec)
+            kept = [r for r in (rows or []) if r.get(TR_FIELD) is not None]
+            if not kept:
+                continue
+            kept.sort(key=lambda r: r["date"])
+            series[ticker] = [(r["date"], float(r[TR_FIELD])) for r in kept]
+    return series
+
+
+def run_total_return_leg(blp, securities: list, sec_to_ticker: dict, as_of, as_of_key: str, dry_run: bool, say) -> dict:
+    """The total-return leg: pull, then persist write-once (nothing is persisted on a dry run). NEVER raises: a failure is logged and returned, and the caller ignores the
+    result for the exit code, exactly as the 90/365 window step is."""
+    result = {"pulled": 0, "persisted": None, "error": None}
+    try:
+        start = tr_window_start(as_of)
+        series = pull_total_return(blp, securities, sec_to_ticker, start, as_of)
+        result["pulled"] = len(series)
+        say("total-return leg: %d of %d ticker(s) carry %s over %s .. %s (%d trading days)" % (
+            len(series), len(securities), TR_FIELD, start.isoformat(), as_of.isoformat(), TR_WINDOW_TRADING_DAYS))
+        if dry_run:
+            say("total-return leg: DRY-RUN, nothing persisted")
+        elif series:
+            here = os.path.dirname(os.path.abspath(__file__))
+            if here not in sys.path:
+                sys.path.insert(0, here)
+            import price_series_persist
+
+            receipt = price_series_persist.persist_tr_series(as_of_key, start.isoformat(), as_of.isoformat(), series)
+            result["persisted"] = receipt
+            say("total-return leg: persisted %s (put_performed=%s existed=%s)" % (receipt.get("uri"), receipt.get("put_performed"), receipt.get("existed")))
+    except Exception as e:  # noqa: BLE001 -- the PX_LAST legs and the exit code stand whatever happens here
+        result["error"] = "%s: %s" % (type(e).__name__, e)
+        say("WARN: total-return leg could not run: %s" % result["error"])
+    return result
+
+
 def main(argv=None) -> int:
     ap = argparse.ArgumentParser(description=__doc__)
     ap.add_argument("--dry-run", action="store_true",
@@ -445,6 +503,9 @@ def main(argv=None) -> int:

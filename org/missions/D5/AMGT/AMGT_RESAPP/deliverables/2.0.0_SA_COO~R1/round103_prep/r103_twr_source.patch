         log(f"WARN: 90/365 window step could not run: {type(e).__name__}: {e}")
 
+    # AMGT-bj-5: the total-return leg, AFTER every PX_LAST leg and write; its result is not read by the exit-code logic below.
+    run_total_return_leg(blp, securities, sec_to_ticker, as_of, as_of_key, args.dry_run, log)
+
     failed = [p["axis"] for p in summary["products"] if p["state"] == STATE_FAILED]
     if args.dry_run:

+# AMGT-bj-5 (Andrew-direct 2026-10-13, TWR pricing on every surface): the daily job ALSO keeps the total-return series of the last five trading days, as a SECOND
+# write-once object under its own table, beside (never inside) the PX_LAST history: the PX_LAST objects, their schema and `load_history` are untouched.
+TABLE_TR = "price_history_tot_return"
+SCHEMA_TR = "price_tot_return_series_v1"
+FIELD_TR = "DAY_TO_DAY_TOT_RETURN_GROSS_DVDS"
+KIND_TR = "daily_5d"
+OBJECT_TR = "daily_5d.json"
+
+
 class NoYearHistory(LookupError):
     """No year-pull object exists in the history -- the 90/365 build has nothing to build from."""
 
@@ -114,6 +123,37 @@ def persist_series(kind, as_of_date, window_start, window_end, series_by_ticker,
     )
 
 
+def tr_series_doc(as_of_date, window_start, window_end, series_by_ticker) -> dict:
+    """The body of the total-return object: {"schema", "kind", "field", "as_of_date", "window_start", "window_end", "series": {ticker: [[date, value], ...]}}; no clock inside."""
+    return {
+        "schema": SCHEMA_TR,
+        "kind": KIND_TR,
+        "field": FIELD_TR,
+        "as_of_date": as_of_date,
+        "window_start": window_start,
+        "window_end": window_end,
+        "series": {
+            ticker: [[str(d)[:10], float(v)] for d, v in series]
+            for ticker, series in sorted(series_by_ticker.items())
+        },
+    }
+
+
+def persist_tr_series(as_of_date, window_start, window_end, series_by_ticker, client=None) -> dict:
+    """Land the total-return series, write-once per as_of: the same series again is a no-op, a different one for the same as_of is REFUSED (`BronzeImmutableError`),
+    exactly as `persist_series` does for PX_LAST. Returns bronze_put's receipt."""
+    from lib.research.harvest import store
+
+    doc = tr_series_doc(as_of_date, window_start, window_end, series_by_ticker)
+    body = json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
+    return store.bronze_put(
+        SOURCE, TABLE_TR, partition_for(as_of_date), OBJECT_TR, body,
+        content_type="application/json",
+        metadata={"received-form": FORM_NORMALISED},
+        client=client or _default_client(),
+    )
+
+
 def _list_keys(client) -> list:
     prefix = history_prefix()
     bucket = _bucket()

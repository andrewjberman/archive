[
    [
        "Allow",
        [
            "s3:GetObject"
        ],
        [
            "arn:aws:s3:::opal-data-harvest/publication-links/v1/*",
            "arn:aws:s3:::opal-data-harvest/publications/v1/*",
            "arn:aws:s3:::opal-data-harvest/crosswalk/v1/*",
            "arn:aws:s3:::opal-data-harvest/universe/v1/*"
        ]
    ],
    [
        "Allow",
        [
            "s3:ListBucket"
        ],
        [
            "arn:aws:s3:::opal-data-harvest"
        ]
    ],
    [
        "Allow",
        [
            "dynamodb:PutItem",
            "dynamodb:BatchWriteItem"
        ],
        [
            "arn:aws:dynamodb:us-east-1:313476888478:table/opal-harvest-security-metrics"
        ]
    ],
    [
        "Allow",
        [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents"
        ],
        [
            "arn:aws:logs:us-east-1:313476888478:log-group:/aws/lambda/amgt-resapp-chatter-axis:*"
        ]
    ]
]

{
    "RoleName": "opal-amgt-scoped-api-role",
    "PolicyName": "opal-amgt-scoped-api-grants",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": [
                    "dynamodb:Query",
                    "dynamodb:GetItem",
                    "dynamodb:BatchGetItem"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:313476888478:table/opal-harvest-security-metrics",
                    "arn:aws:dynamodb:us-east-1:313476888478:table/opal-harvest-security-metrics/index/*"
                ],
                "Sid": "ReadRankedAxesAndPoints"
            },
            {
                "Action": [
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::opal-data-harvest/publication-links/v1/*",
                    "arn:aws:s3:::opal-data-harvest/publications/v1/*",
                    "arn:aws:s3:::opal-data-harvest/universe/v1/*",
                    "arn:aws:s3:::opal-data-harvest/crosswalk/v1/*",
                    "arn:aws:s3:::opal-data-harvest/filings/v1/*",
                    "arn:aws:s3:::opal-data-harvest/drafting/v1/*",
                    "arn:aws:s3:::opal-data-harvest/peers/v1/*",
                    "arn:aws:s3:::opal-data-harvest/management/v1/*",
                    "arn:aws:s3:::opal-data-harvest/posture/v1/*",
                    "arn:aws:s3:::opal-data-harvest/derived/model_block/*",
                    "arn:aws:s3:::opal-data-harvest/packs/*",
                    "arn:aws:s3:::opal-data-harvest/scores/v1/*",
                    "arn:aws:s3:::opal-data-harvest/bloomberg/harvest/bronze/*",
                    "arn:aws:s3:::opal-data-harvest/bloomberg/harvest/silver/*",
                    "arn:aws:s3:::opal-data-harvest/seeking-alpha/harvest/bronze/*",
                    "arn:aws:s3:::opal-data-harvest/seeking-alpha/harvest/silver/*",
                    "arn:aws:s3:::opal-data-harvest/sec/harvest/silver/*",
                    "arn:aws:s3:::opal-data-harvest/barrons/harvest/silver/*",
                    "arn:aws:s3:::opal-data-harvest/wsj/harvest/silver/*",
                    "arn:aws:s3:::opal-data-harvest/ft/harvest/silver/*",
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/state/filing_attempt/*",
                    "arn:aws:s3:::opal-data-harvest/bright-data/harvest/bronze/*",
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/chatter_daily/*",
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/chatter_event/*",
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/article_security_mention/*",
                    "arn:aws:s3:::opal-data-harvest/barrons/harvest/silver/article/*",
                    "arn:aws:s3:::opal-data-harvest/bloomberg/harvest/silver/article/*",
                    "arn:aws:s3:::opal-data-harvest/ft/harvest/silver/article/*",
                    "arn:aws:s3:::opal-data-harvest/seeking-alpha/harvest/silver/article/*",
                    "arn:aws:s3:::opal-data-harvest/wsj/harvest/silver/article/*",
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/research_dossier/*",
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/chatter_window/*",
                    "arn:aws:s3:::opal-data-harvest/issuer-site/harvest/silver/filing_source/*"
                ],
                "Sid": "ReadThePoolPrefixesTheAdapterReads"
            },
            {
                "Action": [
                    "s3:ListBucket"
                ],
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "publication-links/v1/*",
                            "publications/v1/*",
                            "universe/v1/*",
                            "crosswalk/v1/*",
                            "filings/v1/*",
                            "drafting/v1/*",
                            "peers/v1/*",
                            "management/v1/*",
                            "posture/v1/*",
                            "derived/model_block/*",
                            "packs/*",
                            "scores/v1/*",
                            "bloomberg/harvest/bronze/*",
                            "bloomberg/harvest/silver/*",
                            "seeking-alpha/harvest/bronze/*",
                            "seeking-alpha/harvest/silver/*",
                            "sec/harvest/silver/*",
                            "barrons/harvest/silver/*",
                            "wsj/harvest/silver/*",
                            "ft/harvest/silver/*",
                            "amgt/harvest/state/filing_attempt/*",
                            "bright-data/harvest/bronze/*",
                            "amgt/harvest/gold/chatter_daily/*",
                            "amgt/harvest/gold/chatter_event/*",
                            "amgt/harvest/gold/article_security_mention/*",
                            "barrons/harvest/silver/article/*",
                            "bloomberg/harvest/silver/article/*",
                            "ft/harvest/silver/article/*",
                            "seeking-alpha/harvest/silver/article/*",
                            "wsj/harvest/silver/article/*",
                            "amgt/harvest/gold/research_dossier/*",
                            "amgt/harvest/gold/chatter_window/*",
                            "issuer-site/harvest/silver/filing_source/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::opal-data-harvest"
                ],
                "Sid": "ListOnlyThePoolPrefixesTheAdapterReads"
            },
            {
                "Action": [
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:313476888478:table/opal-harvest-security-metrics"
                ],
                "Sid": "WriteOnlyTheFirmsOwnStarMarkers"
            },
            {
                "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:BatchGetItem"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:dynamodb:us-east-1:313476888478:table/etf-classifications"
                ],
                "Sid": "ReadTheServedEtfClassificationLabels"
            },
            {
                "Action": [
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::opal-data-portal-v2/json/security_scanner/latest/universes/sp500/universe_data.json"
                ],
                "Sid": "ReadTheScannerSp500UniverseForCoveredNoBlock"
            },
            {
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::opal-data-harvest/amgt/harvest/state/freshness_snapshot/current/snapshot.json"
                ],
                "Sid": "ReadAndWriteTheFreshnessSnapshotObjectOnly"
            }
        ]
    }
}

--- comp-iam service opal-research-pull-enqueue (before) ---
SERVICE: opal-research-pull-enqueue-role  [iam-role]
  IAM role: opal-research-pull-enqueue-role
  tf_resource: harvest_enqueue
  source: infra/aws/terraform/harvest/api-gateway.tf
  statements: 3

  Statement 1: Allow
    Actions (1):
      sqs:SendMessage
  Statement 2: Allow
    Actions (1):
      s3:PutObject
    Resources (1):
      ${aws_s3_bucket.harvest.arn}/packs/*/status.json
  Statement 3: Allow
    Actions (3):
      logs:CreateLogGroup
      logs:CreateLogStream
      logs:PutLogEvents
    Resources (1):
      *


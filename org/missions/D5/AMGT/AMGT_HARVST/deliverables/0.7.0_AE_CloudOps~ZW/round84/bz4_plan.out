  pythonw.exe present beside python.exe -> True
  (without it the installer REFUSES: "REFUSED: -Windowless takes the pythonw.exe beside python.exe")

$ powershell -NoProfile -ExecutionPolicy Bypass -File "<new>\lib\opal_data_harvest\install-cycle-schedule.ps1" \
    -RepoRoot "<new>" -Publishers bbg,wsj,barrons \
    -StateDir "C:/Users/Opal Bloomberg/Desktop/wk-harvest-runner-pin-c1be67f53c/.runtime/harvest-cycle/state" \
    -RuntimeRoot "C:/Users/Opal Bloomberg/Desktop/wk-harvest-runner-pin-c1be67f53c/.runtime/harvest-cycle/runtime" \
    -Windowless -Plan


TRIGGER AtLogOn Opal_Bloomberg\Opal Bloomberg
ACTION C:\Program Files\Python314\pythonw.exe -m lib.opal_data_harvest.cycle_runner --state-dir "C:/Users/Opal Bloomberg/Desktop/wk-harvest-runner-pin-c1be67f53c/.runtime/harvest-cycle/state" --runtime-root "C:/Users/Opal Bloomberg/Desktop/wk-harvest-runner-pin-c1be67f53c/.runtime/harvest-cycle/runtime" --stop-file "C:\Users\Opal Bloomberg\Desktop\wk-harvest-runner-pin-995adcaeaa\.runtime\harvest-cycle\STOP" --publishers bbg wsj barrons
WORKDIR C:\Users\Opal Bloomberg\Desktop\wk-harvest-runner-pin-995adcaeaa
TIMELIMIT PT0S
MULTIPLE IgnoreNew
RESTART 3 PT5M
REGISTERED NOTHING (plan)


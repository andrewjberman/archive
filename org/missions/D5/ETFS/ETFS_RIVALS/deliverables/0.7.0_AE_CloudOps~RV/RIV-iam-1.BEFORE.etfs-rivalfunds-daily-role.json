{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs/bloomberg/etfs/silver/holdings/*",
                "arn:aws:s3:::opal-data-etfs/issuer-site/etfs/bronze/holdings/*",
                "arn:aws:s3:::opal-data-etfs/issuer-site/etfs/silver/holdings/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/buying_trend/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/canonical_shape/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/flow_reconciliation/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/holding_contribution/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/holdings_coverage/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/input_census/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/peer_group_map/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/research_hypotheses/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/trade_schedule/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/platinum/page/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_bloomberg_silver/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_canonical_shape/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_coverage/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_flow_reconciliation/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_peer_group_map/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_silver/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_trade_schedule/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/fetch_holdings/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/publish_page/*"
            ],
            "Sid": "PutGetOwnPrefixes"
        },
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs/bloomberg/etfs/bronze/holdings/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/corporate_actions/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/security_market/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/fetch_bloomberg/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/pull_enrichment/*"
            ],
            "Sid": "GetUpstreamPrefixes"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "bloomberg/etfs/bronze/holdings/*",
                        "bloomberg/etfs/silver/holdings/*",
                        "issuer-site/etfs/bronze/holdings/*",
                        "issuer-site/etfs/silver/holdings/*",
                        "rivalfunds/etfs/gold/buying_trend/*",
                        "rivalfunds/etfs/gold/canonical_shape/*",
                        "rivalfunds/etfs/gold/corporate_actions/*",
                        "rivalfunds/etfs/gold/flow_reconciliation/*",
                        "rivalfunds/etfs/gold/holding_contribution/*",
                        "rivalfunds/etfs/gold/holdings_coverage/*",
                        "rivalfunds/etfs/gold/input_census/*",
                        "rivalfunds/etfs/gold/peer_group_map/*",
                        "rivalfunds/etfs/gold/research_hypotheses/*",
                        "rivalfunds/etfs/gold/security_market/*",
                        "rivalfunds/etfs/gold/trade_schedule/*",
                        "rivalfunds/etfs/platinum/page/*",
                        "rivalfunds/etfs/state/build_bloomberg_silver/*",
                        "rivalfunds/etfs/state/build_canonical_shape/*",
                        "rivalfunds/etfs/state/build_coverage/*",
                        "rivalfunds/etfs/state/build_flow_reconciliation/*",
                        "rivalfunds/etfs/state/build_peer_group_map/*",
                        "rivalfunds/etfs/state/build_silver/*",
                        "rivalfunds/etfs/state/build_trade_schedule/*",
                        "rivalfunds/etfs/state/fetch_bloomberg/*",
                        "rivalfunds/etfs/state/fetch_holdings/*",
                        "rivalfunds/etfs/state/publish_page/*",
                        "rivalfunds/etfs/state/pull_enrichment/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs"
            ],
            "Sid": "ListOwnAndUpstreamPrefixes"
        },
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-harvest/crosswalk/v1/*"
            ],
            "Sid": "GetIdentityCrosswalk"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "crosswalk/v1/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-harvest"
            ],
            "Sid": "ListIdentityCrosswalk"
        },
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs/bbg/*/constituents/constituents_issuer_fill.parquet"
            ],
            "Sid": "GetHomeLanding"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "bbg/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs"
            ],
            "Sid": "ListHomeLanding"
        },
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/chatter_daily/date=*",
                "arn:aws:s3:::opal-data-portal-v2/json-tiered/market-overview/rsi-summary.json",
                "arn:aws:s3:::opal-data-portal-v2/json/sentiment/fear-greed-index.json",
                "arn:aws:s3:::opal-data-portal-v2/json/sentiment/keyword-sentiments.json",
                "arn:aws:s3:::opal-data-portal-v2/json/trending/latest.json"
            ],
            "Sid": "GetMarketReadings"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "amgt/harvest/gold/chatter_daily/date=*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-harvest"
            ],
            "Sid": "ListMarketReadings"
        },
        {
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:secretsmanager:us-east-1:313476888478:secret:rivalfunds/openai-api-key-??????"
            ],
            "Sid": "GetOpenAISecret"
        }
    ]
}

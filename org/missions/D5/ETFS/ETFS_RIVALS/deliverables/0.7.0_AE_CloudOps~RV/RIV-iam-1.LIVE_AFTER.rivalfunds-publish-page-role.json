{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/buying_trend/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/holding_contribution/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/input_census/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/security_universe/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/platinum/page/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/publish_page/*"
            ],
            "Sid": "PutGetOwnPrefixes"
        },
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs/bloomberg/etfs/bronze/holdings/*",
                "arn:aws:s3:::opal-data-etfs/issuer-site/etfs/bronze/holdings/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/canonical_shape/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/flow_reconciliation/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/holdings_coverage/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/peer_group_map/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/research_hypotheses/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/security_market/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/security_names/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/trade_schedule/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/state/build_trade_schedule/*"
            ],
            "Sid": "GetUpstreamPrefixes"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "bloomberg/etfs/bronze/holdings/*",
                        "issuer-site/etfs/bronze/holdings/*",
                        "rivalfunds/etfs/gold/buying_trend/*",
                        "rivalfunds/etfs/gold/canonical_shape/*",
                        "rivalfunds/etfs/gold/flow_reconciliation/*",
                        "rivalfunds/etfs/gold/holding_contribution/*",
                        "rivalfunds/etfs/gold/holdings_coverage/*",
                        "rivalfunds/etfs/gold/input_census/*",
                        "rivalfunds/etfs/gold/peer_group_map/*",
                        "rivalfunds/etfs/gold/research_hypotheses/*",
                        "rivalfunds/etfs/gold/security_market/*",
                        "rivalfunds/etfs/gold/security_names/*",
                        "rivalfunds/etfs/gold/security_universe/*",
                        "rivalfunds/etfs/gold/trade_schedule/*",
                        "rivalfunds/etfs/platinum/page/*",
                        "rivalfunds/etfs/state/build_trade_schedule/*",
                        "rivalfunds/etfs/state/publish_page/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs"
            ],
            "Sid": "ListOwnAndUpstreamPrefixes"
        },
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-harvest/amgt/harvest/gold/chatter_daily/date=*",
                "arn:aws:s3:::opal-data-portal-v2/json-tiered/market-overview/rsi-summary.json",
                "arn:aws:s3:::opal-data-portal-v2/json/sentiment/fear-greed-index.json",
                "arn:aws:s3:::opal-data-portal-v2/json/sentiment/keyword-sentiments.json",
                "arn:aws:s3:::opal-data-portal-v2/json/trending/latest.json"
            ],
            "Sid": "GetMarketReadings"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "amgt/harvest/gold/chatter_daily/date=*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-harvest"
            ],
            "Sid": "ListMarketReadings"
        }
    ]
}

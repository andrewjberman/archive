   "condition_in_words": "np.select default (:874): none of the three conditions is true, i.e. the basket (included holdings plus positive cash) is above zero or the account is pure cash; the return is computed (:875-878). It can later be overwritten by IMPLAUSIBLE-RETURN (:883) or FOLLOWS-DISCONTINUITY (:952)."
  },
  {
   "token": "NO-PRIOR-HOLDINGS",
   "defined_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:220",
   "assigned_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:873",
   "condition_in_words": "np.select choice 1, condition at :869: held_count == 0 and cash_value == 0.0 -- no position row (included, excluded or negative) and exactly zero cash on the prior trading day."
  },
  {
   "token": "ALL-HOLDINGS-EXCLUDED",
   "defined_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:222",
   "assigned_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:873",
   "condition_in_words": "np.select choice 2, conditions at :870-871: held_count > 0, included_count == 0, negative_count == 0 and cash_value <= 0.0 -- the account held positions, none reached the basket (no identifier, or no price on both days), none was negative, and there is no positive cash."
  },
  {
   "token": "NON-POSITIVE-BASE",
   "defined_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:221",
   "assigned_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:873",
   "condition_in_words": "np.select choice 3, condition at :872: account_value <= 0.0 (account_value = included_value + positive cash, :856), reached only when neither earlier condition is true. By the first two conditions that means: (a) no position row and non-zero cash that is negative (a debit; positive cash would make the basket positive); (b) at least one negative position row, no included row, cash <= 0; (c) at least one included row of total value exactly 0 (included rows are value >= 0) and cash <= 0."
  },
  {
   "token": "IMPLAUSIBLE-RETURN",
   "defined_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:223",
   "assigned_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:883",
   "condition_in_words": "after the grade, a row that is status OK whose computed daily_return is <= -1.0 or >= 1.0 (_IMPLAUSIBLE_LO/_HI, :169; mask :881-882) is overwritten (:883) and its return nulled (:884)."
  },
  {
   "token": "FOLLOWS-DISCONTINUITY",
   "defined_at": "data/assets/scripts/gold/irpt_holdings_performance/holdings_performance.py:224",

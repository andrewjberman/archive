+# AR-y-293 (C-SWAP step 2). A symbol the provider answered NOT_FOUND goes to the injected yfinance checker (a port;
+# absent = the resolver of today, exactly). The checker's answers: KEPT, NOT_KEPT, CHECK_FAILED (with one reason
+# word) and NOT_CHECKED (beyond its per-upload cap). Only a verified KEPT changes the symbol's state.
+CHECK_STATES = frozenset({"KEPT", "NOT_KEPT", "CHECK_FAILED", "NOT_CHECKED"})
+CHECK_FAILED_REASONS = frozenset({"EXCEPTION", "TIMEOUT", "PUSHBACK", "ERROR_FRAME"})
+# A KEPT answer is cached no longer than the NOT_FOUND it replaces (the 900 s written at the provider step).
+KEPT_TTL = 900
+
+
+def _valid_kept_checker(entry):
+    """True when a checker entry carries the evidence a KEPT needs: a row count above zero and a finite positive close."""
+    return (isinstance(entry, dict) and type(entry.get("rows")) is int and entry["rows"] > 0
+            and type(entry.get("last_close")) in (int, float) and math.isfinite(entry["last_close"])
+            and entry["last_close"] > 0)
+
+
+def _checker_verdict(entry):
+    """(state, reason) for one checker entry. Anything that is not a closed, verifiable answer is CHECK_FAILED, never
+    an absence: a malformed entry reads ERROR_FRAME."""
+    if not isinstance(entry, dict) or entry.get("state") not in CHECK_STATES:
+        return "CHECK_FAILED", "ERROR_FRAME"
+    if entry["state"] == "KEPT":
+        return ("KEPT", None) if _valid_kept_checker(entry) else ("CHECK_FAILED", "ERROR_FRAME")
+    if entry["state"] == "CHECK_FAILED":
+        reason = entry.get("reason")
+        return "CHECK_FAILED", reason if reason in CHECK_FAILED_REASONS else "ERROR_FRAME"
+    return entry["state"], None
+
 

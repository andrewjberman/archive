+LATE_WINDOW_TRADING_DAYS = 14  # a day's trades can post to a silver partition up to this many trading days later (CTO ruling, dell1 finding)
+
+
+def shift_trading_days(day_iso, n):
+    """The trading day n trading days after (n >= 0) or before (n < 0) the trading day day_iso."""
+    d = dt.date.fromisoformat(day_iso)
+    if n >= 0:
+        return tc.trading_days_between(d, d + dt.timedelta(days=2 * n + 14))[n].isoformat()
+    return tc.trading_days_between(d - dt.timedelta(days=-2 * n + 14), d)[n - 1].isoformat()
+
+
+def transaction_partitions(reader, start, end):
+    """The fact_transactions partitions the window (start, end] reads: from `start` through the LATE_WINDOW_TRADING_DAYS-th trading
+    day after `end` (a day's trades land in LATER partitions, each partition being a rolling pull)."""
+    horizon = shift_trading_days(end, LATE_WINDOW_TRADING_DAYS)
+    return [p for p in reader.list_partitions("fact_transactions") if start <= p <= horizon]
+
+
+def transaction_rows_dated(reader, day):
+    """True when a fact_transactions row whose Trade Date is `day` exists in the partitions from `day` through the late window."""
+    for p in transaction_partitions(reader, day, day):
+        t = reader.read_parquet("fact_transactions", p).to_pydict()
+        if any(parse_trade_date(x) == day for x in t["Trade Date"]):
+            return True
+    return False
+

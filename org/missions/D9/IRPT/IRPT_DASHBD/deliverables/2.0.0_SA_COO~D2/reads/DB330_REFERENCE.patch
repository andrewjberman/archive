+/** One chart row: a served day, or a trading day the source did not report (`gap`). `isolated`: a measured day between two breaks. */
+export interface ChartRow {
+  readonly date: string
+  readonly cumulative: number | null
+  readonly quality: string
+  readonly gap: boolean
+  readonly isolated: boolean
+}
+
+/**
+ * IRPT_DASHBD DB-b-330 (CTO msg 10331 (a)): the chart draws every measured segment of the window, whatever the window's
+ * headline status. A day with no return, and a trading day the source did not report, are rows with no value, so the line
+ * breaks there and never joins across them. The headline figure keeps its own rule (BREAK shows "Not measured").
+ */
+export function chartRows(series: SeriesDocument, view: PerformanceView): ChartRow[] {
+  const byDate = new Map(view.path.map((point) => [point.date, point.cumulative]))
+  const served = new Set(series.date)
+  const first = series.date[0]
+  const last = series.date[series.date.length - 1]
+  const rows: { date: string; cumulative: number | null; quality: string; gap: boolean }[] = series.date.map((date, i) => ({
+    date, cumulative: byDate.get(date) ?? null, quality: series.day_quality[i], gap: false,
+  }))
+  for (const day of series.unreported_trading_days ?? []) {
+    if (!served.has(day) && day > first && day < last) rows.push({ date: day, cumulative: null, quality: '', gap: true })
+  }
+  rows.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0))
+  return rows.map((row, i) => ({
+    ...row,
+    isolated: row.cumulative !== null && (i === 0 || rows[i - 1].cumulative === null) && (i === rows.length - 1 || rows[i + 1].cumulative === null),
+  }))
+}
+
+/** A measured day with no measured neighbour draws no line, so it is drawn as a dot. */
+function IsolatedDot({ cx, cy, payload }: { cx?: number; cy?: number; payload?: ChartRow }) {
+  if (!payload?.isolated || typeof cx !== 'number' || typeof cy !== 'number') return null
+  return <circle cx={cx} cy={cy} r={3} fill={COLORS.opalNavy} />
+}

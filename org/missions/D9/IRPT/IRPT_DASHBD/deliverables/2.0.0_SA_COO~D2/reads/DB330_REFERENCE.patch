+/**
+ * IRPT_DASHBD round 150, workstream CHARTGAP, cell DB-b-330 (TO IRPT_DASHBD.TO-DB-b-330; CTO msg 10331 (a)) -- the Performance
+ * chart draws every measured segment of a window, with a break at each day that has no return and at each trading day the source
+ * did not report. It was BLANK for any window holding such a day (the curve waited on a MEASURED window). Made-up values only
+ * (the fixture of the round-147 cell, with one extra day left without a return); no network, no server.
+ */
+
+import { describe, expect, test } from 'bun:test'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { chartRows, performanceView, type WindowSelection } from '../../dashboard/DashboardPerformance'
+import { readSeries, type SeriesDocument } from '../../dashboard/seriesContract'
+
+const FIXTURES = fileURLToPath(new URL('./fixtures/', import.meta.url))
+const WHOLE: WindowSelection = { kind: 'custom', start: '2026-07-10', end: '2026-08-14' }
+const LATE: WindowSelection = { kind: 'custom', start: '2026-07-20', end: '2026-08-14' }
+
+function served(name: string, nullDay?: string): SeriesDocument {
+  const raw = JSON.parse(readFileSync(`${FIXTURES}${name}`, 'utf8')) as Record<string, unknown[]>
+  if (nullDay !== undefined) {
+    const i = (raw.date as string[]).indexOf(nullDay)
+    if (i < 0) throw new Error(`no such day ${nullDay}`)
+    raw.total_return_daily[i] = null
+    raw.day_quality[i] = 'NOT_MEASURABLE'
+  }
+  const read = readSeries(raw)
+  if (!read.ok) throw new Error(`${name} was refused: ${JSON.stringify(read.refusal)}`)
+  return read.document
+}
+
+describe('the chart rows of a window (DB-b-330)', () => {
+  test('a window with a no-return day is BREAK and still draws its measured days', () => {
+    const series = served('series-unreported-days.json', '2026-07-29')
+    const view = performanceView(series, LATE)
+    expect(view.status).toBe('BREAK')
+    const rows = chartRows(series, view)
+    const drawn = rows.filter((row) => row.cumulative !== null)
+    expect(drawn.length).toBeGreaterThan(5)
+    expect(rows.find((row) => row.date === '2026-07-29')?.cumulative).toBeNull()
+  })
+
+  test('the drawn values are the linked path of the window, day for day', () => {
+    const series = served('series-unreported-days.json', '2026-07-29')
+    const view = performanceView(series, LATE)
+    const rows = chartRows(series, view)
+    for (const point of view.path) expect(rows.find((row) => row.date === point.date)?.cumulative).toBe(point.cumulative)
+  })
+
+  test('a trading day the source did not report is a row with no value, in date order', () => {
+    const series = served('series-unreported-days.json')
+    const rows = chartRows(series, performanceView(series, WHOLE))
+    const gaps = rows.filter((row) => row.gap)
+    expect(gaps.map((row) => row.date)).toEqual(['2026-07-14', '2026-07-15', '2026-08-05'])
+    for (const gap of gaps) expect(gap.cumulative).toBeNull()
+    expect(rows.length).toBe(series.date.length + 3)
+    for (let i = 1; i < rows.length; i++) expect(rows[i].date > rows[i - 1].date).toBe(true)
+  })
+
+  test('a series with no statement of unreported days adds no row', () => {
+    const series = served('series-no-statement.json')
+    expect(chartRows(series, performanceView(series, WHOLE)).length).toBe(series.date.length)
+  })
+
+  test('a MEASURED window draws as before: every served day of it has a value', () => {
+    const series = served('series-unreported-empty.json')
+    const view = performanceView(series, LATE)
+    expect(view.status).toBe('MEASURED')
+    const inWindow = chartRows(series, view).filter((row) => row.date >= LATE.start && row.date <= LATE.end)
+    expect(inWindow.every((row) => row.cumulative !== null)).toBe(true)
+  })
+
+  test('a measured day between two breaks is marked isolated; a day beside a measured day is not', () => {
+    const series = served('series-unreported-days.json', '2026-07-17')
+    const rows = chartRows(series, performanceView(series, WHOLE))
+    const byDate = new Map(rows.map((row) => [row.date, row]))
+    expect(byDate.get('2026-07-16')?.isolated).toBe(true)
+    expect(byDate.get('2026-07-20')?.isolated).toBe(false)
+  })
+
+  test('a day outside the window has no value', () => {
+    const series = served('series-unreported-days.json', '2026-07-29')
+    const rows = chartRows(series, performanceView(series, LATE))
+    expect(rows.filter((row) => row.date < LATE.start).every((row) => row.cumulative === null)).toBe(true)
+  })
+})

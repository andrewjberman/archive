+# --- MX-s-18: the runner's own sentinel check ---------------------------------------------------
+# The one PERIOD table whose measured-empty window completes the day. realized is also a PERIOD
+# table but is NOT named by the ruling: it stays strict (has_data_rows==1 only).
+EMPTY_WINDOW_OK_TABLES = frozenset(("transactions",))
+SENTINEL_KEY_FMT = "bronze/{date}/_BRONZE_COMPLETE.json"  # the key this file already documents above
+_INFERRED_BASIS = "content_probe_backfill"  # mirrors the shared module's SIDECAR_BASIS_INFERRED
+
+
+def _measured_empty_sidecar(mod, table: str, as_of: str) -> bool:
+    """True IFF `table` may complete on an empty window AND its sidecar for as_of exists, is a
+    MEASURED record (never the retry-net's inferred class) and reads has_data_rows == 0. A missing
+    sidecar, a -1 (unparseable export) or any unreadable record is False (fail-closed)."""
+    if table not in EMPTY_WINDOW_OK_TABLES:
+        return False
+    try:
+        meta = json.loads(_s3.get_object(Bucket=BD_S3_BUCKET,
+                                         Key=mod._complete_key(table, as_of))["Body"].read())
+    except Exception:
+        return False
+    if meta.get("basis") == getattr(mod, "SIDECAR_BASIS_INFERRED", _INFERRED_BASIS):
+        return False
+    hdr = meta.get("has_data_rows")
+    return isinstance(hdr, int) and not isinstance(hdr, bool) and hdr == 0
+
+
+def _table_state(mod, table: str, as_of: str) -> str:
+    """'complete' | 'complete-empty' | 'missing' | 'incomplete' for one landed (table, as_of). Missing =
+    the bronze object itself is absent. 'complete-empty' = the measured-empty transactions exception."""
+    try:
+        _s3.head_object(Bucket=BD_S3_BUCKET, Key=mod._bronze_object_key(table, as_of))
+    except Exception:
+        return "missing"
+    if mod._table_complete(table, as_of):
+        return "complete"
+    if _measured_empty_sidecar(mod, table, as_of):
+        return "complete-empty"
+    return "incomplete"
+
+
+def _emit_sentinel(mod, run_date: str, landed: list) -> str:
+    """Decide completeness over `landed` [(table, as_of)], write the sentinel iff every table is
+    complete, then READ IT BACK with head_object and print 'OK: bronze sentinel emitted' only on that
+    read. Returns 'emitted' | 'withheld' | 'put-failed'. Raises RuntimeError when the read-back fails
+    (the invocation must visibly fail). Same key and body shape as the shared emit_bronze_sentinel."""
+    bad = {}
+    empty_ok = []
+    for table, as_of in landed:
+        state = _table_state(mod, table, as_of)
+        if state == "complete-empty":
+            empty_ok.append(table)
+        elif state != "complete":
+            bad[table] = state
+    if bad:
+        print("WARN: bronze sentinel NOT emitted for %s -- incomplete table(s): %s. Silver will NOT be "
+              "advanced on unverified content; the freshness/absence alarm is the signal."
+              % (run_date, ", ".join("%s(%s)" % (t, s) for t, s in sorted(bad.items()))))
+        return "withheld"
+    key = SENTINEL_KEY_FMT.format(date=run_date)
+    body = {
+        "stage": "bronze",
+        "run_date": run_date,
+        "completed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "overall": "success",
+        "artifacts": {
+            "tables": [t for t, _ in landed],
+            "count": len(landed),
+            "as_of": {t: a for t, a in landed},
+        },
+        "producer": "cot_bronze_ingest.py",
+    }
+    try:
+        _s3.put_object(Bucket=BD_S3_BUCKET, Key=key, Body=json.dumps(body).encode("utf-8"),
+                       ContentType="application/json")
+    except Exception as exc:  # noqa: BLE001 -- unchanged contract: LOUD but non-fatal, re-emits next run
+        print("ERROR: bronze sentinel emit FAILED (%s) -- silver trigger will NOT fire this "
+              "run; the freshness alarm is the backstop; re-emits next run" % exc)
+        return "put-failed"
+    try:
+        _s3.head_object(Bucket=BD_S3_BUCKET, Key=key)
+    except Exception as exc:  # noqa: BLE001
+        print("ERROR: bronze sentinel s3://%s/%s written but NOT read back (%s)" % (BD_S3_BUCKET, key, exc))
+        raise RuntimeError("bd-49f-runner: bronze sentinel read-back failed for %s: %s" % (key, exc))
+    note = " [measured-empty window accepted for: %s]" % ", ".join(empty_ok) if empty_ok else ""
+    print("OK: bronze sentinel emitted for %s (tables=%s)%s" % (run_date, landed, note))
+    return "emitted"
+

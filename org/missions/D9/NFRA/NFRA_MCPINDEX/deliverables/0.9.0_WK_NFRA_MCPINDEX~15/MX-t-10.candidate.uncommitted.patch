+    assert entry["read_tool"] == ETFS and entry["accessor"] == spec.accessor and entry["tools"] == [ETFS]
+    assert entry["freshness_field"] == "FIELD:data_as_of" and "s3_key" not in entry and "key" not in entry
+    row = pi._row_for(LOADED, spec.accessor)
+    assert row["key"] == ETFS_KEY and row["firm"] == "opal-internal" and row["allowlist"] == "ALLOWLISTED"
+    assert row["verdict_class"] == "serve-with-caveat" and row["verdict_state"] == "ruled"

{
  "transcripts": {
    "prefix": "/hx/transcripts",
    "secret_name": "gateway/transcripts/bearer",
    "bearer_label": "trnspt",
    "bearer_env": "TRANSCRIPT_BEARER",
    "meeting_allowlist_env": "TRANSCRIPT_MEETING_ALLOWLIST",
    "probes": {
      "transcripts_of_meeting": "{prefix}/meetings/{meeting_id}/transcripts",
      "transcript": "{prefix}/meetings/{meeting_id}/transcripts/{transcript_id}"
    }
  },
  "mail": {
    "prefix": "/hx/mail",
    "secret_name": "gateway/mail/bearer",
    "bearer_label": "msgpull",
    "bearer_env": "MAIL_BEARER",
    "sender_table_env": "MAIL_SENDER_TABLE",
    "pdf_cap_env": "MAIL_PDF_MAX_BYTES",
    "probes": {
      "message": "{prefix}/messages/{message_id}",
      "attachment": "{prefix}/messages/{message_id}/attachments/{attachment_id}"
    }
  }
}

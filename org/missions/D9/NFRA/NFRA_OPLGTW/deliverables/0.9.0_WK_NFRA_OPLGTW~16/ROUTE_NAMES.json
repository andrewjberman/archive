{
  "transcripts": {
    "prefix": "/hx/transcripts",
    "secret_name": "gateway/transcripts/bearer",
    "bearer_label": "trnspt",
    "bearer_env": "TRANSCRIPT_BEARER",
    "meeting_allowlist_env": "TRANSCRIPT_MEETING_ALLOWLIST",
    "probes": {
      "transcripts_of_meeting": "{prefix}/meetings/{meeting_id}/transcripts",
      "transcript": "{prefix}/meetings/{meeting_id}/transcripts/{transcript_id}"
    }
  }
}

{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "s3:GetObject"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs/daily/*",
                "arn:aws:s3:::opal-data-etfs/gold/book/*",
                "arn:aws:s3:::opal-data-etfs/gold/holding/*",
                "arn:aws:s3:::opal-data-etfs/platinum/etf_ownership_dashboard.json",
                "arn:aws:s3:::opal-data-etfs/platinum/reports/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/gold/*",
                "arn:aws:s3:::opal-data-etfs/rivalfunds/etfs/platinum/page/*",
                "arn:aws:s3:::opal-data-etfs/silver/holdings/*",
                "arn:aws:s3:::opal-data-etfs/silver/netassets_daily.parquet"
            ],
            "Sid": "InternalReaderEtfsObjectRead"
        },
        {
            "Action": [
                "s3:ListBucket"
            ],
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "daily/*",
                        "gold/book/*",
                        "gold/holding/*",
                        "platinum/reports/*",
                        "rivalfunds/etfs/gold/*",
                        "rivalfunds/etfs/platinum/page/*",
                        "silver/holdings/*"
                    ]
                }
            },
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-data-etfs"
            ],
            "Sid": "InternalReaderEtfsListConfined"
        }
    ]
}

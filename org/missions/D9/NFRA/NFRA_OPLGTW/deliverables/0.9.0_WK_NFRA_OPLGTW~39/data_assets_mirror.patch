+# --- OG-tm-1: a master the vendor does not publish a type for (08403355 has no slm) -----------
+def _og_tm1_inventory(master, types, date="20261007"):
+    import set_identity_guard as g
+    bronze, silver = {}, {}
+    for t in types:
+        bronze[t] = ["schwab/%s/bronze/%s/%s/%s.CRS%s.%s.zip" % (master, t, date, master, date, t.upper())]
+        for fact in g.expected_tables(t):
+            for tab in [fact] + list(g._dims_for_table(fact)):
+                silver.setdefault(tab, []).append(
+                    {"key": cm.canonical_object_key(master, tab, "2026-10-07"),
+                     "version_id": "v1", "size": 10, "etag": "e", "rows": 5})
+    return {"bronze": bronze, "silver": silver, "errors": []}
+
+
+_OG_TM1_TYPES = "acc rld rly rps rty sec tcfx tnn trn uln ult upn upt".split()
+
+
+def test_og_tm1_taxsma_day_without_slm_qualifies_and_names_slm_not_published():
+    c = cm.build_closure("r1", "event", "08403355", "2026-10-07",
+                         _og_tm1_inventory("08403355", _OG_TM1_TYPES), [])
+    assert c["status"] == "qualified" and c["findings"] == []
+    na = {(x["kind"], x["subject"]): x["reason"] for x in c["non_applicable"]}
+    assert na[("source_partition", "slm")] == "NOT_PUBLISHED_FOR_MASTER"
+    assert na[("table", "fact_slm")] == "NOT_PUBLISHED_FOR_MASTER"
+
+
+def test_og_tm1_the_declaration_is_this_master_only_and_never_hides_a_landed_slm():
+    other = cm.build_closure("r1", "event", "08242234", "2026-10-07",
+                             _og_tm1_inventory("08242234", _OG_TM1_TYPES), [])
+    assert {x["reason"] for x in other["non_applicable"] if x["subject"] == "fact_slm"} \
+        == {"DECLARED_NO_SOURCE_PARTITION"}
+    landed = cm.build_closure("r1", "event", "08403355", "2026-10-07",
+                              _og_tm1_inventory("08403355", _OG_TM1_TYPES + ["slm"]), [])
+    assert not [x for x in landed["non_applicable"] if "slm" in x["subject"]]
+    assert "fact_slm" in landed["expected_tables"]

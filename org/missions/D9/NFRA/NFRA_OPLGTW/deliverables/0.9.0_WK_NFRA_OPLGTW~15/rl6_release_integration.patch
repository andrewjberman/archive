+    async def _asset_holdings(self, principal: Principal, scope: de.Scope, master: str, date: str, operation: str,
+                              check: Callable[[], Any], cache: dict) -> Tuple[list, frozenset, Callable[[], Any]]:
+        """PRD C3 (":330-360" semantics.qualify_asset_plan's input): the CUSIPs a qualified POSITION snapshot for the same
+        master/date holds for the grant's authorized accounts, read solely for policy selection -- never a user-facing
+        join. ONE read for the query path and both download paths (prepare_download, export_query); each of the three
+        then calls sem.qualify_asset_plan itself. The position read reuses the caller's already-authorized `check` (the
+        dim_asset request already in flight), since the grant may carry no separate authorization for dim_position at all
+        (a partial-account dim_asset grant is not a dim_position grant). Returns (pos_sources, position_cusips,
+        pos_cleanup); the caller owns `pos_cleanup`."""
+        from .engine import PolicyFilter, QueryPlan
+        pos_entries = await self._entries(principal, master, sem.POSITION_DATASET, date, operation, cache)
+        pos_sources, pos_cleanup = self._fetch(pos_entries, check)
+        try:
+            if len(pos_sources) != len(pos_entries):
+                raise ServiceError(INCOMPLETE_SNAPSHOT, "scan_incomplete")
+            pos_accounts = tuple(sorted(scope.accounts.get(master, ())))
+            pos_plan = QueryPlan(mode="rows",
+                                 allowed_columns=(qry.ACCOUNT_SOURCE, sem.ASSET_QUALIFYING_FIELD),
+                                 columns=(sem.ASSET_QUALIFYING_FIELD,),
+                                 policy_filters=(PolicyFilter(qry.ACCOUNT_SOURCE, pos_accounts),))
+            self.jobs_run += 1
+            pos_job = await self._engine.run_query(principal.key, pos_plan, pos_sources)
+            if not pos_job.ok:
+                raise ServiceError(pos_job.code or INTERNAL_ERROR,
+                                   pos_job.reason or "asset_policy_selection_failed",
+                                   suggestion=pos_job.suggestion)
+            pos_rows = (pos_job.value or {}).get("rows") or []
+            position_cusips = frozenset(row[0] for row in pos_rows)
+        except BaseException:
+            pos_cleanup()
+            raise
+        return list(pos_sources), position_cusips, pos_cleanup
+

+def _classify_log(text: str) -> str | None:
+    """Signature from the LAST line of the chain log that starts with `CHAIN `.
+    None when the log carries no such line."""
+    last = None
+    for line in (text or "").splitlines():
+        if line.startswith("CHAIN "):
+            last = line
+    if last is None:
+        return None
+    if last.startswith("CHAIN OK"):
+        return "OK"
+    if last.startswith("CHAIN REFUSED"):
+        return "REFUSED"
+    if last.startswith("CHAIN ABORT"):
+        return "ABORT"
+    return None
+
+
+def _chain_log_keys(inv) -> list:
+    """Candidate log keys: TS, TS-1 s, TS+1 s (host-clock skew), TS from the
+    invocation's ExecutionStartDateTime (UTC, %Y%m%dT%H%M%SZ)."""
+    start = inv.get("ExecutionStartDateTime")
+    if not start or not CHAIN_LOG_PREFIX:
+        return []
+    if isinstance(start, datetime):
+        base = start.replace(tzinfo=None, microsecond=0)
+    else:
+        base = datetime.strptime(str(start)[:19], "%Y-%m-%dT%H:%M:%S")
+    return [
+        CHAIN_LOG_PREFIX + (base + timedelta(seconds=d)).strftime("%Y%m%dT%H%M%SZ") + ".log"
+        for d in (0, -1, 1)
+    ]
+
+
+def _classify(inv) -> str:
+    """Grade the chain log's terminal `CHAIN ` line (never SSM stdout, which is cut
+    at 24,000 chars). UNKNOWN is a real value and SAYS WHY: chain_log=absent when no
+    candidate key exists (without ListBucket an absent key reads AccessDenied, so
+    every read error counts as absent), chain_log=no terminal line when the log
+    has no `CHAIN ` line. Never guessed."""
+    if not CHAIN_LOG_BUCKET or not CHAIN_LOG_PREFIX:
+        return "UNKNOWN(chain_log=unconfigured)"
+    keys = _chain_log_keys(inv)
+    if not keys:
+        return "UNKNOWN(chain_log=absent, key=None)"
+    for key in keys:
+        try:
+            body = s3.get_object(Bucket=CHAIN_LOG_BUCKET, Key=key)["Body"].read()
+        except Exception as exc:  # NoSuchKey / AccessDenied / 404 -> absent
+            print(f"chain log key={key} not readable: {type(exc).__name__}")
+            continue
+        text = body.decode("utf-8", "replace") if isinstance(body, bytes) else str(body)
+        sig = _classify_log(text)
+        if sig is None:
+            return f"UNKNOWN(chain_log=no terminal line, key={key})"
+        return sig
+    return f"UNKNOWN(chain_log=absent, key={keys[0]})"
+
+
+def _marker_closure_status(record) -> tuple:
+    """(status_or_error, key, version) of the EXACT marker version that fired the
+    S3 event (never the latest). Anything unreadable returns an error string."""
+    s3rec = (record or {}).get("s3", {})
+    bucket = s3rec.get("bucket", {}).get("name")
+    raw_key = s3rec.get("object", {}).get("key")
+    version = s3rec.get("object", {}).get("versionId")
+    if not bucket or not raw_key:
+        return "error:event carries no bucket/key", raw_key, version
+    if not version:
+        return "error:event carries no versionId", raw_key, version
+    key = urllib.parse.unquote_plus(raw_key)
+    try:
+        body = s3.get_object(Bucket=bucket, Key=key, VersionId=version)["Body"].read()
+        doc = json.loads(body.decode("utf-8") if isinstance(body, bytes) else body)
+        status = doc["closure"]["status"]
+    except Exception as exc:  # absent key, read error, unparseable body
+        return f"error:{type(exc).__name__}", key, version
+    return str(status), key, version
 
 

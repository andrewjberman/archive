-def seed(upload: bool = False, sync_yang: bool = False) -> None:
+# The fields this seeder OWNS on the Yang table. A value the table already
+# serves for one of these, that DISAGREES with the seeder's, is a CONFLICT --
+# the same rule seed-etf-classifications.py:72-120 merge_item() applies.
+YANG_OWNED_FIELDS = ('asset_class', 'sub_asset_class', 'name')
+
+
+def _yang_conflicts(yang_table, sec):
+    """Fields the table already serves with a DIFFERENT non-blank value.
+
+    Returns [(field, live_value, seeder_value), ...]. An absent row returns []
+    -- a FIRST MINT is never a conflict and must still mint.
+    """
+    got = yang_table.get_item(Key={'ticker': sec['ticker']})
+    live = got.get('Item') or {}
+    if not live:
+        return []
+    out = []
+    for field in YANG_OWNED_FIELDS:
+        live_value = live.get(field)
+        if live_value is None or str(live_value).strip() == '':
+            continue
+        seeder_value = sec['name'] if field == 'name' else sec[field]
+        if str(live_value) != str(seeder_value):
+            out.append((field, live_value, seeder_value))
+    return out
+
+
+def seed(upload: bool = False, sync_yang: bool = False,
+         force: bool = False) -> int:
     dynamodb = boto3.resource('dynamodb', region_name=REGION)
     bd_table = dynamodb.Table(BD_SECURITIES_TABLE)
     yang_table = dynamodb.Table(YANG_TABLE) if sync_yang else None

+#!/usr/bin/env bash
+# =============================================================================
+# build-and-upload-chatter-axis.sh -- the chatter axis producer's ARTIFACT OF RECORD
+# (AMGT Lead Panel closer step 2a, R-19 @815d6c75da; CONTRACT.md s.5a durability).
+#
+#   build   : lambda_src/build_zip.py -> .build/chatter-axis-producer.zip, prints the sha256
+#   upload  : uploads .build/chatter-axis-producer.zip to the VERSIONED artifacts bucket at
+#             harvest/amgt-resapp-chatter-axis.zip WITH content-sha256 metadata (REQUIRED:
+#             modules/yang-lambda reads that metadata as source_code_hash, never the bytes),
+#             then READS THE OBJECT BACK and refuses unless the stored metadata equals the
+#             digest computed here (VERIFY-AFTER-WRITE: a cp rc=0 writes nothing on a
+#             converted path on this box).
+#   seed    : uploads a GIVEN zip (argument 2) to the same key -- used ONCE before the first
+#             candidate to give the PRE-CHANGE deployed bytes a durable, named version of
+#             their own (the rollback object of record), since the live function's only
+#             identity before 2a was its CodeSha256.
+#
+# Build and upload FIRST, then `terraform plan` / `safe-apply`: the module's data source
+# needs the object, and a rebuild after upload is a different artifact.
+# Git Bash 3.6.7-safe (CLAUDE.md Rule 16). ASCII only. No PyPI beyond build_zip.py's own
+# pinned wheels; the Arrow bytes come from this account's own layer, verified by sha256.
+# =============================================================================
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(git -C "$HERE" rev-parse --show-toplevel)"
+AWS="$ROOT/.tools/aws"
+BUCKET="opal-313476888478-lambda-artifacts"
+KEY="harvest/amgt-resapp-chatter-axis.zip"
+ZIP="$HERE/.build/chatter-axis-producer.zip"
+MODE="${1:-build}"
+
+sha_b64() { python -c "import base64,hashlib,sys; print(base64.b64encode(hashlib.sha256(open(sys.argv[1],'rb').read()).digest()).decode())" "$1"; }
+sha_hex() { python -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$1"; }
+
+upload_verified() {
+  local zip="$1"
+  [ -f "$zip" ] || { echo "ERROR: no zip at $zip" >&2; exit 2; }
+  local b64 hex size
+  b64="$(sha_b64 "$zip")"; hex="$(sha_hex "$zip")"; size="$(python -c "import os,sys; print(os.path.getsize(sys.argv[1]))" "$zip")"
+  echo "UPLOAD: $zip -> s3://$BUCKET/$KEY size=$size sha256_b64=$b64 sha256_hex=$hex"
+  MSYS_NO_PATHCONV=1 "$AWS" s3 cp "$zip" "s3://$BUCKET/$KEY" --metadata "content-sha256=$b64" --only-show-errors
+  local head stored_b64 stored_len version
+  head="$("$AWS" s3api head-object --bucket "$BUCKET" --key "$KEY" --output json)"
+  stored_b64="$(printf '%s' "$head" | python -c "import json,sys; print(json.load(sys.stdin).get('Metadata',{}).get('content-sha256',''))")"
+  stored_len="$(printf '%s' "$head" | python -c "import json,sys; print(json.load(sys.stdin).get('ContentLength',''))")"
+  version="$(printf '%s' "$head" | python -c "import json,sys; print(json.load(sys.stdin).get('VersionId',''))")"
+  if [ "$stored_b64" != "$b64" ] || [ "$stored_len" != "$size" ]; then
+    echo "ERROR: read-back mismatch: stored content-sha256=$stored_b64 len=$stored_len, expected $b64 len=$size" >&2
+    exit 3
+  fi
+  echo "OK: s3://$BUCKET/$KEY VersionId=$version content-sha256=$stored_b64 ContentLength=$stored_len (read back, matches)"
+}
+
+case "$MODE" in
+  build)
+    python "$HERE/lambda_src/build_zip.py"
+    echo "OK: built $ZIP sha256_b64=$(sha_b64 "$ZIP") sha256_hex=$(sha_hex "$ZIP")"
+    ;;
+  upload)
+    upload_verified "$ZIP"
+    ;;
+  seed)
+    [ -n "${2:-}" ] || { echo "usage: $0 seed <zip-of-the-currently-deployed-bytes>" >&2; exit 2; }
+    upload_verified "$2"
+    ;;
+  *)
+    echo "usage: $0 build | upload | seed <zip>" >&2
+    exit 2
+    ;;
+esac

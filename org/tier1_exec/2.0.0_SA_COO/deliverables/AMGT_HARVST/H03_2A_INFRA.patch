@@ -0,0 +1,119 @@
+"""Offline arms for the chatter axis Lambda handler (AMGT Lead Panel closer step 2a).
+
+Run from the repo root:  python -m pytest infra/aws/terraform/harvest/lambda_src -q
+
+What is exercised: the environment-driven source selection (absent -> legacy, the two
+names -> their count functions, anything else -> refused before a read), and the
+handler's plumbing -- the selected count function reaches compute_chatter_axis on the
+primary path, `dry_run` maps to write_fn=None, the memo is cleared per invocation, and
+the run line names the population `names_with_links` counted. compute_chatter_axis is
+replaced by a recorder here; the producer's own behaviour has its own suites under
+lib/research/metrics/tests. Nothing here touches AWS.
+"""
+from __future__ import annotations
+
+import importlib.util
+import os
+import sys
+import unittest
+from unittest import mock
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+_REPO = os.path.abspath(os.path.join(_HERE, "..", "..", "..", "..", ".."))
+if _REPO not in sys.path:
+    sys.path.insert(0, _REPO)
+
+_spec = importlib.util.spec_from_file_location(
+    "chatter_axis_lambda_function", os.path.join(_HERE, "lambda_function.py")
+)
+lambda_function = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(lambda_function)
+
+from lib.research.metrics import chatter_axis  # noqa: E402
+
+
+def _summary():
+    return {
+        "as_of_date": "2026-09-24",
+        "tickers_considered": 2,
+        "rows_ranked": 0,
+        "rows_written": 0,
+        "run_id": "R1",
+        "coverage_vintage": "v",
+        "universe": {"source": "pool:universe/v1/x.json", "names_read": 2, "names_considered": 2},
+        "read_detail": {"A": {"store_item_count": 3}, "B": {"store_item_count": 0}},
+        "input_coverage": {"resolved": 0, "required": 2, "unit": "security windows", "window_days": 30},
+        "products": [
+            {
+                "axis": "TRENDING_CHATTER", "rows_ranked": 0, "rows_written": 0,
+                "generation_id": "g", "state": "FAILED", "pointer_written": False,
+                "reason_code": "INCOMPLETE_GOLD_INPUT", "failure_reason": "HOLD",
+                "receipt": None,
+            }
+        ],
+    }
+
+
+class SelectSourceTest(unittest.TestCase):
+    def test_absent_and_empty_are_legacy(self):
+        self.assertEqual(lambda_function.select_source({}), "legacy")
+        self.assertEqual(lambda_function.select_source({"CHATTER_AXIS_SOURCE": ""}), "legacy")
+        self.assertEqual(lambda_function.select_source({"CHATTER_AXIS_SOURCE": "  "}), "legacy")
+
+    def test_named_sources_resolve_to_the_module_map(self):
+        for name in chatter_axis.SOURCE_COUNT_FNS:
+            self.assertEqual(lambda_function.select_source({"CHATTER_AXIS_SOURCE": name.upper()}), name)
+
+    def test_unknown_source_is_refused(self):
+        with self.assertRaises(ValueError):
+            lambda_function.select_source({"CHATTER_AXIS_SOURCE": "silver"})
+
+
+class HandlerPlumbingTest(unittest.TestCase):
+    def _run(self, env, event):
+        calls = []
+
+        def recorder(**kwargs):
+            calls.append(kwargs)
+            return _summary()
+
+        with mock.patch.dict(os.environ, env, clear=False), \
+                mock.patch.object(lambda_function, "compute_chatter_axis", recorder), \
+                mock.patch.object(lambda_function.pool_reader, "clear_caches") as cleared:
+            out = lambda_function.handler(event, None)
+        return calls, out, cleared
+
+    def test_gold_dry_run_passes_gold_count_fn_and_no_writer(self):
+        calls, out, cleared = self._run({"CHATTER_AXIS_SOURCE": "gold"}, {"dry_run": True})
+        self.assertEqual(len(calls), 1)
+        self.assertIs(calls[0]["count_fn"], chatter_axis.gold_daily_mention_scores)
+        self.assertIsNone(calls[0]["write_fn"])
+        self.assertTrue(out["dry_run"])
+        self.assertEqual(out["source"], "gold")
+        self.assertEqual(out["input_coverage"]["resolved"], 0)
+        self.assertEqual(out["products"][0]["reason_code"], "INCOMPLETE_GOLD_INPUT")
+        self.assertEqual(out["universe"]["names_with_links"], 1)
+        self.assertIn("gold day record", out["universe"]["names_with_links_population"])
+        self.assertEqual(cleared.call_count, 1)
+
+    def test_legacy_scheduled_event_passes_legacy_count_fn_and_the_writer(self):
+        env = {k: v for k, v in os.environ.items() if k != "CHATTER_AXIS_SOURCE"}
+        with mock.patch.dict(os.environ, env, clear=True):
+            calls, out, _ = self._run({}, {"version": "0", "source": "aws.scheduler"})
+        self.assertIs(calls[0]["count_fn"], chatter_axis.default_daily_article_counts)
+        self.assertIs(calls[0]["write_fn"], chatter_axis.default_write_generation)
+        self.assertFalse(out["dry_run"])
+        self.assertEqual(out["source"], "legacy")
+        self.assertIn("publication-links", out["universe"]["names_with_links_population"])
+
+    def test_unknown_source_refuses_before_any_compute(self):
+        calls = []
+        with mock.patch.dict(os.environ, {"CHATTER_AXIS_SOURCE": "bronze"}, clear=False), \
+                mock.patch.object(lambda_function, "compute_chatter_axis", lambda **kw: calls.append(kw)):
+            with self.assertRaises(ValueError):
+                lambda_function.handler({}, None)
+        self.assertEqual(calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()

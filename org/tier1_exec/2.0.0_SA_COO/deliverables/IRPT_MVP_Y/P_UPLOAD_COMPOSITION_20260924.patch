+def _upload_world(ordinary):
+    """The served boundary over Y's deferred lane: the REAL InteractiveAccess authorizer bound to
+    retained repositories on an AWS-shaped table; `ordinary` stands in for the absent producer."""
+    import base64
+    sys.path.insert(0, str(ROOT / "infra/aws/lambda/investor-reporting/intake/tests"))
+    import test_deferred_resolution as deferred
+    import test_uploads as legacy
+    repo = legacy.repo
+    table, s3, sent = deferred.StateTable(), legacy.support.S3(), []
+    ports = gi.compose_ports(clients=fake_clients(), environ=ENV, reporting_policy=active_policy)
+
+    def repositories(access):
+        artifacts = repo.ArtifactRepository(repo.DynamoReportIndex(table), repo.S3ReportBlobs(s3,
+            lambda firm, family, identity, revision: ("offline-private", "/".join((firm, family, identity, revision)))),
+            access.authorize_current, {"ORIGINAL_HOLDINGS", "NORMALIZED_PORTFOLIO"})
+        return SimpleNamespace(artifacts=artifacts)
+    ports.update(repositories=repositories, ordinary_authorizer=ordinary,
+                 send=lambda queue, body: sent.append((queue, body)) or {"MessageId": "offline"})
+    body = {"upload_token": "boundary-upload-one", "filename": "holdings.csv", "file_type": "csv",
+            "file_base64": base64.b64encode(b"Ticker,Dollars\nAAPL,10.01\nVNQ,2.02\n").decode()}
+    event = {"routeKey": gi.UPLOAD_ROUTE, "headers": legacy.claims(), "body": json.dumps(body)}
+    return gi.build_boundary(ports), event, table, sent
+

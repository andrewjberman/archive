+def test_the_upload_route_publishes_resolving_and_sends_one_message(monkeypatch):
+    # The deployed function carries Terraform's firm -> bucket map; offline it is set here.
+    monkeypatch.setenv("IRPT_DIRECTORY_BUCKET_MAP", json.dumps({"49financial": "opal-data-49financial"}))
+    boundary, event, table, sent = _upload_world(lambda request, p, o: True)
+    answer = boundary.handle(event)
+    assert "data" in answer, answer
+    assert answer["data"]["state"] == "RESOLVING" and answer["data"]["input_id"] is None
+    assert len(sent) == 1 and sent[0][0] == ENV[gi.QUEUE_URL_ENV]
+    assert json.loads(sent[0][1])["kind"] == "resolve_upload"
+    keys = sorted(k.split("#")[0] for _, k in table.rows)
+    assert keys.count("UPLOAD") == 1 and keys.count("NORMALIZATION") == 1 and "INPUT" not in keys
+    assert boundary.handle(event)["data"]["state"] == "RESOLVING" and len(sent) == 1
+

+def compose_upload(ports, request, scope):
+    """The upload POST's request-local composition (Y bb1eb7f92b, CTO 100667 shape 2).
+
+    Interactive access on the guarded prospect owner's storage firm, the retained repositories
+    bound to that access, and Y's deferred template lane: retain, publish RESOLVING, send ONE
+    resolve_upload message to irpt-generation, answer RESOLVING. This Lambda never calls the
+    vendor. The principal is access.current(), the exact value authorize_current admits. An
+    ordinary (non-Opal) viewer is admitted only through ports["ordinary_authorizer"], which is
+    still an absent producer, so until it exists only a verified Opal viewer can upload.
+    """
+    from interactive_access import InteractiveAccess
+    from upload_resolution import deferred_upload_service
+    owner = scope.get("prospect_owner")
+    if not isinstance(owner, dict) or not isinstance(owner.get("firm_id"), str):
+        raise PermissionError("PROSPECT_GUARD_REQUIRED")
+    ordinary = ports.get("ordinary_authorizer")
+    access = InteractiveAccess(lambda: request.headers, owner["firm_id"],
+        ordinary_authorizer=(lambda p, o: ordinary(request, p, o)) if callable(ordinary) else None)
+    stores = ports["repositories"](access)
+    index = stores.artifacts.index
+    service = deferred_upload_service(index=index, artifacts=stores.artifacts,
+        authorize_current=access.authorize_current, table=index.table,
+        send=lambda body: ports["send"](ports["queue_url"], body))
+    return service, access
+
+
 def build_boundary(ports):

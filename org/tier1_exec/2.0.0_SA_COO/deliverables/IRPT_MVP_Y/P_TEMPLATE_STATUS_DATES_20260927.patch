+# The template reader's own header vocabulary (intake/template_reader.py): column A names the
+# security, column B the basis. Shares is left out: a priced quantity carries a price date.
+_TEMPLATE_SYMBOL_HEADERS = ("ticker", "symbol")
+_TEMPLATE_UNDATED_BASES = {"dollars": "USD", "target weight": "TARGET_WEIGHT", "current weight": "CURRENT_WEIGHT"}
+
+
+def _undated_template_csv(data, document):
+    """The v2 two-column CSV template, proved cell by cell against its frozen census.
+
+    The reader keeps only columns A and B, so the RAW file is re-read here. Every row must
+    be exactly two cells (a date in a third column would otherwise vanish unseen), and every
+    non-blank row must be the census's own cells. XLSX has no bounded proof yet.
+    """
+    try:
+        template = document["template"]
+        if (not isinstance(data, bytes) or not 0 < len(data) <= 1024 * 1024
+                or template.get("schema_version") != "irpt-template.v2" or template.get("file_type") != "csv"
+                or template.get("content_sha256") != hashlib.sha256(data).hexdigest()
+                or template.get("findings") or document.get("findings") or document.get("prices")
+                or document.get("options", {}).get("price_date") is not None
+                or any(row.get("price") is not None for row in document["rows"])):
+            return False
+        headers = template["headers"]
+        a1, b1 = headers["A"]["text"].strip().lower(), headers["B"]["text"].strip().lower()
+        if a1 not in _TEMPLATE_SYMBOL_HEADERS or _TEMPLATE_UNDATED_BASES.get(b1) != template.get("basis"):
+            return False
+        census = {1: (headers["A"], headers["B"])}
+        census.update({row["row"]: (row["cells"]["A"], row["cells"]["B"]) for row in template["rows"]})
+        seen = set()
+        for number, values in enumerate(csv.reader(io.StringIO(data.decode("utf-8-sig"), newline=""), strict=True), 1):
+            if not values or values == ["", ""]:
+                continue
+            cells = census.get(number)
+            if (len(values) != 2 or cells is None
+                    or any(c["formula"] or c["invalid"] or c["text"] != v for c, v in zip(cells, values))):
+                return False
+            seen.add(number)
+        return bool(template["rows"]) and seen == set(census)
+    except (ValueError, KeyError, TypeError, IndexError, AttributeError, UnicodeError, csv.Error):
+        return False
+

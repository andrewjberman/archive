+# The XLSX template: real workbooks (openpyxl) through the real template reader, so the census is the reader's own.
+def xlsx(rows, *, extra_sheet=None, first_title=None):
+    import io as _io
+    openpyxl = pytest.importorskip("openpyxl")
+    book = openpyxl.Workbook()
+    sheet = book.active
+    if first_title:
+        sheet.title = first_title
+    for row in rows:
+        sheet.append(list(row))
+    if extra_sheet:
+        other = book.create_sheet(extra_sheet[0])
+        for row in extra_sheet[1]:
+            other.append(list(row))
+    out = _io.BytesIO()
+    book.save(out)
+    return out.getvalue()
+

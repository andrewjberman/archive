+# The TEMPLATE_UPLOAD lane (window 15's live Overview, REQ-67e12718): its v2 document, trimmed to what the proof reads.
+TEMPLATE_RAW = b"Ticker,Dollars\nAAPL,10.01\nVNQ,2.02\n"
+
+
+def _cell(column, row, text):
+    return {"column": column, "row": row, "text": text, "raw": text, "formula": False, "invalid": False}
+
+
+def template_document(raw=TEMPLATE_RAW, header_b="Dollars", basis="USD", file_type="csv"):
+    import hashlib
+    rows = [{"row": n, "symbol": s, "amount": a, "basis": basis, "cells": {"A": _cell("A", n, s), "B": _cell("B", n, a)}}
+            for n, (s, a) in ((2, ("AAPL", "10.01")), (3, ("VNQ", "2.02")))]
+    owner = {"firm_id": "cottonwood", "principal_id": "irpt-uiwalk-1790524948@opal.test", "advisor_id": None}
+    return {"schema_version": "irpt-normalized-portfolio.v2", "owner": owner, "findings": [], "prices": {},
+            "options": {"price_date": None, "reference_notional": None},
+            "rows": [{"security_id": r["symbol"], "price": None, "original": r} for r in rows],
+            "source": {"lane": "TEMPLATE_UPLOAD", "upload_id": "UP-" + "3" * 64, "file_type": file_type,
+                       "content_sha256": hashlib.sha256(raw).hexdigest()},
+            "template": {"schema_version": "irpt-template.v2", "file_type": file_type, "basis": basis, "findings": [],
+                         "content_sha256": hashlib.sha256(raw).hexdigest(), "sheet": None,
+                         "headers": {"A": _cell("A", 1, "Ticker"), "B": _cell("B", 1, header_b)}, "rows": rows}}
+

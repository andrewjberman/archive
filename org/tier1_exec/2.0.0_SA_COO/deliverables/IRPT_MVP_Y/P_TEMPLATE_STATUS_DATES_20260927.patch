+# The template reader's own header vocabulary (intake/template_reader.py): column A names the
+# security, column B the basis. Shares is left out: a priced quantity carries a price date.
+_TEMPLATE_SYMBOL_HEADERS = ("ticker", "symbol")
+_TEMPLATE_UNDATED_BASES = {"dollars": "USD", "target weight": "TARGET_WEIGHT", "current weight": "CURRENT_WEIGHT"}
+_SHEET_NS = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
+_XML_DECLARATIONS = re.compile(rb"<!\s*(?:DOCTYPE|ENTITY)", re.I)
+
+
+def _template_census(data, document, file_type):
+    """The frozen v2 census, when it is complete and undated: the census, keyed by source row, or None."""
+    template = document["template"]
+    if (not isinstance(data, bytes) or not 0 < len(data) <= 1024 * 1024
+            or template.get("schema_version") != "irpt-template.v2" or template.get("file_type") != file_type
+            or template.get("content_sha256") != hashlib.sha256(data).hexdigest()
+            or template.get("findings") or document.get("findings") or document.get("prices")
+            or document.get("options", {}).get("price_date") is not None
+            or any(row.get("price") is not None for row in document["rows"]) or not template["rows"]):
+        return None
+    headers = template["headers"]
+    a1, b1 = headers["A"]["text"].strip().lower(), headers["B"]["text"].strip().lower()
+    if a1 not in _TEMPLATE_SYMBOL_HEADERS or _TEMPLATE_UNDATED_BASES.get(b1) != template.get("basis"):
+        return None
+    census = {1: (headers["A"], headers["B"])}
+    census.update({row["row"]: (row["cells"]["A"], row["cells"]["B"]) for row in template["rows"]})
+    if any(c["formula"] or c["invalid"] for cells in census.values() for c in cells):
+        return None
+    return census
+
+
+def _undated_template_csv(data, document):
+    """The v2 two-column CSV template, proved cell by cell against its frozen census.
+
+    The reader keeps only columns A and B, so the RAW file is re-read here. Every row must
+    be exactly two cells (a date in a third column would otherwise vanish unseen), and every
+    non-blank row must be the census's own cells.
+    """
+    try:
+        census = _template_census(data, document, "csv")
+        if census is None:
+            return False
+        seen = set()
+        for number, values in enumerate(csv.reader(io.StringIO(data.decode("utf-8-sig"), newline=""), strict=True), 1):
+            if not values or values == ["", ""]:
+                continue
+            cells = census.get(number)
+            if len(values) != 2 or cells is None or any(c["text"] != v for c, v in zip(cells, values)):
+                return False
+            seen.add(number)
+        return seen == set(census)
+    except (ValueError, KeyError, TypeError, IndexError, AttributeError, UnicodeError, csv.Error):
+        return False
+
+
+def _undated_template_xlsx(data, document):
+    """The v2 XLSX template: ONE worksheet, and no cell outside columns A and B.
+
+    The reader reads one sheet's A/B cells and skips the rest unseen, so the raw workbook is
+    re-read for what it skips: a second sheet or a third column is not proved undated. The
+    A/B texts are the census's own (it was read from these bytes, bound by digest); the set
+    of rows holding a value must be exactly the census rows.
+    """
+    try:
+        census = _template_census(data, document, "xlsx")
+        if census is None:
+            return False
+        with zipfile.ZipFile(io.BytesIO(data)) as archive:
+            infos = archive.infolist()
+            names = [i.filename for i in infos]
+            sheets = [n for n in names if re.fullmatch(r"xl/worksheets/[^/]+\.xml", n)]
+            if (len(names) != len(set(names)) or sum(i.file_size for i in infos) > 8 * 1024 * 1024
+                    or any(i.flag_bits & 1 for i in infos) or len(sheets) != 1):
+                return False
+            workbook, sheet = archive.read("xl/workbook.xml"), archive.read(sheets[0])
+        if (_XML_DECLARATIONS.search(workbook) or _XML_DECLARATIONS.search(sheet)
+                or len(ElementTree.fromstring(workbook).findall(_SHEET_NS + "sheets/" + _SHEET_NS + "sheet")) != 1):
+            return False
+        valued = set()
+        for cell in ElementTree.fromstring(sheet).iter(_SHEET_NS + "c"):
+            address = re.fullmatch(r"([A-Z]+)([1-9][0-9]*)", cell.get("r", ""))
+            if not address or address[1] not in ("A", "B"):
+                return False
+            if cell.find(_SHEET_NS + "v") is not None or cell.find(_SHEET_NS + "is") is not None:
+                valued.add(int(address[2]))
+        return valued == set(census)
+    except (ValueError, KeyError, TypeError, IndexError, AttributeError, zipfile.BadZipFile, ElementTree.ParseError,
+            RuntimeError, NotImplementedError, OSError):
+        return False

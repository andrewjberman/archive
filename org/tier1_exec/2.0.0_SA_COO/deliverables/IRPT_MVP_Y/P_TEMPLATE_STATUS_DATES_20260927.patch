+@pytest.mark.parametrize("change", ["third_column", "extra_row", "cell_text", "shares", "findings", "xlsx",
+                                    "digest", "price", "price_date", "no_rows"])
+def test_template_csv_proof_refuses_anything_it_cannot_see_whole(change):
+    import hashlib
+    from prospect_dates import _undated_template_csv
+    raw, document = TEMPLATE_RAW, template_document()
+    if change == "third_column":  # a date the two-column reader would drop unseen
+        raw = b"Ticker,Dollars,As Of\nAAPL,10.01,2026-09-25\nVNQ,2.02,2026-09-25\n"
+        document["template"]["content_sha256"] = hashlib.sha256(raw).hexdigest()
+    elif change == "extra_row":
+        raw = TEMPLATE_RAW + b"MSFT,1.00\n"
+        document["template"]["content_sha256"] = hashlib.sha256(raw).hexdigest()
+    elif change == "cell_text":
+        document["template"]["rows"][1]["cells"]["B"]["text"] = "2.03"
+    elif change == "shares":
+        document = template_document(header_b="Shares", basis="SHARES")
+    elif change == "findings":
+        document["template"]["findings"] = [{"code": "UNIT_UNRECOGNIZED"}]
+    elif change == "xlsx":
+        document = template_document(file_type="xlsx")
+    elif change == "digest":
+        raw = raw.replace(b"\n", b"\r\n")
+    elif change == "price":
+        document["rows"][0]["price"] = {"value": "1", "date": "2026-09-25"}
+    elif change == "price_date":
+        document["options"]["price_date"] = "2026-09-25"
+    elif change == "no_rows":
+        raw = b"Ticker,Dollars\n"

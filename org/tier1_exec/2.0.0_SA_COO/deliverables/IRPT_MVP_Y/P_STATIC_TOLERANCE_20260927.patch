+def tolerance_requires_static(pdf_bytes, name):
+    """A tolerated setting (recipe.READ_BACK_TOLERATED) holds only on a Static portfolio (CTO 101971).
+
+    The saved portfolio carries no type on record, so the type is the one the vendor PRINTED for
+    this portfolio's own row. Checked before the PDF is retained: a refusal here leaves no PDF
+    checkpoint for a redelivery to publish from."""
+    printed = extract.calculation_settings(pdf_bytes, name) or {}
+    kind, as_of = printed.get("type"), printed.get("as_of")
+    print("IRPT_RESIDENT_TOLERANCE_TYPE type=%s as_of=%s" % (
+        kind if kind in extract.PORTFOLIO_TYPES else "-",
+        as_of.replace(" ", "_") if as_of in extract.AS_OF_OPTIONS else "-"), flush=True)
+    if kind != "Static":
+        raise WorkerAttention("TOLERANCE_REQUIRES_STATIC")
+

+# ---------------------------------------------------------------- the printed calculation settings
+# The vendor's own vocabulary for the 'As Of' column, from the methodology note printed beside the
+# table ("The As of setting determines which allocation snapshot is applied throughout the
+# historical performance calculation"). A Static portfolio is "a fixed set of holdings and weights
+# as of its creation date", so it has one allocation snapshot whatever As Of says (CTO 101971).
+SETTINGS_TABLE = "Performance Calculation Settings"
+AS_OF_OPTIONS = ("Initial", "Custom", "Latest Rebalance", "Last Close")
+PORTFOLIO_TYPES = ("Static", "Dynamic")
+_SETTINGS_ROW = re.compile(r"[A-Z][a-z]{2,8}\.? \d{1,2}, \d{4} (%s) .+? (%s)"
+                           % ("|".join(PORTFOLIO_TYPES), "|".join(AS_OF_OPTIONS)))
+
+
+def settings_row(text, name):
+    """The row `name` has in the page text's settings table, as {"type", "as_of"}; None if absent or ambiguous.
+
+    Selected by the portfolio's own name, never by position: a comparison report prints the
+    comparison models' Dynamic rows beside it, and the Fee Assumptions table repeats the name.
+    """
+    at = text.find(SETTINGS_TABLE)
+    if at < 0:
+        return None
+    rows = []
+    for line in text[at:].splitlines():
+        if line.startswith(name + " "):
+            match = _SETTINGS_ROW.fullmatch(line[len(name) + 1:].strip())
+            if match:
+                rows.append({"type": match.group(1), "as_of": match.group(2)})
+    return rows[0] if len(rows) == 1 else None
+
+
+def calculation_settings(pdf_bytes, name):
+    """The Type and As Of the vendor PRINTED for portfolio `name`, or None; the saved portfolio has no type on record."""
+    import io as _io
+    pdfplumber = _plumber()
+    found = []
+    with pdfplumber.open(_io.BytesIO(pdf_bytes)) as pdf:
+        for page in pdf.pages:
+            row = settings_row(page.extract_text() or "", name)
+            if row:
+                found.append(row)
+    return found[0] if len(found) == 1 else None
+
+

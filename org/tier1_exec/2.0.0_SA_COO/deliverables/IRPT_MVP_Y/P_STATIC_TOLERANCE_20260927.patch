+"""The Type and As Of the vendor prints for one portfolio (CTO 101971: a tolerated setting holds only on Static).
+
+The table lines are pdfplumber's text of the real PDFs, verbatim: window 15's Overview (RPT-5288c06d, sha256 6e753361..)
+and the research-era overview/comparison/multicomp (opal-data-ycharts research/20260911, overview sha256 abab2ffe..).
+"""
+from pathlib import Path
+import sys
+
+import fitz
+
+HERE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HERE))
+import extract  # noqa: E402
+
+W15 = "IRPT REQ-67e12718b0ba7c0c70ebb45b r1 3f4a32561f5c"
+RESEARCH = "IRPT-5c25486fd34e29cdddebbf43"
+HEADER = ["Performance Calculation Settings Data as of: June 30, 2026", "Rebalance",
+          "Name Inception Date Type Frequency Start As Of"]
+FEES = ["Fee Assumptions Data as of: June 30, 2026", "Advisory Advisory", "Fee Fee Max Fee Max Fee",
+        "Name (Annualized) Frequency (Annualized) Frequency"]
+WINDOW_15 = "\n".join(HEADER + [W15 + " Jan. 2, 1990 Static Quarterly Earliest Custom"]
+                      + FEES + [W15 + " 0.30% Annually -- --"])
+MULTICOMP = "\n".join(HEADER + [RESEARCH + " Jan. 29, 1993 Static Quarterly Earliest Custom",
+                                "Opal Short-Term Jan. 1, 2024 Dynamic Never Earliest Initial",
+                                "Opal Intermediate-Term Jan. 1, 2024 Dynamic Never Earliest Initial"])
+
+
+def test_the_portfolios_own_row_not_the_fee_row_that_repeats_its_name():
+    assert extract.settings_row(WINDOW_15, W15) == {"type": "Static", "as_of": "Custom"}
+
+
+def test_a_comparison_reports_dynamic_rows_are_selected_only_by_their_own_names():
+    assert extract.settings_row(MULTICOMP, RESEARCH) == {"type": "Static", "as_of": "Custom"}
+    assert extract.settings_row(MULTICOMP, "Opal Intermediate-Term") == {"type": "Dynamic", "as_of": "Initial"}
+
+
+def test_absent_truncated_or_ambiguous_is_none():
+    assert extract.settings_row("\n".join(FEES + [W15 + " 0.30% Annually -- --"]), W15) is None
+    assert extract.settings_row(WINDOW_15, W15.rsplit(" ", 1)[0]) is None
+    assert extract.settings_row(WINDOW_15, RESEARCH) is None
+    doubled = WINDOW_15 + "\n" + W15 + " Jan. 2, 1990 Dynamic Quarterly Earliest Custom"
+    assert extract.settings_row(doubled, W15) is None
+
+
+def test_every_as_of_option_the_vendor_names_including_two_word_ones():
+    for as_of in extract.AS_OF_OPTIONS:
+        text = "\n".join(HEADER + [W15 + " Jan. 2, 1990 Static Quarterly First Common " + as_of])
+        assert extract.settings_row(text, W15) == {"type": "Static", "as_of": as_of}
+
+
+def pdf(lines):
+    doc = fitz.open()
+    page = doc.new_page(width=900, height=400)
+    for i, line in enumerate(lines):
+        page.insert_text((20, 30 + 14 * i), line, fontsize=8)
+    data = doc.tobytes()
+    doc.close()
+    return data
+
+
+def test_read_from_pdf_bytes_and_the_committed_synthetic_overview_prints_no_table_row():
+    assert extract.calculation_settings(pdf(WINDOW_15.splitlines()), W15) == {"type": "Static", "as_of": "Custom"}
+    synthetic = (HERE / "fixtures/synthetic_pdf/overview.pdf").read_bytes()
+    assert extract.calculation_settings(synthetic, W15) is None

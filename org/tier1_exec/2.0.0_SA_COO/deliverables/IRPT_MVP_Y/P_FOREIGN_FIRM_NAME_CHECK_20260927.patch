+# Another firm's name on a client's report is the cross-firm data rule on the product's own output (CTO 102151).
+# No firm is typed here (CLAUDE.md rule 30): each client firm's printed names come from the LGIC registry through
+# lib/opal_naming.py -- its tenant display name and the aliases the registry records on the "prose" plane. They are
+# matched case-sensitively and never inside a longer token: our own portfolio names carry lowercase hex (REQ-<hex>).
+def _naming():
+    try:
+        import opal_naming
+    except ImportError:  # the installed runtimes put lib/ on sys.path; a source checkout finds it among the ancestors
+        import sys
+        from pathlib import Path
+        for parent in Path(__file__).resolve().parents:
+            if (parent / "lib" / "opal_naming.py").is_file():
+                sys.path.insert(0, str(parent / "lib"))
+                break
+        import opal_naming
+    return opal_naming
+
+
+def printed_firm_names():
+    """{firm scope key: pattern of its printed names} for every client firm the registry declares."""
+    patterns = {}
+    for scope in _naming().load_registry()["scopes"]["scopes"]:
+        tenant = scope.get("tenant") or {}
+        if scope.get("class") != "FIRM" or tenant.get("kind") != "client" or not tenant.get("display_name"):
+            continue
+        printed = {tenant["display_name"]} | {alias["spelling"] for alias in scope.get("aliases", [])
+                                              if "prose" in alias.get("planes", [])}
+        patterns[scope["key"]] = re.compile("|".join(r"(?<![0-9A-Za-z])%s(?![0-9A-Za-z])" % re.escape(name)
+                                                     for name in sorted(printed)))
+    return patterns
+
+
+def foreign_firm_names(pdf_bytes, firm):
+    """Every OTHER registered firm whose printed name appears in the PDF's extracted text, as sorted scope keys."""
+    import io as _io
+    try:
+        own = _naming().lookup(firm)["key"]
+    except KeyError:
+        raise PublicationRefused("REPORT_FIRM_UNREGISTERED") from None
+    markers = {other: pattern for other, pattern in printed_firm_names().items() if other != own}
+    if not markers:
+        return []
+    found = set()
+    with extract._plumber().open(_io.BytesIO(pdf_bytes)) as pdf:
+        for page in pdf.pages:
+            text = page.extract_text() or ""
+            found |= {other for other, pattern in markers.items() if pattern.search(text)}
+    return sorted(found)
+
+
 def build_publication(pdf_bytes, census, *, specimen_label, specimen_id):
     """Invoke the actual extractor and independent certifier on original bytes."""
     result = extract.extract(pdf_bytes, census, specimen_label=specimen_label,

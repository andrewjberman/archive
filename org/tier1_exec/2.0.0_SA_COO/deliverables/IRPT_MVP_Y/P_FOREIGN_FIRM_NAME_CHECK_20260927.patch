+@pytest.mark.parametrize("foreign", [False, True])
+def test_another_firms_name_on_the_vendor_pdf_fails_publication(world, monkeypatch, foreign):
+    """CTO 102151, through the real publisher: the retained vendor PDF's own text against the registry's firms.
+    The test world's own printed names read READY; another registered client firm's display name refuses."""
+    import fitz
+    import publication
+    from publication import PublicationRefused
+    r = installed(world, monkeypatch)
+    naming = publication._naming()
+    own = naming.lookup(r.store.tenant)
+    other = next(s for s in naming.load_registry()["scopes"]["scopes"] if s.get("class") == "FIRM"
+                 and (s.get("tenant") or {}).get("kind") == "client" and s["key"] != own["key"])
+    printed = ("Prepared by " + other["tenant"]["display_name"]) if foreign else (
+        "Prepared by " + own["tenant"]["display_name"])
+    original = publication_support.source.pdf
+
+    def printed_pdf():
+        doc = fitz.open(stream=original(), filetype="pdf")
+        doc.new_page().insert_text((40, 60), printed)
+        data = doc.tobytes()
+        doc.close()
+        return data
+    monkeypatch.setattr(publication_support.source, "pdf", printed_pdf)
+    r = installed(world, monkeypatch)
+    if not foreign:
+        assert r.assembly.execute(r.message, lambda: None)["state"] == "READY"
+        return
+    with pytest.raises(PublicationRefused, match="FOREIGN_FIRM_NAME_IN_REPORT"):
+        r.assembly.execute(r.message, lambda: None)
+    assert r.row["state"]["S"] != "READY" and not r.transactions and len(r.downloads) == 1

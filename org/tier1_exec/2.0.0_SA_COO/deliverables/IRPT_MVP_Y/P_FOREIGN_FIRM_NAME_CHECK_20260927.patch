+@pytest.mark.parametrize("printed, foreign", [
+    ("Benchmark: 49F Long Term Benchmark", False),  # the test world IS 49financial: its own name is never foreign
+    ("Prepared by Cottonwood Wealth", True)])       # another firm's printed name on this firm's report
+def test_another_firms_name_on_the_vendor_pdf_fails_publication(world, monkeypatch, printed, foreign):
+    """CTO 102151, through the real publisher: the retained vendor PDF's own text, the report's own firm."""
+    import re
+    import fitz
+    import publication
+    from publication import PublicationRefused
+    monkeypatch.setitem(publication.FIRM_NAME_MARKERS, "cottonwood", re.compile(r"Cottonwood Wealth"))
+    original = publication_support.source.pdf
+
+    def printed_pdf():
+        doc = fitz.open(stream=original(), filetype="pdf")
+        doc.new_page().insert_text((40, 60), printed)
+        data = doc.tobytes()
+        doc.close()
+        return data
+    monkeypatch.setattr(publication_support.source, "pdf", printed_pdf)
+    r = installed(world, monkeypatch)
+    assert r.store.tenant == "49financial"
+    if not foreign:
+        assert r.assembly.execute(r.message, lambda: None)["state"] == "READY"
+        return
+    with pytest.raises(PublicationRefused, match="FOREIGN_FIRM_NAME_IN_REPORT"):
+        r.assembly.execute(r.message, lambda: None)
+    assert r.row["state"]["S"] != "READY" and not r.transactions and len(r.downloads) == 1

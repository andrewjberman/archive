@@ -0,0 +1,40 @@
+"""CTO 102151: a report whose firm is not 49financial fails certification if its text carries "49F" or "49 Financial"."""
+from pathlib import Path
+import sys
+
+import fitz
+import pytest
+
+HERE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HERE))
+import publication  # noqa: E402
+
+
+def pdf(*lines):
+    doc = fitz.open()
+    page = doc.new_page(width=700, height=300)
+    for i, line in enumerate(lines):
+        page.insert_text((20, 30 + 14 * i), line, fontsize=9)
+    data = doc.tobytes()
+    doc.close()
+    return data
+
+
+@pytest.mark.parametrize("line", ["Benchmark: 49F Long Term Benchmark", "Prepared with 49 Financial", "(49F)"])
+def test_another_firms_name_is_found_on_a_non_49financial_report(line):
+    data = pdf("Portfolio Overview", line)
+    assert publication.foreign_firm_names(data, "cottonwood") == ["49financial"]
+    assert publication.foreign_firm_names(data, "inflection") == ["49financial"]
+
+
+def test_a_firms_own_name_is_never_foreign():
+    assert publication.foreign_firm_names(pdf("49F Long Term Benchmark"), "49financial") == []
+
+
+@pytest.mark.parametrize("line", [
+    "IRPT REQ-67e12718b0ba7c0c70ebb49f r1 3f4a3256149f",  # our own portfolio names are lowercase hex
+    "Security A49F0 and 149F and 49Fx",                    # 49F inside a longer token
+    "49 financial planning"])                               # the firm's name is matched as printed
+def test_hex_ids_and_longer_tokens_never_trip_it(line):
+    assert publication.foreign_firm_names(pdf(line), "cottonwood") == []
+

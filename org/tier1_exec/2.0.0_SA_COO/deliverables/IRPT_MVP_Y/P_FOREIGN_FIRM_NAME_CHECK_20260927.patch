@@ -0,0 +1,77 @@
+"""CTO 102151: a client firm's report fails certification if its text carries another registered firm's printed name.
+
+The firms and their printed names are read from the LGIC registry through lib/opal_naming.py; none is typed here.
+"""
+from pathlib import Path
+import sys
+
+import fitz
+import pytest
+
+HERE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HERE))
+import publication  # noqa: E402
+
+NAMING = publication._naming()
+CLIENTS = [s for s in NAMING.load_registry()["scopes"]["scopes"]
+           if s.get("class") == "FIRM" and (s.get("tenant") or {}).get("kind") == "client"]
+# The firm whose registry row carries a "prose" alias (window 18's benchmark finding), and two others.
+PROSE = next(s for s in CLIENTS if any("prose" in a.get("planes", []) for a in s.get("aliases", [])))
+OTHERS = [s for s in CLIENTS if s["key"] != PROSE["key"]]
+PROSE_ALIAS = next(a["spelling"] for a in PROSE["aliases"] if "prose" in a.get("planes", []))
+
+
+def pdf(*lines):
+    doc = fitz.open()
+    page = doc.new_page(width=700, height=300)
+    for i, line in enumerate(lines):
+        page.insert_text((20, 30 + 14 * i), line, fontsize=9)
+    data = doc.tobytes()
+    doc.close()
+    return data
+
+
+def test_the_registry_declares_the_firms_this_check_reads():
+    assert len(CLIENTS) >= 3 and len(OTHERS) >= 2
+    assert set(publication.printed_firm_names()) == {s["key"] for s in CLIENTS}
+
+
+@pytest.mark.parametrize("form", ["prose_alias", "display_name", "parenthesised"])
+def test_another_firms_printed_name_is_found_on_each_other_firms_report(form):
+    line = {"prose_alias": "Benchmark: %s Long Term Benchmark" % PROSE_ALIAS,
+            "display_name": "Prepared with %s" % PROSE["tenant"]["display_name"],
+            "parenthesised": "(%s)" % PROSE_ALIAS}[form]
+    data = pdf("Portfolio Overview", line)
+    for other in OTHERS:
+        assert publication.foreign_firm_names(data, other["key"]) == [PROSE["key"]]
+
+
+def test_a_firms_own_names_and_its_test_tenant_are_never_foreign():
+    data = pdf("%s Long Term Benchmark" % PROSE_ALIAS, PROSE["tenant"]["display_name"])
+    assert publication.foreign_firm_names(data, PROSE["key"]) == []
+    tenants = [a["spelling"] for a in PROSE.get("aliases", []) if a.get("tenant")]
+    for tenant in tenants:  # a firm's test tenant resolves to the firm itself
+        assert publication.foreign_firm_names(data, tenant) == []
+
+
+def test_every_other_registered_firms_display_name_is_caught_too():
+    first = OTHERS[0]
+    data = pdf("Report for %s" % OTHERS[1]["tenant"]["display_name"])
+    assert publication.foreign_firm_names(data, first["key"]) == [OTHERS[1]["key"]]
+
+
+@pytest.mark.parametrize("line", [
+    "IRPT REQ-67e12718b0ba7c0c70ebb49f r1 3f4a3256149f",  # our own portfolio names are lowercase hex
+    "Security A%s0 and 1%s and %sx",                        # the alias inside a longer token
+    "WORDS"])                                               # a firm's bare key as an ordinary word is not its name
+def test_hex_ids_longer_tokens_and_ordinary_words_never_trip_it(line):
+    if line == "WORDS":
+        text = "an %s point and %s trees" % (OTHERS[0]["key"], OTHERS[1]["key"])
+    else:
+        text = line % (PROSE_ALIAS, PROSE_ALIAS, PROSE_ALIAS) if "%s" in line else line
+    assert publication.foreign_firm_names(pdf(text), OTHERS[0]["key"]) == []
+
+
+def test_an_unregistered_report_firm_is_refused_not_guessed():
+    with pytest.raises(publication.PublicationRefused, match="REPORT_FIRM_UNREGISTERED"):
+        publication.foreign_firm_names(pdf("x"), "not-a-registered-firm")

+def refusal_line(result):
+    """A refused vendor step as closed tokens for the host journal: the step, the HTTP status, the
+    portfolio status and the drifted SETTING names (keys of recipe.SETTING_TO_VENDOR_FIELD only).
+    Never a value, a body or a URL, so the journal can say why without holding vendor data."""
+    def token(value):
+        return value if isinstance(value, str) and _TOKEN.fullmatch(value) else "-"
+    status = result.get("status")
+    drifted = [name for name in result.get("drifted") or [] if name in recipe.SETTING_TO_VENDOR_FIELD]
+    polls = result.get("polls")
+    return "IRPT_RESIDENT_STEP_REFUSED step=%s status=%s portfolio_status=%s polls=%s drifted=%s" % (
+        token(result.get("step")), status if type(status) is int else "-",
+        token(result.get("portfolio_status")), polls if type(polls) is int else "-",
+        ",".join(drifted) or "-")

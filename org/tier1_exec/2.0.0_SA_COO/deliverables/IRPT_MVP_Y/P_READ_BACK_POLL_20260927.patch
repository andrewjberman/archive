diff --git a/infra/aws/lambda/investor-reporting/ycharts/generate/tests/test_read_back_poll.py b/infra/aws/lambda/investor-reporting/ycharts/generate/tests/test_read_back_poll.py
new file mode 100644
index 0000000000..768b2a8c19
--- /dev/null
+++ b/infra/aws/lambda/investor-reporting/ycharts/generate/tests/test_read_back_poll.py
@@ -0,0 +1,68 @@
+"""The settings read-back waits for an AVAILABLE portfolio (window 7: read once while `calculating`, 7/7 refused)."""
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).parents[1]))
+sys.path.insert(0, str(Path(__file__).parents[2] / "session"))
+import recipe  # noqa: E402
+import resident_worker  # noqa: E402
+
+FIX = Path(__file__).parents[1] / "fixtures" / "har"
+AVAILABLE = json.loads((FIX / "status_ok.json").read_text(encoding="utf-8"))["body"]
+DRIFTED = json.loads((FIX / "status_drifted.json").read_text(encoding="utf-8"))["body"]
+CALCULATING = {"status": "calculating"}
+
+
+class Replay:
+    def __init__(self, *answers):
+        self.answers, self.calls = list(answers), 0
+
+    def request(self, path, method="GET", payload=None, content_type=None):
+        assert path == "/model_portfolios/2363504/status" and method == "GET"
+        status, body = self.answers[min(self.calls, len(self.answers) - 1)]
+        self.calls += 1
+        return {"status": status}, json.dumps(body).encode()
+
+
+def read_back(transport, **kw):
+    waits = []
+    result = recipe.step_read_back(transport, 2363504, recipe.load_settings(), wait=waits.append, **kw)
+    return result, waits
+
+
+def test_calculating_then_available_compares_the_available_response():
+    t = Replay((200, CALCULATING), (202, CALCULATING), (200, CALCULATING), (200, AVAILABLE))
+    result, waits = read_back(t)
+    assert result["ok"] is True and result["matched"] == result["denominator"] == 7
+    assert result["polls"] == 4 and t.calls == 4 and waits == [recipe.READ_BACK_SPACING_S] * 3
+    assert result["portfolio_status"] == "available"
+
+
+def test_never_available_is_refused_with_its_status_named_after_the_bound():
+    t = Replay((200, CALCULATING))
+    result, waits = read_back(t, polls=5)
+    assert result["ok"] is False and result["polls"] == 5 and t.calls == 5 and len(waits) == 4
+    assert result["portfolio_status"] == "calculating" and len(result["drifted"]) == 7
+
+
+def test_an_eviction_is_returned_at_once_for_the_callers_refresh_rule():
+    t = Replay((403, {"detail": "Your session ended because of a concurrent sign in."}), (200, AVAILABLE))
+    result, waits = read_back(t)
+    assert result["ok"] is False and result["status"] == 403 and t.calls == 1 and waits == []
+
+
+def test_available_but_drifted_is_refused_on_the_first_read():
+    result, waits = read_back(Replay((200, DRIFTED)))
+    assert result["ok"] is False and result["polls"] == 1 and waits == []
+    assert result["drifted"] == ["management_fee"]
+
+
+def test_refusal_line_carries_closed_tokens_only():
+    line = resident_worker.refusal_line({"step": "read_back", "status": 200, "portfolio_status": "calculating",
+                                         "polls": 12, "drifted": ["management_fee", "https://x?sig=1"]})
+    assert line == ("IRPT_RESIDENT_STEP_REFUSED step=read_back status=200 portfolio_status=calculating "
+                    "polls=12 drifted=management_fee")
+    leaky = resident_worker.refusal_line({"step": "Read Back <x>", "status": "200", "portfolio_status": "a b@c",
+                                          "drifted": None})
+    assert leaky == "IRPT_RESIDENT_STEP_REFUSED step=- status=- portfolio_status=- polls=- drifted=-"

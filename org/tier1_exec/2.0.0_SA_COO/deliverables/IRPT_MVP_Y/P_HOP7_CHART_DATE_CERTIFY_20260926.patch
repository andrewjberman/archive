+def chart_page_pdf(*dates, beside=True):
+    """A dated scalar page, then a chart page printing each date BELOW its title, as a vendor
+    chart page does (the retained real Overview's page 8: one 'Data as of' line under the title).
+    A second date goes beside the first on the same text row, or on a row further down."""
+    doc = fitz.open()
+    page = doc.new_page()
+    page.insert_text((40, 40), "Data as of: Sep. 22, 2026")
+    page.insert_text((40, 80), "Return")
+    page.insert_text((300, 80), "10.30%")
+    page = doc.new_page()
+    page.insert_text((40, 50), "Growth of Wealth")
+    for i, date in enumerate(dates):
+        page.insert_text((40 + 200 * i, 70) if beside else (40, 70 + 150 * i), "Data as of: " + date)
+    page.insert_text((40, 300), "All investments")
+    page.insert_text((40, 315), "carry risk.")
+    data = doc.tobytes()
+    doc.close()
+    return data
+
+
+def chart_row(data):
+    [row] = extracted(data)["charts"]
+    return publication._chart(row, extract.read_pages(data))
+
+
+def test_chart_page_with_one_date_publishes_that_date_as_section():
+    data = chart_page_pdf("Aug. 31, 2026")
+    chart = chart_row(data)
+    assert chart["date_claim"] == "SECTION" and chart["as_of_date"] == "2026-08-31"
+    graded = certify.certify([chart], data, census=census())
+    assert graded["rows"][0]["verdict"] == certify.PASS, graded["rows"][0]["detail"]
+    build(data)
+
+
+@pytest.mark.parametrize("beside", [True, False])
+def test_chart_section_date_refused_when_its_page_prints_another_date(beside):
+    chart = chart_row(chart_page_pdf("Aug. 31, 2026"))
+    other = chart_page_pdf("Aug. 31, 2026", "Sep. 22, 2026", beside=beside)
+    graded = certify.certify([chart], other, census=census())
+    assert graded["rows"][0]["verdict"] == certify.FAIL_DATE_NEIGHBOUR
+    assert "2026-09-22" in graded["rows"][0]["detail"]
+
+

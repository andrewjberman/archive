+def _page_dates(page, *, tol=1.5):
+    """Every 'Data as of' date the page prints, EACH occurrence: two blocks side by side share a
+    text row, and reading one date per row would let the second hide behind the first."""
+    rows = {}
+    for word in page.extract_words(use_text_flow=False, keep_blank_chars=False):
+        rows.setdefault(round(float(word["top"]) / tol) * tol, []).append(word)
+    found = []
+    for words in rows.values():
+        text = " ".join(w["text"] for w in sorted(words, key=lambda w: float(w["x0"])))
+        top = min(float(w["top"]) for w in words)
+        found.extend((top, parse_as_of(m.group(0))) for m in DATE_LINE_ANY.finditer(text))
+    return sorted(found, key=lambda item: item[0])
+

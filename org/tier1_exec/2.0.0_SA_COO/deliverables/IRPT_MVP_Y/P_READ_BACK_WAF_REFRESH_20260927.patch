+WAF_READ = {'status': 202, 'content_type': 'application/json', 'body': {'status': 'calculating'},
+            'waf_action': 'challenge'}
+
+
+@pytest.mark.parametrize('second_challenge', [False, True])
+def test_waf_challenge_on_the_read_back_spends_the_one_refresh_and_resumes(world, monkeypatch, second_challenge):
+    """CTO 101792: window 8's read-back met YCharts' WAF challenge (a 202 during calculation polling). It
+    spends the job's ONE existing refresh and resumes AT the read-back; a second challenge goes ATTENTION."""
+    r = installed(world, monkeypatch)
+    route = ('GET', '/model_portfolios/2332060/status')
+    valid = r.replay.script[route][0]
+    r.replay.script[route] = [WAF_READ, WAF_READ if second_challenge else valid]
+    captures = []
+    def capture():
+        captures.append(True)
+        r.bundle.update(generation='offline-fresh-session', fence=2)
+    r.assembly.session.capture_workflow = SimpleNamespace(capture=capture)
+    result = r.assembly.execute(r.message, lambda: None)
+    assert captures == [True]
+    assert 'intent_session_refresh' in r.row
+    assert result['state'] == ('ATTENTION' if second_challenge else 'READY')
+    calls = r.replay.sent_headers
+    assert sum(c['route'] == '/model_portfolios/fixed/' and c['method'] == 'POST' for c in calls) == 1
+    assert sum(c['route'].endswith('holdings_upload/client') for c in calls) == 1
+    if second_challenge:
+        assert result['detail']['code'] == 'SESSION_REFRESH_ALREADY_USED'
+        assert not r.downloads
+

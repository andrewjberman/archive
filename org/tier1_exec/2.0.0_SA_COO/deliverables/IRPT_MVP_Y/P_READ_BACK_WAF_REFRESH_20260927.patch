+def waf_read_verdict(observer=None, result=None):
+    """A WAF challenge on a status READ may spend the job's ONE existing refresh (CTO 101792).
+
+    Measured twice: YCharts' WAF challenges calculation polling after a few status GETs (the
+    research run, window 8), and the research recovered with ONE browser re-capture that earned a
+    fresh token, then resumed at the checkpoint. Only the broker's own observation counts; a
+    challenge on a MUTATION stays reconciliation and never refreshes.
+    """
+    if not isinstance(observer, _RecoveryObserver) or not isinstance(result, dict):
+        return None
+    pull = observer.failure_pull(result)
+    if not pull:
+        return None
+    if (pull["action"] != "BROWSER_ATTENTION" or pull["operation"] != "status_poll"
+            or pull["reason"] != "WAF_CHALLENGE"):
+        return None
+    return {**pull, "decision": "REFRESH_ON_WAF_READ"}
+
+

+# A refusal code is a closed token by construction ('CAPTURE_FAILED', 'CAPTURE_FAILED:ChallengeError');
+# any other message may carry a signed URL or customer data and is never printed.
+_CODE = re.compile(r'[A-Z][A-Z0-9_]{2,63}(:[A-Za-z][A-Za-z0-9_]{0,63})?')
+
+
+def retained_reason(exc):
+    """The exception's class, plus its message only when that message is itself a closed code."""
+    code = str(exc)
+    return 'class=%s code=%s' % (type(exc).__name__, code if _CODE.fullmatch(code) else '-')
+
 

@@ -0,0 +1,22 @@
+"""The resident's retained-for-retry line names a closed reason and never an exception's text."""
+from pathlib import Path
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[1]))
+sys.path.insert(0, str(Path(__file__).parents[2] / "session"))
+import resident_main  # noqa: E402
+from operation_lease import OperationRefused  # noqa: E402
+
+
+@pytest.mark.parametrize("exc, reason", [
+    (OperationRefused("CAPTURE_FAILED:ChallengeError"), "class=OperationRefused code=CAPTURE_FAILED:ChallengeError"),
+    (OperationRefused("SESSION_READ_UNAVAILABLE"), "class=OperationRefused code=SESSION_READ_UNAVAILABLE"),
+    (ValueError("INSTALLED_RESIDENT_RUNTIME_REQUIRED"), "class=ValueError code=INSTALLED_RESIDENT_RUNTIME_REQUIRED"),
+    (KeyError("irpt-uiwalk-1790464832@opal.test"), "class=KeyError code=-"),
+    (RuntimeError("GET https://bucket.s3/key?X-Amz-Signature=abc failed"), "class=RuntimeError code=-"),
+    (ValueError(""), "class=ValueError code=-"),
+])
+def test_retained_reason_is_class_plus_closed_code_only(exc, reason):
+    assert resident_main.retained_reason(exc) == reason

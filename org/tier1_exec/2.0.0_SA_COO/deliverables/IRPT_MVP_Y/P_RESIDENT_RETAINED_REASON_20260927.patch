+_FAILURE_CLASS = re.compile(r'[A-Za-z][A-Za-z0-9_]{0,63}')
+
+
+def failure_code(output):
+    """A failed run's reason as a closed token: the runner receipt's failure_class, never its
+    message or record, so the resident can name why a capture failed without a second login."""
+    for line in output.splitlines():
+        if not line.startswith(b'{'):
+            continue
+        try:
+            receipt = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(receipt, dict):
+            continue
+        if receipt.get('ok') is True and (receipt.get('result') or {}).get('authenticated') is not True:
+            return 'CAPTURE_FAILED:NOT_AUTHENTICATED'
+        failure = receipt.get('failure_class')
+        if receipt.get('ok') is False and isinstance(failure, str) and _FAILURE_CLASS.fullmatch(failure):
+            return 'CAPTURE_FAILED:' + failure
+    return 'CAPTURE_FAILED'
+
+

@@ -0,0 +1,42 @@
+"""A prospect submission on a TEMPLATE_UPLOAD input binds exactly as one on a CSV_UPLOAD input.
+
+Both lanes retain their input under uploads.repository_owner (account_ids [] and prospect_input_id = upload id), measured
+on the live window-3 ARTIFACT# rows. Before this fix, submission.input_repository_owner bound only CSV_UPLOAD, and the
+Opal prospect check refused any other lane with EXACT_PROSPECT_OWNER_REQUIRED, in generate and in the resident's replay.
+"""
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "ycharts/generate"))
+import submission  # noqa: E402
+
+OWNER = {"schema_version": "prospect-owner-v1", "firm_id": "cottonwood", "principal_id": "p@opal.test",
+         "principal_class": "OPAL_GLOBAL", "advisor_id": None, "home_firm_id": "opal-capital",
+         "ownership_fingerprint": "f" * 64}
+
+
+def resolved(lane):
+    upload = "UP-" + "a" * 64
+    return {"input_owner": dict(OWNER), "owner": dict(OWNER, account_ids=[], prospect_input_id=upload),
+            "document": {"owner": dict(OWNER), "source": {"lane": lane, "upload_id": upload}}}
+
+
+@pytest.mark.parametrize("lane", ["CSV_UPLOAD", "TEMPLATE_UPLOAD"])
+def test_both_upload_lanes_bind_the_upload_scoped_repository_owner(lane):
+    owner = submission.input_repository_owner(resolved(lane))
+    assert owner["account_ids"] == [] and owner["prospect_input_id"] == "UP-" + "a" * 64
+
+
+def test_a_template_input_still_refuses_a_foreign_upload_binding():
+    case = resolved("TEMPLATE_UPLOAD")
+    case["owner"]["prospect_input_id"] = "UP-" + "b" * 64  # negative control: another upload's scope
+    with pytest.raises(submission.SubmissionRefused, match="ORIGINAL_PROSPECT_INPUT_BINDING"):
+        submission.input_repository_owner(case)
+
+
+def test_an_unknown_lane_is_not_an_upload_lane():
+    assert "CUSTODY" not in submission.PROSPECT_UPLOAD_LANES
+    assert submission.input_repository_owner(resolved("CUSTODY")).get("prospect_input_id") is None

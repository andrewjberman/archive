@@ -0,0 +1,79 @@
+"""capture_title_source: the maintained default report title (CTO 101367) as the resolver's recipe_title_source.
+
+The acceptance predicate is maintained_sources._profile_fields_from_snapshot's (the `title is None` branch), checked
+with that module's own _owner_binding and projection_sha256 so the test cannot drift from the resolver it feeds.
+"""
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[3]
+for child in ("ycharts/generate", "_scope", "_authz", "_ids", "reports", "intake", "ops"):
+    sys.path.insert(0, str(ROOT / child))
+import maintained_sources  # noqa: E402
+import recipe_snapshot  # noqa: E402
+from recipe import RecipeRefused  # noqa: E402
+
+VIEWER = {"firm_id": "49financial", "principal_id": "someone@opal.test", "principal_class": "OPAL_GLOBAL",
+          "advisor_id": True, "home_firm_id": "opal-capital", "ownership_fingerprint": "f" * 64,
+          "schema_version": "prospect-owner-v1"}
+
+
+def body(keys=(), title=None):
+    return {"request_id": "title-test", "client_id": None, "account_ids": [], "snapshot_id": None,
+            "input_id": "portfolio_" + "a" * 64, "variant": "auto", "comparison_keys": list(keys),
+            "report_title": title, "prepared_for": "Recipient"}
+
+
+def accepted_by_resolver(source, recipe_owner, display_scope):
+    """maintained_sources.py (title is None branch): the exact refusal predicate, inverted."""
+    return (isinstance(source, dict) and source.get("source_kind") == "RECIPE_CONFIGURATION"
+            and source.get("binding") == maintained_sources._owner_binding(recipe_owner)
+            and isinstance(source.get("source_scope"), dict)
+            and all(source["source_scope"].get(k) in (None, display_scope[k])
+                    for k in ("firm_id", "principal_id", "advisor_id"))
+            and source.get("projection_sha256") == maintained_sources.projection_sha256(source.get("projection")))
+
+
+@pytest.mark.parametrize("keys,title", [((), "Portfolio Overview"), (("VFIAX",), "Portfolio Comparison"),
+                                        (("VFIAX", "VTSAX"), "Multi-Security Comparison")])
+def test_each_variant_carries_its_ruled_default(keys, title):
+    source = recipe_snapshot.capture_title_source(VIEWER, body(keys))
+    assert source["projection"]["report_title"] == title
+    assert source["projection"]["ruling"] == recipe_snapshot.TITLE_RULING
+    display = {k: VIEWER[k] for k in ("firm_id", "principal_id", "advisor_id")}
+    assert accepted_by_resolver(source, VIEWER, display)
+
+
+def test_binding_carries_the_opal_home_and_a_foreign_actor_is_refused():
+    source = recipe_snapshot.capture_title_source(VIEWER, body())
+    assert source["binding"]["home_firm_id"] == "opal-capital"
+    other = dict(VIEWER, principal_id="another@opal.test")
+    display = {k: other[k] for k in ("firm_id", "principal_id", "advisor_id")}
+    assert not accepted_by_resolver(source, other, display)  # negative control: minted for a different actor
+
+
+def test_a_tampered_projection_is_refused_by_the_resolver_predicate():
+    source = recipe_snapshot.capture_title_source(VIEWER, body())
+    source["projection"]["report_title"] = "Invented"
+    display = {k: VIEWER[k] for k in ("firm_id", "principal_id", "advisor_id")}
+    assert not accepted_by_resolver(source, VIEWER, display)
+
+
+def test_a_row_without_the_maintained_default_refuses(tmp_path):
+    catalogue = json.loads(Path(recipe_snapshot.TEMPLATES_PATH).read_bytes())
+    for row in catalogue["templates"]:
+        row.pop("default_report_title", None)
+    stripped = tmp_path / "templates.json"
+    stripped.write_text(json.dumps(catalogue), encoding="utf-8")
+    with pytest.raises(RecipeRefused, match="MAINTAINED_DEFAULT_TITLE_REQUIRED"):
+        recipe_snapshot.capture_title_source(VIEWER, body(), templates_path=stripped)
+
+
+def test_the_catalogue_names_a_default_for_every_template():
+    catalogue = json.loads(Path(recipe_snapshot.TEMPLATES_PATH).read_bytes())
+    assert {row["variant"]: row["default_report_title"] for row in catalogue["templates"]} == {
+        "OVERVIEW": "Portfolio Overview", "COMPARISON": "Portfolio Comparison",
+        "MULTI": "Multi-Security Comparison"}

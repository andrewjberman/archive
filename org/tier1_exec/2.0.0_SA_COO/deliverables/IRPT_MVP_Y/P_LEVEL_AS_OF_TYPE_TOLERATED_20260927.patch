+def test_a_missing_level_as_of_type_is_absent_and_drifted_not_tolerated():
+    missing = {"portfolio": {k: v for k, v in SETTINGS.items() if k != "level_as_of_type"}, "items": []}
+    result, _ = read_back(Replay((200, AVAILABLE), saved=(200, missing)))
+    assert result["ok"] is False and result["tolerated"] == []
+    assert result["drifted"] == ["level_as_of_type"] and result["absent"] == ["level_as_of_type"]

+def test_level_as_of_type_is_recorded_not_gating_and_a_real_drift_still_refuses():
+    """Window 13: level_as_of_type alone differed on the saved portfolio (we send the advisor UI's prior_close)."""
+    other = {"portfolio": dict(SETTINGS, level_as_of_type="latest"), "items": []}
+    result, _ = read_back(Replay((200, AVAILABLE), saved=(200, other)))
+    assert result["ok"] is True and result["drifted"] == [] and result["tolerated"] == ["level_as_of_type"]
+    done = resident_worker.refusal_line(result, "READ_BACK_DONE")
+    assert "drifted=- absent=- tolerated=level_as_of_type=latest" in done
+    both = {"portfolio": dict(SETTINGS, level_as_of_type="latest", management_fee=0.01), "items": []}
+    result, _ = read_back(Replay((200, AVAILABLE), saved=(200, both)))
+    assert result["ok"] is False and result["drifted"] == ["management_fee"] and result["tolerated"] == ["level_as_of_type"]
+

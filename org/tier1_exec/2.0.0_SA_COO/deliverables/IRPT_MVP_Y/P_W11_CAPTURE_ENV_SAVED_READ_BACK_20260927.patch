+def capture_env(environ=None):
+    """The wrapper's environment: the resident's own, WITHOUT any PYTHON* variable.
+
+    Measured window 11: the resident unit sets PYTHONPATH to its package root, which vendors a
+    urllib3 written for Python 3.10+. The wrapper inherited it, the runner's `aws` CLI (the
+    host's python3.9) imported that urllib3 and crashed, and the runner reported the failed lease
+    call as LEASE_NOT_HELD. The capture is a separate program; it must not see the resident's
+    Python import path.
+    """
+    source = os.environ if environ is None else environ
+    return {k: v for k, v in source.items() if not k.upper().startswith("PYTHON")}
+
+
 def run_capture(wrapper, *, deadline, clock=time.time):
     if os.name != 'posix':
         raise OperationRefused('DEDICATED_LINUX_HOST_REQUIRED')
     remaining = deadline - clock()
     if remaining <= 0:
         raise OperationRefused('CAPTURE_DEADLINE')
-    process = subprocess.Popen(['/bin/bash', str(wrapper)], cwd=str(wrapper.parent),
+    process = subprocess.Popen(['/bin/bash', str(wrapper)], cwd=str(wrapper.parent), env=capture_env(),
         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
         start_new_session=True)
     try:

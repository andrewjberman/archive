+module "stamp_gated_rule_name" {
+  source    = "../modules/opal_name"
+  system    = "etfs"
+  scope     = "cottonwood"
+  function  = "satellites-registry-producer"
+  qualifier = "stamp-gated"
+  kind      = "daily"
+}

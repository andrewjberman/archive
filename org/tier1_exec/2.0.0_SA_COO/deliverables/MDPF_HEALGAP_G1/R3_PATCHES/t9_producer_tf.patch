+  schedule_expression = "cron(15 13 * * ? *)"
+  state               = "ENABLED"
+}
+
+resource "aws_cloudwatch_event_target" "cot_satellites_registry_producer_stamp_gated" {
+  rule      = aws_cloudwatch_event_rule.cot_satellites_registry_producer_stamp_gated.name
+  target_id = "CotSatellitesRegistryProducerStampGated"

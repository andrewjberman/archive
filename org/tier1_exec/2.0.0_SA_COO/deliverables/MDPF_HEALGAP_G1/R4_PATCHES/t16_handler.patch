+def _listed(s3, bucket: str, key: str) -> list:
+    """The listed objects whose Key equals `key` exactly (a sibling that merely starts with it is not it).
+
+    A LISTING and never a head or get: an absent key under a head reads 403 unless the request itself satisfies a
+    ListBucket grant, and an s3:prefix condition is populated on a list request only. An empty result is "absent";
+    AccessDenied raises and stays loud."""
+    got = s3.list_objects_v2(Bucket=bucket, Prefix=key, MaxKeys=1)
+    return [o for o in got.get("Contents", []) if o.get("Key") == key]
+
+
+def _reattempt_skip(event: dict):
+    """HG-t-16: on {"require_partition": true} only, return a skip result or None (None = run the producer).
+
+    Bucket and keys come from the producer module's own constants and the day from its own calendar rule; nothing is
+    typed here. The scheduled fire's event carries no such key, so it makes no S3 call at all."""
+    if not event.get("require_partition"):
+        return None
+    s3 = boto3.client("s3")
+    day = producer.resolve_bbg_as_of()
+    out = _listed(s3, producer.OUT_BUCKET, producer.OUT_KEY)
+    today = datetime.now(timezone.utc).date()
+    if out and out[0]["LastModified"].astimezone(timezone.utc).date() == today:
+        logger.info("SKIP-COMPLETE bbg_as_of=%s: s3://%s/%s was written %s", day, producer.OUT_BUCKET,
+                    producer.OUT_KEY, out[0]["LastModified"])
+        return {"rc": 0, "skipped": "complete", "bbg_as_of": day}
+    missing = [k for k in (producer.BBG_CHARACTERISTICS_KEY % day, producer.BBG_MANIFEST_KEY % day)
+               if not _listed(s3, producer.BBG_BUCKET, k)]
+    if missing:
+        logger.info("PARTITION-ABSENT bbg_as_of=%s: not listed in s3://%s: %s", day, producer.BBG_BUCKET,
+                    ", ".join(missing))
+        return {"rc": 0, "skipped": "partition-absent", "bbg_as_of": day}
+    return None
+

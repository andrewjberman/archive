@@ -55,6 +55,16 @@ def load_digest(date: str) -> dict:
     return json.loads(s3().get_object(Bucket=config.S3_BUCKET, Key=key)["Body"].read())
 
 
+def try_load_digest(date: str) -> dict | None:
+    """The digest dict for `date`, or None when there is no object (a run that never wrote one, or no refill
+    supplement yet). Any other error (AccessDenied, throttle, corrupt) raises: an unreadable digest is never
+    read as an absent one."""
+    try:
+        return load_digest(date)
+    except s3().exceptions.NoSuchKey:
+        return None
+
+
 def put_email(date: str, html: str) -> str:
     key = f"{config.EMAIL_PREFIX}/{date}/digest.html"
     s3().put_object(Bucket=config.S3_BUCKET, Key=key, Body=html.encode(), ContentType="text/html")

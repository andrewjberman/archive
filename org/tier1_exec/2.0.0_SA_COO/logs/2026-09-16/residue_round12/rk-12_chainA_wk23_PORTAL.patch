@@ -0,0 +1,53 @@
+/**
+ * ResearchInputsPanel -- the ONE mount for AMGT-rk-12's three surfaced outcomes.
+ *
+ * WHY THIS EXISTS AS A CONTAINER RATHER THAN THREE MOUNTS IN THE PAGE SHELL. The three
+ * outcomes share one question -- what has this research actually been fed, and when --
+ * and two of the three are UNIVERSE-WIDE while one is PER NAME. Keeping them together
+ * puts that asymmetry in one place: this component owns the security key, hands it to
+ * the per-name surface, and says why the per-name half is empty when no name is chosen,
+ * so no child has to re-derive that state.
+ *
+ * WHY IT IS NOT A SIXTH TAB. C-PAGE-LAYOUT is ratified at ONE HEADER and FIVE TABS
+ * (Thesis, Exec Management, Peers, Model, Posture -- `SECURITY_ANALYSIS_TABS`, the one
+ * declaration). Adding a tab would change a layout Andrew fixed, which is not this
+ * cell's to change. This sits BELOW the tab content instead: it is about the inputs the
+ * whole page rests on, not one more per-name view competing with the five.
+ *
+ * THE THREE CHILDREN, each carrying its own read, its own denominator and its own
+ * refusal reason:
+ *   - CoverageFreshnessPanel -- FWD-7, universe-wide.
+ *   - InputLedgerPanel       -- FWD-12, per name (the key below).
+ *   - ListRegisterPanel      -- FWD-14, per list.
+ *
+ * NOTHING HERE ACTS. No button, no poll, no schedule, no alert. The one acting control
+ * on this page stays where it already is -- the Lead Panel Refresh -- and each child
+ * states, in its own words, what it cannot do and why: a control that cannot act SAYS
+ * WHY (contract C-ROUND12-SURFACED-OUTCOMES).
+ */
+
+import { type FC } from 'react'
+import { CoverageFreshnessPanel } from './CoverageFreshnessPanel'
+import { InputLedgerPanel } from './InputLedgerPanel'
+import { ListRegisterPanel } from './ListRegisterPanel'
+
+export interface ResearchInputsPanelProps {
+  securityKey: string | null
+}
+
+export const ResearchInputsPanel: FC<ResearchInputsPanelProps> = ({ securityKey }) => {
+  return (
+    <div data-research-inputs className="space-y-4">
+      {!securityKey && (
+        <p data-research-inputs-scope="universe-only" className="text-[10px] text-white/40">
+          Two of these three read the whole covered universe and are shown below. The per-name
+          half is not available because no name is selected -- pick one in the Lead Panel and it
+          fills in for that name only.
+        </p>
+      )}
+      <CoverageFreshnessPanel />
+      <InputLedgerPanel securityKey={securityKey} />
+      <ListRegisterPanel />
+    </div>
+  )
+}

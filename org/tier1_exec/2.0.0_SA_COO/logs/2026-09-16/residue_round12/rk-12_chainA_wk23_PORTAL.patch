+/**
+ * ListRegisterPanel -- FWD-14's PAGE SURFACE (AMGT_RESAPP AMGT-rk-12).
+ *
+ * THE MEASURED STATE THIS CELL CORRECTS. FWD-14 -- the register of owned lists with a
+ * rot signal -- was ratified with a Python module as its whole implementation:
+ * `lib/research/lists/rot.py`, whose own docstring calls it "a script a PERSON runs".
+ * Its register was RENDERED only by the FWD-7 coverage view, which was itself unserved,
+ * so the rot signal reached nobody. Measured at the round-12 cut: 0 of the 11 mounted
+ * routes, 0 page components, 0 adapter references, against a positive control that
+ * fired. An outcome whose only implementation is a hand-run module is NOT REALIZED
+ * whatever its rows say.
+ *
+ * THE GRAIN, STATED BECAUSE IT IS THE THING MOST EASILY GOT WRONG. The register carries
+ * a rot signal PER LIST -- the publisher allowlist, the company-to-social-account map --
+ * and has NO company-keyed breakdown at all. So this panel renders lists, never covered
+ * names, and never manufactures a per-name rot value the register does not hold. The
+ * coverage-freshness view beside it repeats ONE summary line of this same register on
+ * every row for exactly that reason.
+ *
+ * WHAT IT RENDERS. One row per owned list: its stale count against its own entries
+ * denominator, whether the list as a whole is stale, its review interval, when it was
+ * last reviewed, its owner and owner status, and its unresolvable count. An owner that
+ * is UNASSIGNED is shown as UNASSIGNED -- C-NO-CONTACT reserves naming the owner to
+ * Andrew, and an unassigned owner is a fact to show, not a blank to hide.
+ *
+ * WHAT IT DOES WHEN IT CANNOT ACT -- contract C-ROUND12-SURFACED-OUTCOMES. The read did
+ * not answer (REFUSED, with the route and the client error); the route answered ABSENT
+ * (the server reason, verbatim); the route answered with zero lists (stated against its
+ * printed denominator, a different fact from either refusal).
+ *
+ * THIS PANEL READS AND HAS NO BUTTON. Recomputing the rot signal is the producer's act,
+ * and marking a list reviewed is an OWNER's act by a person Andrew has not yet named --
+ * so there is nothing here this page is entitled to trigger, and it does not pretend
+ * otherwise. It is also not a watcher: nothing here polls, schedules or alerts.
+ */
+
+import { type FC } from 'react'
+import { Panel, PanelHeader, PanelContent } from '@/ui/components/panels'
+import { useListRegister } from '../hooks/useLeadPanelApi'
+
+export const LIST_REGISTER_ROUTE = '/api/scoped/amgt/lists'
+
+/** The refusal text, in one place. Always begins REFUSED. */
+export function listRegisterRefusalReason(detail: string): string {
+  return (
+    'REFUSED: the list-register read did not answer -- ' +
+    detail +
+    '. This panel shows no lists rather than inventing them. The register and its rot ' +
+    'signal are produced by lib/research/lists/rot.py and served on GET ' +
+    LIST_REGISTER_ROUTE +
+    '; a register that cannot be read is a different fact from a register with nothing stale.'
+  )
+}
+
+export const ListRegisterPanel: FC = () => {
+  const { data, isLoading, isError, error } = useListRegister()
+  const lists = data?.lists ?? []
+  const staleLists = lists.filter((entry) => entry.list_stale).length
+
+  return (
+    <Panel variant="mixed">
+      <PanelHeader
+        title="Owned lists and rot signal"
+        subtitle="FWD-14 -- the register of owned lists, each with its own rot signal; the grain is per list, never per name"
+      />
+      <PanelContent>
+        <div data-surfaced-outcome="rot-signal" className="space-y-2">
+          {isLoading && <p className="text-sm text-white/50">Loading...</p>}
+
+          {!isLoading && isError && (
+            <p data-rot-signal-state="refused" className="text-sm text-amber-300">
+              {listRegisterRefusalReason(
+                (error as Error)?.message ?? 'no error message was carried'
+              )}
+            </p>
+          )}
+
+          {!isLoading && !isError && data && data.register_status === 'ABSENT' && (
+            <p data-rot-signal-state="absent" className="text-sm text-white/70">
+              {data.register_reason ??
+                'not available because the server reported the register ABSENT and carried no reason'}
+            </p>
+          )}
+
+          {!isLoading && !isError && data && data.register_status === 'SERVED' && (
+            <>
+              <div className="overflow-x-auto">
+                <table data-rot-signal-table className="w-full text-[11px]">
+                  <thead>
+                    <tr>
+                      <th className="text-left text-white/50 font-normal pr-2">List</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Rot signal</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Stale entries</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Reviewed</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Interval</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Owner</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Unresolvable</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {lists.map((entry) => (
+                      <tr
+                        key={entry.list_name}
+                        data-rot-signal-list={entry.list_name}
+                        data-rot-signal-stale={entry.list_stale ? 'yes' : 'no'}
+                        className="border-t border-white/5"
+                      >
+                        <td className="pr-2 text-white">{entry.list_name}</td>
+                        <td
+                          className={
+                            entry.list_stale ? 'pr-2 text-amber-300' : 'pr-2 text-emerald-300'
+                          }
+                        >
+                          {entry.list_stale ? 'STALE' : 'not stale'}
+                        </td>
+                        <td className="pr-2 text-white/70 tabular-nums">
+                          {entry.entries_stale} of {entry.entries_total}
+                        </td>
+                        <td className="pr-2 text-white/70 tabular-nums">{entry.reviewed_at}</td>
+                        <td className="pr-2 text-white/60 tabular-nums">
+                          {entry.review_interval_days} day(s)
+                        </td>
+                        <td className="pr-2 text-white/60">{entry.owner_status}</td>
+                        <td className="pr-2 text-white/60 tabular-nums">
+                          {entry.unresolvable_count}
+                        </td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+
+              <p data-rot-signal-counts className="text-[10px] text-white/40">
+                {staleLists} of {lists.length} owned list(s) carry a STALE rot signal. Computed{' '}
+                {data.computed_at ?? 'unstated'}. The register tracks lists, not covered names, so
+                there is no per-name rot value to show here and none is invented.
+              </p>
+
+              {lists.length === 0 && (
+                <p data-rot-signal-state="empty" className="text-sm text-white/70">
+                  The route answered and carried 0 lists against a register denominator of 0. That
+                  is an empty register, not a refusal and not a register with nothing stale.
+                </p>
+              )}
+
+              {lists.some((entry) => entry.owner_status === 'UNASSIGNED') && (
+                <p className="text-[10px] text-white/40">
+                  One or more lists have no named owner. Marking a list reviewed is that
+                  owner&apos;s act, so no control for it is offered here: C-NO-CONTACT reserves
+                  naming the owner to Andrew.
+                </p>
+              )}
+            </>
+          )}
+        </div>
+      </PanelContent>
+    </Panel>
+  )
+}

+/**
+ * CoverageFreshnessPanel -- FWD-7's PAGE SURFACE (AMGT_RESAPP AMGT-rk-12).
+ *
+ * THE MEASURED STATE THIS CELL CORRECTS. FWD-7 -- "Adam can see which covered companies
+ * have gone stale" -- was ratified with a Python module as its whole implementation:
+ * `lib/research/freshness/build_view.py`, whose own docstring calls it "the generator a
+ * person runs by hand", writing a coverage_freshness.json nobody served. Measured at the
+ * round-12 cut: 0 of the 11 mounted routes, 0 page components, 0 adapter references,
+ * against a positive control (peers/v1 = 2) that fired. An outcome whose only
+ * implementation is a hand-run module is NOT REALIZED whatever its rows say.
+ *
+ * WHAT IT RENDERS. One row per name in the covered universe, in the view's own order --
+ * nothing here sorts or re-ranks. `NEVER` is a VALUE, printed as NEVER, never a blank
+ * and never a dropped name: a folder with no research still appears, saying so plainly,
+ * which is the module's own rule carried onto the page. The per-input columns are the
+ * view's own `vendors` list (build_view.py's VENDOR_INPUTS), so a fourth vendor appears
+ * here the moment the producer names it, with no change on this side.
+ *
+ * WHAT IT DOES WHEN IT CANNOT ACT -- contract C-ROUND12-SURFACED-OUTCOMES. There are
+ * THREE distinct empties and this panel never collapses them into one blank table:
+ *   - the read did not answer at all (the route is not mounted yet, or it 4xx/5xx'd):
+ *     REFUSED, with the route and the error the client actually got;
+ *   - the route answered and said the artifact is not there: the server's own
+ *     `view_reason`, printed verbatim;
+ *   - the route answered with a view carrying zero rows: that is stated as zero rows
+ *     against its printed denominator, which is a different fact from either refusal.
+ *
+ * THIS PANEL READS. It has no button, because it has nothing to act on -- the coverage
+ * view is regenerated by its own producer, and the one acting control on this page is
+ * the Lead Panel's Refresh, which enqueues a box-side pull for ONE name.
+ *
+ * The route declaration that mounts the server half is chain B's cell (AMGT-rk-6 AC4),
+ * a separate surface with a separate owner -- the same relationship this page's own
+ * `amgt-lead-panel.ts` already documents for every other call it makes. Until it lands
+ * this panel renders the first state above, which is the honest one.
+ */
+
+import { type FC } from 'react'
+import { Panel, PanelHeader, PanelContent } from '@/ui/components/panels'
+import { useCoverageFreshness } from '../hooks/useLeadPanelApi'
+import type { CoverageFreshnessRow } from '../types'
+
+/** The module's own sentinel, carried rather than re-spelled as a blank. */
+const NEVER = 'NEVER'
+
+export const COVERAGE_FRESHNESS_ROUTE = '/api/scoped/amgt/freshness'
+
+/** The refusal text, in one place so the panel and any exercise of it cannot drift
+ * into two different sentences for one state. Always begins REFUSED. */
+export function freshnessRefusalReason(detail: string): string {
+  return (
+    'REFUSED: the coverage-freshness read did not answer -- ' +
+    detail +
+    '. This panel shows no rows rather than inventing them. The view is produced by ' +
+    'lib/research/freshness/build_view.py and served on GET ' +
+    COVERAGE_FRESHNESS_ROUTE +
+    '; until that route answers there is nothing here to show, and that is a ' +
+    'different fact from a universe with nothing stale.'
+  )
+}
+
+function staleCount(rows: CoverageFreshnessRow[]): number {
+  return rows.filter((row) => row.last_refreshed === NEVER).length
+}
+
+export const CoverageFreshnessPanel: FC = () => {
+  const { data, isLoading, isError, error } = useCoverageFreshness()
+  const rows = data?.rows ?? []
+  const vendors = data?.vendors ?? []
+
+  return (
+    <Panel variant="mixed">
+      <PanelHeader
+        title="Coverage freshness"
+        subtitle="FWD-7 -- which covered names have gone stale, one row per name, NEVER carried as a value"
+      />
+      <PanelContent>
+        <div data-surfaced-outcome="freshness" className="space-y-2">
+          {isLoading && <p className="text-sm text-white/50">Loading...</p>}
+
+          {!isLoading && isError && (
+            <p data-freshness-state="refused" className="text-sm text-amber-300">
+              {freshnessRefusalReason((error as Error)?.message ?? 'no error message was carried')}
+            </p>
+          )}
+
+          {!isLoading && !isError && data && data.view_status === 'ABSENT' && (
+            <p data-freshness-state="absent" className="text-sm text-white/70">
+              {data.view_reason ??
+                'not available because the server reported the view ABSENT and carried no reason'}
+            </p>
+          )}
+
+          {!isLoading && !isError && data && data.view_status === 'SERVED' && (
+            <>
+              <div className="overflow-x-auto">
+                <table data-freshness-table className="w-full text-[11px]">
+                  <thead>
+                    <tr>
+                      <th className="text-left text-white/50 font-normal pr-2">Name</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Key</th>
+                      <th className="text-left text-white/50 font-normal pr-2">Last refreshed</th>
+                      {vendors.map((vendor) => (
+                        <th key={vendor} className="text-left text-white/50 font-normal px-1">
+                          {vendor}
+                        </th>
+                      ))}
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {rows.map((row) => (
+                      <tr key={row.name} className="border-t border-white/5">
+                        <td className="pr-2 text-white">{row.name}</td>
+                        <td className="pr-2 text-white/60">{row.security_key ?? 'UNRESOLVED'}</td>
+                        <td
+                          className={
+                            row.last_refreshed === NEVER
+                              ? 'pr-2 text-amber-300 tabular-nums'
+                              : 'pr-2 text-white/70 tabular-nums'
+                          }
+                        >
+                          {row.last_refreshed}
+                        </td>
+                        {vendors.map((vendor) => (
+                          <td key={vendor} className="px-1 text-white/60 tabular-nums">
+                            {row.per_input?.[vendor] ?? NEVER}
+                          </td>
+                        ))}
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+              <p data-freshness-counts className="text-[10px] text-white/40">
+                {staleCount(rows)} of {rows.length} covered name(s) read NEVER across{' '}
+                {vendors.length} vendor input(s). Generated {data.generated_at ?? 'unstated'}. Rot
+                signal read from {data.rot_signal_path ?? 'no register at this vintage'}.
+              </p>
+              {rows.length === 0 && (
+                <p data-freshness-state="empty" className="text-sm text-white/70">
+                  The route answered and carried 0 rows against a universe denominator of 0. That is
+                  the view being empty, not a refusal and not a universe with nothing stale.
+                </p>
+              )}
+              {rows.length > 0 && <p className="text-[10px] text-white/40">{rows[0].rot}</p>}
+            </>
+          )}
+        </div>
+      </PanelContent>
+    </Panel>
+  )
+}

+/**
+ * InputLedgerPanel -- FWD-12's PAGE SURFACE (AMGT_RESAPP AMGT-rk-12).
+ *
+ * THE MEASURED STATE THIS CELL CORRECTS. FWD-12 -- "an analyst can see where each input
+ * came from and re-run any one alone" -- was ratified with a Python module as its whole
+ * implementation: `lib/research/ledger/ledger.py`, where `rerun()` is a FUNCTION, not a
+ * button. Measured at the round-12 cut: 0 of the 11 mounted routes, 0 page components,
+ * 0 adapter references. An outcome whose only implementation is a hand-run module is NOT
+ * REALIZED whatever its rows say, so FWD-12 gets a served route and this surface.
+ *
+ * THE HALF THAT IS REALIZED HERE, AND THE HALF THAT IS NOT. "SEE WHERE EACH INPUT CAME
+ * FROM" is realized: one row per member of ledger.py's CLOSED class set -- market_data,
+ * filings, news, social, web, sa -- carrying its source label, its latest run stamp and
+ * that run's outcome, with a class that has never run still present and saying so rather
+ * than dropped from the set. "RE-RUN ANY ONE ALONE" is NOT realized this round, and this
+ * panel is READ-ONLY. It says why, in the server view's own words, beside the count that
+ * decides it.
+ *
+ * WHY READ-ONLY IS THE CORRECT SHIP AND NOT A SHORTFALL (ADDENDUM 2 C2, the cell's own
+ * correction; contract C-ROUND12-SURFACED-OUTCOMES: a control that cannot act SAYS WHY):
+ *   - `ledger.py`'s CLASSES carries `stage: None` for 6 of 6 classes at this vintage, by
+ *     design -- "a class registers itself only when a real stage exists to run it, never
+ *     a stub left in production code". `rerun()` raises RuntimeError on a None stage.
+ *     A re-run button over that set would record SKIPPED every time; it would be a
+ *     decoration, and NEVER A BUTTON THAT DOES NOTHING is the ruling.
+ *   - `register_stage()` has no production caller at all (census: 1 caller in 32,971
+ *     files, and it is a worker exercise script binding a stub).
+ *   - The retrofit modules the ledger names carry no callable of the stage shape either:
+ *     `stage_pull(blp, s3, security, pull_log)` needs a live BLPAPI client, and
+ *     `run_ticker(config, session, ...)` a live authenticated vendor session. Neither is
+ *     reachable from a served route: the cloud plane cannot reach Bloomberg at all.
+ *   - AND THE RE-RUN CARRIER ALREADY EXISTS ELSEWHERE, WHICH IS WHY BINDING A STAGE HERE
+ *     WOULD BE THE WRONG MECHANISM. The acting control on this page is the Lead Panel's
+ *     Refresh, which POSTs the on-demand pull route; that enqueues ONE message the
+ *     box-side consumer drains, where the vendor IS reachable. Activation of a per-class
+ *     re-run is round 13's, stated as such rather than shipped as a dead button here.
+ *
+ * WHAT IT DOES WHEN IT CANNOT ACT. Four distinct states, never collapsed: no name
+ * selected (the ledger is per security); the read did not answer (REFUSED, with the
+ * route and the client's own error); the route answered ABSENT (the server's reason,
+ * verbatim); the route answered with the class set and a read-only re-run (the reason
+ * printed beside the bound-stage count that produced it).
+ */
+
+import { type FC } from 'react'
+import { Panel, PanelHeader, PanelContent } from '@/ui/components/panels'
+import { useInputLedger } from '../hooks/useLeadPanelApi'
+import type { InputLedgerClassRow } from '../types'
+
+export const INPUT_LEDGER_ROUTE = '/api/scoped/amgt/security/{security_key}/ledger'
+
+/** The refusal text, in one place. Always begins REFUSED. */
+export function ledgerRefusalReason(detail: string): string {
+  return (
+    'REFUSED: the input-ledger read did not answer -- ' +
+    detail +
+    '. This panel shows no class rows rather than inventing them. The ledger is produced ' +
+    'by lib/research/ledger/ledger.py and served on GET ' +
+    INPUT_LEDGER_ROUTE +
+    '; a name whose ledger cannot be read is a different fact from a name with no runs.'
+  )
+}
+
+/** The read-only reason this page falls back to when the served view carries none. The
+ * server owns this sentence; this is the floor, not the source. */
+export const RERUN_READ_ONLY_FALLBACK =
+  'Re-run is not available because no input class carries a bound stage at this vintage ' +
+  '(ledger.py CLASSES: stage is None for every member), so a re-run would record SKIPPED ' +
+  'every time. The acting control is the Lead Panel Refresh, which enqueues one box-side ' +
+  'pull for this name; per-class activation is round 13.'
+
+function outcomeClass(row: InputLedgerClassRow): string {
+  if (row.outcome === 'FAILED') return 'pr-2 text-rose-300'
+  if (row.outcome === 'SKIPPED') return 'pr-2 text-amber-300'
+  if (row.outcome === 'OK') return 'pr-2 text-emerald-300'
+  return 'pr-2 text-white/40'
+}
+
+export interface InputLedgerPanelProps {
+  securityKey: string | null
+}
+
+export const InputLedgerPanel: FC<InputLedgerPanelProps> = ({ securityKey }) => {
+  const { data, isLoading, isError, error } = useInputLedger(securityKey)
+  const classes = data?.classes ?? []
+
+  return (
+    <Panel variant="mixed">
+      <PanelHeader
+        title="Input ledger"
+        subtitle="FWD-12 -- per input class: where it came from, when it last ran, and how that run ended"
+      />
+      <PanelContent>
+        <div data-surfaced-outcome="ledger" className="space-y-2">
+          {!securityKey && (
+            <p data-ledger-state="no-name" className="text-sm text-white/70">
+              The ledger is per security, so it is not available because no name is selected. Pick a
+              name in the Lead Panel above and this reads that name only.
+            </p>
+          )}
+
+          {securityKey && isLoading && <p className="text-sm text-white/50">Loading...</p>}
+
+          {securityKey && !isLoading && isError && (
+            <p data-ledger-state="refused" className="text-sm text-amber-300">
+              {ledgerRefusalReason((error as Error)?.message ?? 'no error message was carried')}
+            </p>
+          )}
+
+          {securityKey && !isLoading && !isError && data && data.ledger_status === 'ABSENT' && (
+            <p data-ledger-state="absent" className="text-sm text-white/70">
+              {data.ledger_reason ??
+                'not available because the server reported the ledger ABSENT and carried no reason'}
+            </p>
+          )}
+
+          {securityKey && !isLoading && !isError && data && data.ledger_status === 'SERVED' && (
+            <>
+              <table data-ledger-table className="w-full text-[11px]">
+                <thead>
+                  <tr>
+                    <th className="text-left text-white/50 font-normal pr-2">Input class</th>
+                    <th className="text-left text-white/50 font-normal pr-2">Source</th>
+                    <th className="text-left text-white/50 font-normal pr-2">Last run</th>
+                    <th className="text-left text-white/50 font-normal pr-2">Outcome</th>
+                    <th className="text-left text-white/50 font-normal pr-2">Re-run</th>
+                    <th className="text-left text-white/50 font-normal pr-2">Detail</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {classes.map((row) => (
+                    <tr
+                      key={row.input_class}
+                      data-ledger-class={row.input_class}
+                      data-ledger-stage-bound={row.stage_bound ? 'yes' : 'no'}
+                      className="border-t border-white/5"
+                    >
+                      <td className="pr-2 text-white">{row.input_class}</td>
+                      <td className="pr-2 text-white/60">{row.source ?? 'none at this vintage'}</td>
+                      <td className="pr-2 text-white/70 tabular-nums">{row.stamp ?? 'NEVER'}</td>
+                      <td className={outcomeClass(row)}>{row.outcome ?? 'no run recorded'}</td>
+                      <td className="pr-2 text-white/40">
+                        {row.stage_bound ? 'stage bound' : 'no stage bound'}
+                      </td>
+                      <td className="pr-2 text-white/50">{row.detail ?? ''}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+
+              <p data-ledger-counts className="text-[10px] text-white/40">
+                {data.stage_bound_total} of {data.classes_total} input class(es) carry a bound
+                stage. The class set is CLOSED -- a class with no stage is registered here with no
+                stage, honestly, never dropped from the set.
+              </p>
+
+              {/* THE CONTROL THAT CANNOT ACT, SAYING WHY. No button is rendered: a re-run over
+                  classes whose stage is None records SKIPPED every time (ADDENDUM 2 C2). */}
+              <p
+                data-ledger-rerun={data.rerun_control}
+                className="text-[10px] text-amber-300/80 border-t border-white/10 pt-2"
+              >
+                {data.rerun_reason || RERUN_READ_ONLY_FALLBACK}
+              </p>
+            </>
+          )}
+        </div>
+      </PanelContent>
+    </Panel>
+  )
+}

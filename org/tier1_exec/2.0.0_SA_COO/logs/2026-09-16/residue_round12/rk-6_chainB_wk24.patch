+def read_model_block_versions(security_key: Optional[str]) -> Dict[str, Any]:
+    """Every landed stamp for one key under `derived/model_block/<key>/`, newest last.
+
+    The same prefix, the same seam and the same newest-is-greatest rule `read_model_block` uses
+    to pick ONE of these -- this route is that choice made visible, so a reader can see what the
+    Model tab picked FROM rather than only what it picked.
+    """
+    result: Dict[str, Any] = {
+        "security_key": security_key,
+        "prefix": MODEL_BLOCK_POOL_PREFIX,
+        "versions": [],
+        "denominators": {"versions": 0},
+    }
+    if not security_key:
+        result["read"] = {
+            "status": POOL_ABSENT,
+            "read_completed": True,
+            "reason": "no security key resolved for the requested name; nothing was read",
+        }
+        return result
+    base = "{0}{1}/".format(MODEL_BLOCK_POOL_PREFIX, security_key)
+    keys, record = _pool_keys(base)
+    result["read"] = record
+    if record["status"] == POOL_READ_FAILED:
+        return result
+    blocks = [key for key in keys if key.endswith("/model_block.json")]
+    versions = []
+    for key in sorted(blocks):
+        stamp = key[len(base):-len("/model_block.json")]
+        versions.append({"stamp": stamp, "object_key": key})
+    result["versions"] = versions
+    result["denominators"] = {"versions": len(versions), "objects_listed": len(keys)}
+    result["latest"] = versions[-1]["stamp"] if versions else None
+    return result
+
+
+def _figure_index(block: Optional[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
+    """Figures keyed by the triple that identifies one cell of the model block."""
+    index: Dict[str, Dict[str, Any]] = {}
+    for figure in (block or {}).get("figures", []) or []:
+        ident = "{0}|{1}|{2}".format(
+            figure.get("scope"), figure.get("fiscal_year"), figure.get("mnemonic")
+        )
+        index[ident] = figure
+    return index
+
+
+def compare_model_blocks(
+    security_key: Optional[str], left: Optional[str] = None, right: Optional[str] = None
+) -> Dict[str, Any]:
+    """Two stamps of one key, compared cell by cell. WITH NO QUERY, THE TWO LATEST.
+
+    Returns which cells were ADDED, REMOVED and CHANGED between them, with both values on every
+    changed cell. A key with fewer than two landed stamps cannot be compared: that answers with
+    the stamps it does have and a stated reason, never with an empty diff that reads as "nothing
+    changed".
+    """
+    versions = read_model_block_versions(security_key)
+    stamps = [version["stamp"] for version in versions["versions"]]
+    result: Dict[str, Any] = {
+        "security_key": security_key,
+        "available_stamps": stamps,
+        "denominators": {"versions": len(stamps)},
+        "read": versions.get("read"),
+        "compared": None,
+        "reason": None,
+    }
+    if left is None and right is None:
+        if len(stamps) < 2:
+            result["reason"] = (
+                "a comparison needs two landed stamps and {0} key(s) landed under {1}{2}/".format(
+                    len(stamps), MODEL_BLOCK_POOL_PREFIX, security_key)
+            )
+            return result
+        left, right = stamps[-2], stamps[-1]
+    unknown = [stamp for stamp in (left, right) if stamp not in stamps]
+    if unknown:
+        result["reason"] = "no landed stamp {0} for {1}".format(
+            ", ".join(str(stamp) for stamp in unknown), security_key)
+        return result
+
+    blocks: Dict[str, Optional[Dict[str, Any]]] = {}
+    for stamp in (left, right):
+        key = "{0}{1}/{2}/model_block.json".format(MODEL_BLOCK_POOL_PREFIX, security_key, stamp)
+        try:
+            body = _pool_client().get_object(Bucket=pool_reader.POOL_BUCKET, Key=key)["Body"].read()
+            blocks[stamp] = json.loads(body.decode("utf-8"))
+        except Exception as err:  # noqa: BLE001
+            result["reason"] = "the read of {0} did not complete: {1}: {2}".format(
+                key, type(err).__name__, err)
+            return result
+
+    before, after = _figure_index(blocks[left]), _figure_index(blocks[right])
+    added = sorted(set(after) - set(before))
+    removed = sorted(set(before) - set(after))
+    changed = []
+    for ident in sorted(set(before) & set(after)):
+        if before[ident].get("value") != after[ident].get("value"):
+            changed.append(
+                {
+                    "figure": ident,
+                    "mnemonic": after[ident].get("mnemonic"),
+                    "fiscal_year": after[ident].get("fiscal_year"),
+                    "scope": after[ident].get("scope"),
+                    "from": before[ident].get("value"),
+                    "to": after[ident].get("value"),
+                }
+            )
+    result["compared"] = {
+        "from_stamp": left,
+        "to_stamp": right,
+        "added": added,
+        "removed": removed,
+        "changed": changed,
+    }
+    result["denominators"].update(
+        figures_from=len(before),
+        figures_to=len(after),
+        added=len(added),
+        removed=len(removed),
+        changed=len(changed),
+        unchanged=len(set(before) & set(after)) - len(changed),
+    )
+    return result
+

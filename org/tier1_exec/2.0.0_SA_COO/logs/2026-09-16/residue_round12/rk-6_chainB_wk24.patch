diff --git a/lib/research/api/scoped_amgt.py b/lib/research/api/scoped_amgt.py
index 38b6f5036a..d2de57c8bc 100644
--- a/lib/research/api/scoped_amgt.py
+++ b/lib/research/api/scoped_amgt.py
@@ -2420,6 +2420,531 @@ def write_starred(firm_id: str, ticker: str, starred: bool) -> Dict[str, Any]:
     return {"firm_id": firm_id, "ticker": ticker.upper(), "starred": bool(starred)}
 
 
+# ---------------------------------------------------------------------------
+# THE SURFACED OUTCOMES (AMGT-rk-6 AC4/AC5; cells AMGT-rk-12 and AMGT-rk-16's ADAPTER halves)
+#
+# FWD-7, FWD-12 and FWD-14 each had a MODULE a person ran by hand and no route, so the outcome
+# was reachable only by someone with the repository, a shell and the right arguments -- which is
+# not what "Adam can see" means. The five readers below put each of those modules behind a
+# SERVED route, and they REUSE the modules rather than restating them: the key resolver, the rot
+# renderer, the vendor-input tuple, the closed class set and the per-list rot computation are all
+# imported from their owners. What is NOT reused is each module's own store access, and that is
+# deliberate and narrow -- the hand-run modules construct their own boto3 client and collapse
+# every read failure into an empty answer, while every read in this adapter goes through
+# `_pool_client()` and returns one of SERVED / ABSENT / READ_FAILED. Collapsing ABSENT into
+# READ_FAILED on a coverage surface is exactly how "nothing has landed" and "I could not look"
+# become the same sentence, so the read stays here and the DOMAIN LOGIC stays there.
+#
+# STOP -- AND THE PER-NAME WALK DOES NOT SURVIVE CONTACT WITH A ROUTE. The hand-run freshness view
+# issues four list calls PER NAME; against the 250-name universe that is 1,000 calls against a
+# 29 s integration ceiling. These readers list each store prefix ONCE -- measured 2026-09-16:
+# 31 objects under raw/, 5 under packs/, one page each -- and join in memory, so the cost is
+# flat in the number of names. The denominator is printed on every answer either way.
+# ---------------------------------------------------------------------------
+
+UNIVERSE_PREFIX = "universe/v1/"
+# NO lists PREFIX: FWD-14's register is PACKAGED in the artifact, not stored in the pool.
+# read_list_register says why, and no lists/ prefix is granted or co-signed.
+PACKS_PREFIX = "packs/"
+RAW_PREFIX = "raw/"
+LEDGER_OBJECT = "input_ledger.json"
+
+KEY_BASIS_ARTIFACT = "artifact.security_key"
+KEY_BASIS_IDENTITY_CELL = "universe.bloomberg_ticker"
+KEY_BASIS_NONE = "unresolved"
+
+NOT_EXERCISED = "NOT_EXERCISED"
+
+
+def _pool_keys(prefix: str) -> Tuple[List[str], Dict[str, Any]]:
+    """Every key under `prefix`, through the SAME seam every other pool read here uses.
+
+    A flat listing, never `Delimiter`/`CommonPrefixes`: the directory-backed client
+    (`_LocalPoolClient`) serves `Contents` only, so a delimiter walk would work against the live
+    store and silently return nothing against a fixture -- an instrument that disagrees with
+    itself by environment. Callers take the path segments they want from the returned keys.
+    """
+    store = "s3://{0}".format(pool_reader.POOL_BUCKET)
+    record: Dict[str, Any] = {
+        "status": POOL_SERVED,
+        "read_completed": True,
+        "prefix": prefix,
+        "source": _pool_source(),
+        "store": store,
+        "reason": None,
+    }
+    keys: List[str] = []
+    try:
+        for page in _pool_client().get_paginator("list_objects_v2").paginate(
+            Bucket=pool_reader.POOL_BUCKET, Prefix=prefix
+        ):
+            keys.extend(obj["Key"] for obj in page.get("Contents", []) or [])
+    except Exception as err:  # noqa: BLE001 -- classified, never swallowed
+        record.update(
+            status=POOL_READ_FAILED,
+            read_completed=False,
+            reason="the listing of {0}/{1} did not complete: {2}: {3}".format(
+                store, prefix, type(err).__name__, err
+            ),
+        )
+        return [], record
+    if not keys:
+        record.update(status=POOL_ABSENT, reason="no object under {0}/{1}".format(store, prefix))
+    record["objects_listed"] = len(keys)
+    return sorted(keys), record
+
+
+def _child_stamps(keys: Sequence[str], prefix: str) -> Dict[str, str]:
+    """`{immediate child -> greatest grandchild}` for keys shaped `<prefix><child>/<stamp>/...`.
+
+    The producers' stamp grammar is a zero-padded `YYYYMMDDTHHMMSSZ`, so the greatest string IS
+    the latest by time -- the same rule `_read_model_block_pool` relies on, stated once here.
+    A child with no grandchild segment is present in the mapping with an empty stamp, because
+    "landed but unstamped" is a different state from "never landed" and must not read as absent.
+    """
+    out: Dict[str, str] = {}
+    for key in keys:
+        if not key.startswith(prefix):
+            continue
+        parts = [part for part in key[len(prefix):].split("/") if part]
+        if not parts:
+            continue
+        child = parts[0]
+        stamp = parts[1] if len(parts) > 2 else ""
+        if stamp > out.get(child, ""):
+            out[child] = stamp
+        out.setdefault(child, stamp)
+    return out
+
+
+def read_universe() -> Tuple[Optional[Dict[str, Any]], Dict[str, Any]]:
+    """The NEWEST `universe/v1/<date>.json`. Not `read_pool_object`: that helper's layout is one
+    object under `<prefix><name>/`, and the universe producer lands dated objects DIRECTLY under
+    the prefix."""
+    keys, record = _pool_keys(UNIVERSE_PREFIX)
+    candidates = [
+        key for key in keys
+        if key.endswith(".json") and "/" not in key[len(UNIVERSE_PREFIX):]
+    ]
+    if record["status"] == POOL_READ_FAILED:
+        return None, record
+    if not candidates:
+        record.update(status=POOL_ABSENT, object_key=None,
+                      reason="no dated universe object under {0}/{1}".format(
+                          record["store"], UNIVERSE_PREFIX))
+        return None, record
+    key = candidates[-1]
+    record["object_key"] = key
+    try:
+        body = _pool_client().get_object(Bucket=pool_reader.POOL_BUCKET, Key=key)["Body"].read()
+        document = json.loads(body.decode("utf-8"))
+    except Exception as err:  # noqa: BLE001
+        if _is_miss(err):
+            record.update(status=POOL_ABSENT,
+                          reason="no object at {0}/{1}".format(record["store"], key))
+            return None, record
+        record.update(status=POOL_READ_FAILED, read_completed=False,
+                      reason="the read of {0}/{1} did not complete: {2}: {3}".format(
+                          record["store"], key, type(err).__name__, err))
+        return None, record
+    if not isinstance(document, dict):
+        record.update(status=POOL_READ_FAILED, read_completed=False,
+                      reason="{0}/{1} is not a JSON object".format(record["store"], key))
+        return None, record
+    record.update(status=POOL_SERVED, as_of=document.get("as_of"))
+    return document, record
+
+
+def _universe_key(entry: Dict[str, Any]) -> Tuple[Optional[str], str]:
+    """`(security_key, basis)` for one universe row, and THE BASIS IS PART OF THE ANSWER.
+
+    STOP -- TWO UNIVERSE SHAPES ARE LIVE AND THE HAND-RUN RESOLVER ONLY READS ONE OF THEM. Measured
+    2026-09-16 on the landed pool object `universe/v1/2026-09-16.json`: 250 names, of which 191
+    carry a `security_key` outright and ZERO carry the `bloomberg_ticker` cell that
+    `build_view.security_key_for()` reads -- so that resolver alone returns None for 250 of 250
+    and the whole view would read NEVER for every name while nothing failed. The earlier
+    one-pager shape (89 names, `folder` + `bloomberg_ticker`, 32 resolved) is the shape it was
+    written against. This reads the artifact's OWN key when the artifact carries one and falls
+    back to the hand-run resolver otherwise, and it NAMES which of the two answered, so a caller
+    can tell a resolved key from a guessed one.
+    """
+    key = entry.get("security_key")
+    if key:
+        return str(key), KEY_BASIS_ARTIFACT
+
+    from lib.research.freshness.build_view import security_key_for
+
+    legacy = security_key_for(entry)
+    if legacy:
+        return legacy, KEY_BASIS_IDENTITY_CELL
+    return None, KEY_BASIS_NONE
+
+
+def read_coverage_freshness() -> Dict[str, Any]:
+    """FWD-7's surface, SERVED: which covered names have gone stale.
+
+    One row per name in the universe -- NEVER is a value on a row, never a blank and never a
+    dropped name (the hand-run module's own rule, kept). The per-input clocks are the vendor
+    tuple that module declares, so adding a vendor there adds a column here.
+    """
+    from lib.research.freshness.build_view import NEVER, VENDOR_INPUTS, render_rot_signal
+
+    universe, universe_record = read_universe()
+    names = (universe or {}).get("names") or []
+
+    raw_keys, raw_record = _pool_keys(RAW_PREFIX)
+    pack_keys, pack_record = _pool_keys(PACKS_PREFIX)
+    per_vendor = dict(
+        (vendor, _child_stamps(raw_keys, "{0}{1}/".format(RAW_PREFIX, vendor)))
+        for vendor in VENDOR_INPUTS
+    )
+    pack_stamps = _child_stamps(pack_keys, PACKS_PREFIX)
+
+    register = read_list_register()
+    rot_line = render_rot_signal({"lists": register.get("lists")} if register.get("lists") else None)
+
+    rows: List[Dict[str, Any]] = []
+    basis_counts: Dict[str, int] = {}
+    stale_counts = {"landed": 0, "never": 0}
+    for entry in names:
+        security_key_value, basis = _universe_key(entry)
+        basis_counts[basis] = basis_counts.get(basis, 0) + 1
+        per_input: Dict[str, str] = {}
+        for vendor in VENDOR_INPUTS:
+            stamp = per_vendor.get(vendor, {}).get(security_key_value) if security_key_value else None
+            per_input[vendor] = stamp if stamp else NEVER
+        pack_stamp = pack_stamps.get(security_key_value) if security_key_value else None
+        candidates = [value for value in per_input.values() if value != NEVER]
+        if pack_stamp:
+            candidates.append(pack_stamp)
+        last_refreshed = max(candidates) if candidates else NEVER
+        stale_counts["landed" if last_refreshed != NEVER else "never"] += 1
+        rows.append(
+            {
+                "name": entry.get("name") or entry.get("folder"),
+                "security_key": security_key_value,
+                "security_key_basis": basis,
+                "source": entry.get("source"),
+                "last_refreshed": last_refreshed,
+                "per_input": per_input,
+                "pack": pack_stamp or NEVER,
+                "rot": rot_line,
+            }
+        )
+
+    return {
+        "rows": rows,
+        "denominators": {
+            "names": len(names),
+            "universe_denominators": (universe or {}).get("denominators"),
+            "security_key_basis": basis_counts,
+            "with_something_landed": stale_counts["landed"],
+            "never_refreshed": stale_counts["never"],
+            "raw_objects_listed": raw_record.get("objects_listed", 0),
+            "pack_objects_listed": pack_record.get("objects_listed", 0),
+            "vendor_inputs": list(VENDOR_INPUTS),
+        },
+        "rot": rot_line,
+        "reads": {
+            "universe": universe_record,
+            "raw": raw_record,
+            "packs": pack_record,

+# 8. THE LISTS
+# ---------------------------------------------------------------------------
+
+def _package_lists(monkeypatch, tmp_path, publishers, social):
+    """Put the two list objects where the DEPLOYED artifact carries them: a module-relative
+    `data/` directory beside the lists module. The repo has no such directory -- the build
+    script REMAPS them there from their deliverables path, and the repo-side move is outside
+    this cell's grant -- so the test relocates the module rather than inventing a pool read
+    the co-sign does not grant."""
+    import lib.research.lists.rot as rot_mod
+
+    data_dir = tmp_path / "data"
+    data_dir.mkdir()
+    (data_dir / "publishers.json").write_text(json.dumps(publishers), encoding="utf-8")
+    (data_dir / "social_accounts.json").write_text(json.dumps(social), encoding="utf-8")
+    monkeypatch.setattr(rot_mod, "__file__", str(tmp_path / "rot.py"))
+
+
+def test_08_rot_is_the_lists_modules_own_computation_and_the_dns_limb_is_not_a_zero(
+    monkeypatch, tmp_path
+):
+    stale_list = {
+        "owner": None, "owner_status": "UNASSIGNED",
+        "reviewed_at": "2020-01-01T00:00Z", "review_interval_days": 30,
+        "entries": [{"domain": "example.invalid"}, {"domain": "example.test"}],
+    }
+    _package_lists(monkeypatch, tmp_path, stale_list, dict(stale_list, entries=[{"handle": "x"}]))
+
+    register = scoped_amgt.read_list_register()
+    assert set(register["lists"]) == set(rot_module.LIST_NAMES)
+    assert register["denominators"]["lists_served"] == 2
+    publishers = register["lists"]["publishers"]
+
+    # the staleness verdict is the module's, not a second implementation here
+    expected = rot_module._list_rot(stale_list, check_dns=False)
+    assert publishers["list_stale"] == expected["list_stale"] is True
+    assert publishers["entries_total"] == expected["entries_total"] == 2
+
+    # THE LIMB THAT CANNOT ACT SAYS WHY, and does not report 0
+    assert publishers["unresolvable_count"] == scoped_amgt.NOT_EXERCISED
+    assert publishers["unresolvable_count"] != 0
+    assert "egress" in publishers["dns_limb"]
+
+
+def test_08b_an_unpackaged_register_is_a_classed_absence_naming_the_path(monkeypatch, tmp_path):
+    """If the build script ever drops these members the route must SAY the register is not
+    packaged, naming the path it looked at -- not serve an empty list set that reads as
+    'no list is stale'."""
+    import lib.research.lists.rot as rot_mod
+
+    monkeypatch.setattr(rot_mod, "__file__", str(tmp_path / "rot.py"))
+    register = scoped_amgt.read_list_register()
+    assert register["lists"] == {}
+    assert register["denominators"]["lists_served"] == 0
+    assert register["denominators"]["lists_declared"] == 2
+    for name in rot_mod.LIST_NAMES:
+        record = register["reads"][name]
+        assert record["status"] == scoped_amgt.POOL_ABSENT
+        assert "not packaged at" in record["reason"] and name in record["reason"]
+

+def read_input_ledger(security_key: Optional[str]) -> Dict[str, Any]:
+    """FWD-12's surface, SERVED: where each input class for this security came from and when.
+
+    THE CLOSED SET AND THE COLLAPSE RULE COME FROM THE LEDGER MODULE, THE READ DOES NOT, and the
+    reason is a difference that matters on this surface: `ledger.read_ledger` wraps its own
+    read in a bare `except` that returns an EMPTY ledger, so a permission error, a network
+    failure and a security nobody has ever run all answer identically. This adapter's contract
+    forbids that collapse -- ABSENT and READ_FAILED never merge -- so the object is read here and
+    handed to the module's own "greatest stamp per class" rule.
+    """
+    from lib.research.ledger import ledger as ledger_module
+
+    classes = dict(
+        (name, {
+            "source": spec.get("source"),
+            "stage_registered": spec.get("stage") is not None,
+        })
+        for name, spec in ledger_module.CLASSES.items()
+    )
+    result: Dict[str, Any] = {
+        "security_key": security_key,
+        "classes": classes,
+        "outcomes": list(ledger_module.OUTCOMES),
+        "latest_by_class": {},
+        "entries_total": 0,
+        "denominators": {"classes": len(classes), "classes_with_a_stage":
+                         sum(1 for spec in classes.values() if spec["stage_registered"])},
+    }
+    if not security_key:
+        result["read"] = {
+            "status": POOL_ABSENT,
+            "read_completed": True,
+            "reason": "no security key resolved for the requested name; nothing was read",
+        }
+        return result
+
+    key = "{0}{1}/{2}".format(PACKS_PREFIX, security_key, LEDGER_OBJECT)
+    store = "s3://{0}".format(pool_reader.POOL_BUCKET)
+    record: Dict[str, Any] = {
+        "status": POOL_ABSENT,
+        "read_completed": True,
+        "object_key": key,
+        "source": _pool_source(),
+        "store": store,
+        "reason": None,
+    }
+    document: Optional[Dict[str, Any]] = None
+    try:
+        body = _pool_client().get_object(Bucket=pool_reader.POOL_BUCKET, Key=key)["Body"].read()
+        document = json.loads(body.decode("utf-8"))
+    except Exception as err:  # noqa: BLE001
+        if _is_miss(err):
+            record["reason"] = "no ledger object at {0}/{1}".format(store, key)
+        else:
+            record.update(status=POOL_READ_FAILED, read_completed=False,
+                          reason="the read of {0}/{1} did not complete: {2}: {3}".format(
+                              store, key, type(err).__name__, err))
+        result["read"] = record
+        return result
+    if not isinstance(document, dict):
+        record.update(status=POOL_READ_FAILED, read_completed=False,
+                      reason="{0}/{1} is not a JSON object".format(store, key))
+        result["read"] = record
+        return result
+
+    entries = document.get("entries") or []
+    latest: Dict[str, Dict[str, Any]] = {}
+    for entry in entries:
+        name = entry.get("input_class")
+        if name is None:
+            continue
+        if name not in latest or entry.get("stamp", "") > latest[name].get("stamp", ""):
+            latest[name] = entry
+    record.update(status=POOL_SERVED)
+    result["read"] = record
+    result["latest_by_class"] = latest
+    result["entries_total"] = len(entries)
+    result["denominators"]["classes_with_a_run"] = len(latest)
+    result["stored_security_key"] = document.get("security_key")
+    return result
+
+
+def read_list_register() -> Dict[str, Any]:
+    """FWD-14's surface, SERVED: the owned lists and their rot signal.
+
+    THE INPUTS ARE PACKAGED IN THE ARTIFACT, NOT READ FROM THE POOL, and that is the signed
+    shape rather than a convenience: no `lists/` prefix exists in the pool, none is granted and
+    none is co-signed, so a pool read here would be a widening nobody reviewed. They land at a
+    module-relative `data/` directory beside the lists module -- the build script names both
+    members with this function as their reader.
+
+    THE ROT COMPUTATION IS THE LISTS MODULE'S OWN `_list_rot`, applied to each loaded list, so
+    the staleness rule has ONE owner and this route cannot drift from the hand-run answer.
+    `main()` is never called: it WRITES `rot_signal.json` beside its inputs, and a GET route
+    that writes is outside this act entirely.
+
+    STOP -- THE DOMAIN-RESOLUTION LIMB IS NOT EXERCISED HERE AND SAYS SO. That limb resolves
+    every publisher domain through a DNS lookup; the served route does not perform it, because
+    it is egress off this estate's own infrastructure taken on behalf of a request rather than
+    by a person who asked for it. The count is reported as NOT_EXERCISED with this reason
+    rather than as a zero, because a zero would read as "no publisher domain has rotted".
+    """
+    from lib.research.lists import rot as rot_module
+
+    data_dir = os.path.join(os.path.dirname(os.path.abspath(rot_module.__file__)), "data")
+
+    lists: Dict[str, Any] = {}
+    reads: Dict[str, Any] = {}
+    served = 0
+    for name in rot_module.LIST_NAMES:
+        path = os.path.join(data_dir, "{0}.json".format(name))
+        record: Dict[str, Any] = {
+            "status": POOL_ABSENT,
+            "read_completed": True,
+            "object_key": path,
+            "source": "packaged",
+            "store": "the deployed artifact",
+            "reason": None,
+        }
+        try:
+            with open(path, "r", encoding="utf-8") as handle:
+                document = json.load(handle)
+        except (IOError, OSError) as err:
+            record["reason"] = (
+                "the list register is not packaged at {0}: {1}: {2}".format(
+                    path, type(err).__name__, err)
+            )
+            reads[name] = record
+            continue
+        except ValueError as err:
+            record.update(status=POOL_READ_FAILED, read_completed=False,
+                          reason="{0} did not parse: {1}".format(path, err))
+            reads[name] = record
+            continue
+        if not isinstance(document, dict):
+            record.update(status=POOL_READ_FAILED, read_completed=False,
+                          reason="{0} is not a JSON object".format(path))
+            reads[name] = record
+            continue
+        record.update(status=POOL_SERVED)
+        reads[name] = record
+        entry = rot_module._list_rot(document, check_dns=False)
+        entry["unresolvable_count"] = NOT_EXERCISED
+        entry["unresolvable_domains"] = NOT_EXERCISED
+        entry["dns_limb"] = (
+            "not exercised by the served route: resolving every publisher domain is egress off "
+            "this estate's infrastructure taken on behalf of a request; run the lists module by "
+            "hand for that count"
+        )
+        lists[name] = entry
+        served += 1
+
+    return {
+        "lists": lists,
+        "reads": reads,
+        "denominators": {
+            "lists_declared": len(rot_module.LIST_NAMES),
+            "lists_served": served,
+            "declared": list(rot_module.LIST_NAMES),
+        },
+        "generated_at": _now_iso(),
+    }
+

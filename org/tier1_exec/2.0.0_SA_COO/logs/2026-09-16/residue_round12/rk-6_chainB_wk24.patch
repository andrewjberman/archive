+#!/bin/bash
+# AMGT_RESAPP AMGT-rk-6 (gap G3, FWD-5, ADDENDUM 1 R2, contract C-ROUND12-PRINT-SERVER-SIDE)
+# -- build + upload the `opal-amgt-print-deps` Lambda layer.
+#
+# WHY THIS EXISTS: print-deps-layer.tf declares
+# data.aws_s3_object.amgt_print_deps_zip, which reads
+# s3://opal-313476888478-lambda-layers/opal-amgt-print-deps.zip at EVALUATION time. While that
+# key is a 404, every `terraform plan` in infra/aws/terraform/harvest/ fails before touching
+# anything -- so this script is a PRECONDITION of terraform in this root, exactly as
+# build-and-upload-scoped-amgt.sh already is, not a deploy step. It deploys NOTHING by itself:
+# the layer version is published, and attached to the function, only when a terraform apply
+# reads the new object.
+#
+# THE PINS ARE EXACT AND THE SET IS A CLOSURE. matplotlib, pypdf and numpy are the three the
+# acceptance criterion names; every other pin is a hard `Requires-Dist` of one of them, and
+# build_print_deps_layer.py RE-DERIVES that closure from the downloaded wheels' own METADATA and
+# refuses if any hard requirement is unsatisfied -- so this list cannot silently lose a member.
+# Measured when the pins were chosen (2026-09-16): pypdf's only requirement, typing_extensions,
+# carries the marker python_version < '3.11' and does not apply to this runtime.
+#
+# PLATFORM: cp311 / manylinux2014_x86_64 -- scoped-amgt-api.tf declares runtime python3.11 and
+# the yang-lambda module leaves the default x86_64 architecture. The builder proves this rather
+# than trusting the pip flags: every compiled member is checked for linux x86_64 ELF magic, so a
+# wheel resolved for the BUILD BOX instead of the FUNCTION cannot reach the store.
+#
+# NOTHING IS INSTALLED. `pip download` fetches wheels into a scratch directory for a platform
+# this box cannot execute; no interpreter on this machine is modified, exactly as
+# build-and-upload-scoped-amgt.sh's own vendor step does.
+#
+#   --build-only <out.zip>   build + verify, copy the zip to <out.zip>, and STOP before upload.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
+BUCKET="opal-313476888478-lambda-layers"
+KEY="opal-amgt-print-deps.zip"
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+ZIP="$TMP/opal-amgt-print-deps.zip"
+WHEELS="$TMP/wheels"
+
+BUILD_ONLY=""
+if [ "${1:-}" = "--build-only" ]; then
+  BUILD_ONLY="${2:?--build-only needs an output zip path}"
+fi
+
+if [ -x "$ROOT/.tools/aws" ]; then
+  AWS="$ROOT/.tools/aws"
+else
+  AWS="aws"
+fi
+
+# The three named packages, then their hard requirement closure.
+NAMED_PINS="matplotlib==3.11.2 pypdf==6.19.0 numpy==2.2.6"
+CLOSURE_PINS="contourpy==1.3.2 cycler==0.12.1 fonttools==4.65.0 kiwisolver==1.5.1 packaging==26.3 pillow==12.2.0 pyparsing==3.3.2 python-dateutil==2.9.0.post0 six==1.17.0"
+
+mkdir -p "$WHEELS"
+python -m pip download --quiet --disable-pip-version-check --no-deps \
+  --only-binary=:all: --implementation cp --python-version 3.11 \
+  --platform manylinux2014_x86_64 -d "$WHEELS" $NAMED_PINS $CLOSURE_PINS
+echo "VENDOR: pip download (cp311 manylinux2014_x86_64) -> $(ls "$WHEELS" | wc -l) wheel(s)"
+
+python "$SCRIPT_DIR/build_print_deps_layer.py" "$WHEELS" "$ZIP"
+
+if [ -n "$BUILD_ONLY" ]; then
+  cp "$ZIP" "$BUILD_ONLY"
+  echo "OK: built only -> $BUILD_ONLY (nothing uploaded)"
+  exit 0
+fi
+
+# content-sha256 metadata is carried for parity with the function artifact, so a reader that
+# wants the hash does not have to download the object to compute it.
+SHA_B64="$(python -c "
+import base64, hashlib, sys
+print(base64.b64encode(hashlib.sha256(open(sys.argv[1], 'rb').read()).digest()).decode())
+" "$ZIP")"
+
+"$AWS" s3 cp "$ZIP" "s3://$BUCKET/$KEY" --metadata "content-sha256=$SHA_B64" --only-show-errors
+# upload-verify: never trust a cp exit alone.
+"$AWS" s3api head-object --bucket "$BUCKET" --key "$KEY" \
+  --query '{Size:ContentLength,ETag:ETag,VersionId:VersionId,Meta:Metadata}' --output json
+echo "local sha256 (b64): $SHA_B64"
+echo "OK: uploaded s3://$BUCKET/$KEY"

+def _land_block(stamp, figures):
+    _write(
+        "derived/model_block/BA_US_Equity/{0}/model_block.json".format(stamp),
+        {"security": "BA US Equity", "figures": figures},
+    )
+
+
+def test_09_versions_lists_every_landed_stamp_newest_last():
+    for stamp in ("20260910T224432Z", "20260910T232018Z", "20260910T225428Z"):
+        _land_block(stamp, [])
+    served = scoped_amgt.read_model_block_versions("BA_US_Equity")
+    assert [v["stamp"] for v in served["versions"]] == [
+        "20260910T224432Z", "20260910T225428Z", "20260910T232018Z"]
+    assert served["denominators"]["versions"] == 3
+    assert served["latest"] == "20260910T232018Z"
+
+
+def test_10_compare_with_no_query_defaults_to_the_two_latest_and_reports_both_values():
+    base = {"scope": "fiscal_year_line_item", "fiscal_year": "2025", "mnemonic": "PX_LAST"}
+    _land_block("20260910T224432Z", [dict(base, value=146.58),
+                                     {"scope": "header", "mnemonic": "GONE", "value": "x"}])
+    _land_block("20260910T232018Z", [dict(base, value=132.23),
+                                     {"scope": "header", "mnemonic": "NEW", "value": "y"}])
+    result = scoped_amgt.compare_model_blocks("BA_US_Equity")
+    compared = result["compared"]
+    assert compared["from_stamp"] == "20260910T224432Z"
+    assert compared["to_stamp"] == "20260910T232018Z"
+    assert compared["changed"] == [{
+        "figure": "fiscal_year_line_item|2025|PX_LAST", "mnemonic": "PX_LAST",
+        "fiscal_year": "2025", "scope": "fiscal_year_line_item",
+        "from": 146.58, "to": 132.23,
+    }]
+    assert compared["added"] == ["header|None|NEW"]
+    assert compared["removed"] == ["header|None|GONE"]
+    assert result["denominators"]["changed"] == 1 and result["denominators"]["unchanged"] == 0
+
+
+def test_11_fewer_than_two_stamps_states_why_rather_than_an_empty_diff():
+    _land_block("20260910T224432Z", [])
+    result = scoped_amgt.compare_model_blocks("BA_US_Equity")
+    assert result["compared"] is None, "an empty diff would read as 'nothing changed'"
+    assert "needs two landed stamps" in result["reason"]
+    assert result["available_stamps"] == ["20260910T224432Z"]
+    # and a stamp that never landed is named rather than silently compared
+    named = scoped_amgt.compare_model_blocks("BA_US_Equity", "20260910T224432Z", "NOPE")
+    assert named["compared"] is None and "no landed stamp NOPE" in named["reason"]
+

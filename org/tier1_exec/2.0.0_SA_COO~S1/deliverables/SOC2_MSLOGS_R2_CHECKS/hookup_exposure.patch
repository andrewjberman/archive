+def _exposure(s3, bucket, ev, silver_reader):
+    account = ev.get("account")
+    if not isinstance(account, str) or "@" not in account:
+        return {"ok": False, "error": "account"}, "refused"
+    lo = _parse_iso(ev.get("start"))
+    hi = _parse_iso(ev.get("end"))
+    if lo is None or hi is None or hi <= lo or hi - lo > TIMELINE_MAX_WINDOW:
+        return {"ok": False, "error": "window"}, "refused"
+    import exposure  # lazy: the zip carries it beside this module
+
+    reader = silver_reader if silver_reader is not None else _DEFAULT_TIMELINE_READER
+    rows = list(reader.timeline_rows(s3, bucket, SILVER_PREFIX, account, ev["start"], ev["end"], detail=True))
+    answer = exposure.compute(rows, account)
+    truncated = False
+    for key in ("opened", "left", "unrecorded"):
+        if len(answer[key]) > EXPOSURE_MAX_ENTRIES:
+            answer[key] = answer[key][:EXPOSURE_MAX_ENTRIES]
+            truncated = True
+    return {"ok": True, "opened": answer["opened"], "left": answer["left"], "unrecorded": answer["unrecorded"],
+            "truncated": truncated}, "ok"
+

+# ---- exposure: member alias; what one account opened and what left (round 2 hookup of exposure.py) ----
+
+def exposure_ev(account=ACCOUNT, start=WIN_START, end=WIN_END):
+    return {"op": "exposure", "account": account, "start": start, "end": end}
+
+
+def _exposure_row(i, op, raw, item=None):
+    return {"time": "2026-10-15T13:%02d:00Z" % i, "feed": "SharePoint", "operation": op, "result_status": "Succeeded",
+            "client_ip": "203.0.113.7", "item_name": item, "user_id": ACCOUNT, "record_id": "x%d" % i, "raw_json": json.dumps(raw)}
+
+
+def test_exposure_member_answers_opened_left_and_unrecorded(s3, logs):
+    reader = StubDetailTimeline([
+        _exposure_row(1, "FileDownloaded", {"ObjectId": "https://x.example/a"}, "a.xlsx"),
+        _exposure_row(2, "AnonymousLinkCreated", {"ObjectId": "https://x.example/a"}, "a.xlsx"),
+    ])
+    r = call(s3, logs, exposure_ev(), alias="member", silver_reader=reader)
+    assert set(r) == {"ok", "opened", "left", "unrecorded", "truncated"}
+    assert r["ok"] is True and r["truncated"] is False
+    assert [e["record_id"] for e in r["opened"]] == ["x1"]
+    assert [(e["kind"], e["recipient"]) for e in r["left"]] == [("anonymous_link", "anyone with the link")]
+    assert "mail_recipients" in [u["category"] for u in r["unrecorded"]]
+    assert reader.calls == [True]
+    assert "raw_json" not in json.dumps(r)
+    assert logs == ["op=exposure outcome=ok"]
+
+
+def test_exposure_is_not_served_on_the_collector_alias(s3, logs):
+    reader = StubDetailTimeline([])
+    r = call(s3, logs, exposure_ev(), alias="collector", silver_reader=reader)
+    assert r["ok"] is False
+    assert reader.calls == []
+
+
+@pytest.mark.parametrize("ev", [exposure_ev(account="not-an-address"), exposure_ev(account=None),
+                                exposure_ev(start="2026-10-16T00:00:00Z", end="2026-10-15T00:00:00Z"),
+                                exposure_ev(start="2026-09-01T00:00:00Z", end="2026-10-16T00:00:00Z")])
+def test_exposure_bad_account_or_window_is_refused_before_any_read(s3, logs, ev):
+    reader = StubDetailTimeline([])
+    r = call(s3, logs, ev, alias="member", silver_reader=reader)
+    assert r["ok"] is False
+    assert reader.calls == []
+
+
+def test_exposure_cuts_a_list_at_5000_and_says_truncated(s3, logs):
+    rows = [_exposure_row(i % 60, "FileAccessed", {}, "f%d" % i) for i in range(5001)]
+    r = call(s3, logs, exposure_ev(), alias="member", silver_reader=StubDetailTimeline(rows))
+    assert len(r["opened"]) == 5000
+    assert r["truncated"] is True

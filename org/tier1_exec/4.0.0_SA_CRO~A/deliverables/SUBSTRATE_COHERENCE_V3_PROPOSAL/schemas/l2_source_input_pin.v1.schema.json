{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opal.local/cro-a/c3materialize/l2_source_input_pin.v1.schema.json",
  "title": "L2 structure and behavior source-input pin",
  "x-document-contract": {
    "document_kind": "json_schema",
    "exact_home": "org/tier1_exec/4.0.0_SA_CRO~A/deliverables/SUBSTRATE_COHERENCE_V3_PROPOSAL/schemas/l2_source_input_pin.v1.schema.json",
    "authorship_mode": "human_authored",
    "mutation_policy": "whole_document_replace",
    "temporal_claim": "timeless_definition",
    "authority_role": "authoritative_source",
    "source_relationship": [],
    "projection_relationship": [],
    "evidence_relationship": []
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "governing_schema",
    "exact_home",
    "document_lifecycle",
    "relationships",
    "decomposition_pin",
    "scope",
    "progress_boundary",
    "environment_snapshot",
    "views"
  ],
  "properties": {
    "document_kind": {"const": "l2_source_input_pin"},
    "schema_version": {"const": "1.0.0"},
    "governing_schema": {"const": "schemas/l2_source_input_pin.v1.schema.json"},
    "exact_home": {"const": "org/tier1_exec/4.0.0_SA_CRO~A/deliverables/SUBSTRATE_COHERENCE_V3_PROPOSAL/l2_source_input_pin.v1.json"},
    "document_lifecycle": {"$ref": "#/$defs/document_lifecycle"},
    "relationships": {"$ref": "#/$defs/relationships"},
    "decomposition_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "rectangle", "task_order"],
      "properties": {
        "commit": {"const": "86db9b1122"},
        "rectangle": {"$ref": "#/$defs/pinned_file"},
        "task_order": {"$ref": "#/$defs/pinned_file"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_views", "excluded_views"],
      "properties": {
        "included_views": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["structure", "behavior"]}
        },
        "excluded_views": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "exclusion_basis"],
            "properties": {
              "view": {"enum": ["flow", "semantic"]},
              "exclusion_basis": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "progress_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_class", "owned_view_cells", "populated_view_cells", "operative_view_outputs"],
      "properties": {
        "artifact_class": {"const": "pinned_source_input_set"},
        "owned_view_cells": {"const": 14},
        "populated_view_cells": {"const": 0},
        "operative_view_outputs": {"const": 0}
      }
    },
    "environment_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_commit", "python_importability"],
      "properties": {
        "workspace_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "python_importability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graph_tool", "networkx", "numpy", "scipy", "sklearn"],
          "properties": {
            "graph_tool": {"const": false},
            "networkx": {"const": true},
            "numpy": {"const": true},
            "scipy": {"const": true},
            "sklearn": {"const": true}
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/view_pin"}
    }
  },
  "$defs": {
    "document_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorship_mode", "mutation_policy", "temporal_claim", "authority_role"],
      "properties": {
        "authorship_mode": {"const": "human_authored"},
        "mutation_policy": {"const": "whole_document_replace"},
        "temporal_claim": {"const": "current_at_observation"},
        "authority_role": {"const": "supporting_evidence"}
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "projection", "evidence"],
      "properties": {
        "source": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "projection": {"type": "array", "maxItems": 0},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "pinned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {
          "enum": [
            "prior_cover_output",
            "cover_generator",
            "cochange_engine",
            "drift_orchestrator",
            "drift_topology",
            "heat_tool",
            "heat_hazard_card"
          ]
        }
      }
    },
    "view_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "expected_source_population_count",
        "declared_entity_set_present",
        "declared_entity_set_path",
        "declared_entity_denominator",
        "pinned_sources",
        "procedure_selection",
        "named_hazard_response"
      ],
      "properties": {
        "view": {"enum": ["structure", "behavior"]},
        "expected_source_population_count": {"type": "integer", "minimum": 1},
        "declared_entity_set_present": {"const": false},
        "declared_entity_set_path": {"type": "null"},
        "declared_entity_denominator": {"type": "null"},
        "pinned_sources": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/source_file"}
        },
        "procedure_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "procedure_id"],
          "properties": {
            "selected": {"const": false},
            "procedure_id": {"type": "null"}
          }
        },
        "named_hazard_response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hazard_id", "current_disposition", "reason"],
          "properties": {
            "hazard_id": {"enum": ["graph_tool_dependency_absent", "comp_heat_score_does_not_resolve_id"]},
            "current_disposition": {"enum": ["procedure_selection_blocked", "exclude_score_feature"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

+def _index_blobs(root: str, rels: list) -> dict:
+    """{rel: text} for every rel's INDEX blob, in ONE `git cat-file --batch` call (329 documents
+    measured 2026-10-09; a subprocess per document would cost seconds on Windows). `:<path>` resolves
+    against the index and honors GIT_INDEX_FILE. A rel the index cannot resolve is left out, so the
+    caller's fallback decides; a batch that fails outright returns {} and every read falls back."""
+    if not rels:
+        return {}
+    try:
+        p = subprocess.run(["git", "cat-file", "--batch"], cwd=root, capture_output=True,
+                           input="".join(":%s\n" % r for r in rels).encode("utf-8"))
+    except Exception:  # noqa: BLE001
+        return {}
+    if p.returncode != 0:
+        return {}
+    out, pos, blobs = p.stdout, 0, {}
+    for rel in rels:
+        nl = out.find(b"\n", pos)
+        if nl < 0:
+            break
+        header = out[pos:nl].split()
+        pos = nl + 1
+        if len(header) == 3 and header[1] == b"blob":
+            size = int(header[2])
+            blobs[rel] = out[pos:pos + size].decode("utf-8", "replace")
+            pos += size + 1
+    return blobs
+

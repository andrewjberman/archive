+<!doctype html><html><head><meta charset="utf-8"><title>Controlled Opal scope integration</title></head>
+<body><div id="root"></div><script type="module">
+import React from 'react';
+import {createRoot} from 'react-dom/client';
+import {flushSync} from 'react-dom';
+import {BrowserRouter} from 'react-router-dom';
+import {AuthContext} from '/src/contexts/AuthContext.context.ts';
+import {InvestorReporting} from '../../index.tsx';
+import wire from './server-wire.json';
+import '/src/index.css';
+// Controlled identity + transport, actual page/client/parser. This is not live auth proof.
+const root=createRoot(document.getElementById('root'));
+let internal=true, identity='first', partial=false;
+const calls=[];
+const nativeFetch=window.fetch.bind(window);
+window.fetch=async (url,options={})=>{
+ if(!String(url).includes('/api/scoped/investor-reporting/'))return nativeFetch(url,options);
+ const path=new URL(String(url),location.origin);
+ const body=options.body?JSON.parse(options.body):{};
+ const tenant=body.selected_tenant??path.searchParams.get('selected_tenant');
+ calls.push({path:path.pathname,tenant,identity,body});
+ let answer;
+ if(path.pathname.endsWith('/resolve')){
+   if(tenant==='global'){
+     answer=structuredClone(wire.context);
+     if(partial){answer.data.completeness='PARTIAL';answer.data.firms[1]={tenant:'inflection',scope:null,state:'UNAVAILABLE',reason:'UNEXPECTED'};}
+   }else{
+     const member=wire.context.data.firms.find(row=>row.tenant===tenant);
+     answer={...wire.context,firm_id:member.scope.verified_request_firm_id,data:structuredClone(member.scope)};
+     if(!internal)answer.data.principal_class='FIRM_OPERATIONS';
+   }
+ }else if(path.pathname.endsWith('/browse'))answer=wire.pages[tenant];
+ else if(path.pathname.endsWith('/selections'))answer=wire.selections[tenant];
+ else throw Error('Controlled harness does not serve this report');
+ return new Response(JSON.stringify(answer),{status:200,headers:{'Content-Type':'application/json'}});
+};
+function render(){
+ const auth={isLoading:false,isAuthenticated:true,accessToken:null,user:{email:identity+'@example.invalid'},
+ claims:{firmId:internal?'opal-capital':'49financial',userType:null,advisorId:null,firmRole:internal?null:'admin',advisorRole:null},
+ isInternal:()=>internal,isDev:()=>false};
+ flushSync(()=>root.render(React.createElement(AuthContext.Provider,{value:auth},
+  React.createElement(BrowserRouter,null,React.createElement(InvestorReporting)))));
+}
+window.exercise={calls,switchIdentity:(name,isInternal=true)=>{identity=name;internal=isInternal;render();},
+ partial:()=>{partial=true;internal=true;identity='partial';render();}};
+render();
+</script></body></html>

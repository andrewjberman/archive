###############################################################################
# NFRA_AKPIPE -- Terraform PROPOSAL (RCN-0003)
#
# Author: 4.0.0_SA_CRO (Chief Research Officer)
#
# >> PROPOSAL ONLY -- DO NOT APPLY FROM THIS PATH. <<
# Filename is intentionally *.tf.proposal so it CANNOT be picked up by a terraform
# run from the CRO tree. infra/aws/** is an AE lane and every apply is CTO-gated:
#   - CloudOps/AE relocates this to infra/aws/lambda/akpipe/main.tf
#   - AE registers the Lambda in infra/aws/lambda/ci/lambda-source-map.json (Rule 4)
#   - CTO gates the apply via .tools/safe-apply.sh (never bare terraform apply)
# The CRO authored and validated the logic; it does not place or apply infrastructure.
#
# NEW-RESOURCE IAM (CLAUDE.md Rule 22a) -- comp-iam FAILS GREEN here because it models
# (action), never (action, resource). Before accepting this as deployed, verify on the
# live primitive, ONE resource per call, positive control run SEPARATELY:
#   aws iam simulate-principal-policy --policy-source-arn <role_arn> \
#     --action-names dynamodb:PutItem --resource-arns <exact table arn>
#   aws iam simulate-principal-policy --policy-source-arn <role_arn> \
#     --action-names s3:PutObject --resource-arns <exact bucket arn>/*
###############################################################################

variable "region" { default = "us-east-1" }
variable "bucket_name" { default = "opal-data-akpipe" } # CTO confirms under the estate grammar
variable "table_name" { default = "akpipe_papers" }

# ------------------------------------------------------------------ storage

resource "aws_s3_bucket" "akpipe" {
  bucket = var.bucket_name
}

# Lossless contract: versioning ON, NO expiry lifecycle. "We only want to add more."
resource "aws_s3_bucket_versioning" "akpipe" {
  bucket = aws_s3_bucket.akpipe.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "akpipe" {
  bucket = aws_s3_bucket.akpipe.id
  rule {
    apply_server_side_encryption_by_default { sse_algorithm = "AES256" }
  }
}

resource "aws_s3_bucket_public_access_block" "akpipe" {
  bucket                  = aws_s3_bucket.akpipe.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# PK arxiv_id + SK version => one row per VERSION; a new version is a NEW row, never an
# overwrite. GSI rank-by-day serves "today's ranking, descending" in one query.
resource "aws_dynamodb_table" "papers" {
  name         = var.table_name
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "arxiv_id"
  range_key    = "version"

  attribute {
    name = "arxiv_id"
    type = "S"
  }
  attribute {
    name = "version"
    type = "S"
  }
  attribute {
    name = "rank_asof_date"
    type = "S"
  }
  attribute {
    name = "derived_state_rank"
    type = "N"
  }

  global_secondary_index {
    name            = "rank-by-day"
    hash_key        = "rank_asof_date"
    range_key       = "derived_state_rank"
    projection_type = "ALL"
  }

  point_in_time_recovery { enabled = true }
}

# ------------------------------------------------------------------ iam

resource "aws_iam_role" "akpipe" {
  name = "akpipe-daily-harvest-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

# Scoped to THIS bucket and THIS table only -- not a wildcard grant.
resource "aws_iam_role_policy" "akpipe" {
  name = "akpipe-daily-harvest-policy"
  role = aws_iam_role.akpipe.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject", "s3:ListBucket"]
        Resource = [aws_s3_bucket.akpipe.arn, "${aws_s3_bucket.akpipe.arn}/*"]
      },
      {
        Effect = "Allow"
        Action = ["dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query",
        "dynamodb:Scan", "dynamodb:GetItem"]
        Resource = [aws_dynamodb_table.papers.arn,
        "${aws_dynamodb_table.papers.arn}/index/*"]
      },
      {
        Effect   = "Allow"
        Action   = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"]
        Resource = "arn:aws:logs:*:*:*"
      }
    ]
  })
}

# ------------------------------------------------------------------ compute

# Deliberately sized (CLAUDE.md Deployment Rule 5) -- NOT yang defaults. Full-text NLP
# over dozens of papers plus a whole-corpus recompute needs memory and a long timeout.
# If the corpus outgrows a 15-min ceiling, split the recompute into its own Lambda
# rather than raising memory further.
resource "aws_lambda_function" "akpipe" {
  function_name = "akpipe-daily-harvest"
  role          = aws_iam_role.akpipe.arn
  handler       = "lambda_function.lambda_handler"
  runtime       = "python3.12"
  memory_size   = 2048
  timeout       = 900

  filename         = "${path.module}/build/akpipe.zip"
  source_code_hash = filebase64sha256("${path.module}/build/akpipe.zip")

  # Dependencies in LAYERS (Deployment Rule 3): model2vec + numpy + pymupdf, and the
  # potion-base-8M model baked in at /opt/potion-base-8M so nothing is fetched from
  # HuggingFace at runtime (that would be undeclared egress).
  layers = var.layer_arns

  environment {
    variables = {
      AKPIPE_TABLE       = aws_dynamodb_table.papers.name
      AKPIPE_BUCKET      = aws_s3_bucket.akpipe.id
      AKPIPE_PROFILE_KEY = "_profile/akpipe-profile-v3.json"
      AKPIPE_POTION_DIR  = "/opt/potion-base-8M"
    }
  }
}

variable "layer_arns" {
  type    = list(string)
  default = []
}

resource "aws_cloudwatch_event_rule" "daily" {
  name = "akpipe-daily"
  # 06:00Z daily. Explicit Z -- a bare local time is ambiguous (VERIFICATION LAW 11).
  schedule_expression = "cron(0 6 * * ? *)"
}

resource "aws_cloudwatch_event_target" "daily" {
  rule = aws_cloudwatch_event_rule.daily.name
  arn  = aws_lambda_function.akpipe.arn
}

resource "aws_lambda_permission" "events" {
  statement_id  = "AllowExecutionFromEventBridge"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.akpipe.function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_cloudwatch_event_rule.daily.arn
}

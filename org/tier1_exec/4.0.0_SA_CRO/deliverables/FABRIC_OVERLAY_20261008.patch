diff --git a/infra/aws/globgrph/tests/test_kuzu_fabric_overlay.py b/infra/aws/globgrph/tests/test_kuzu_fabric_overlay.py
new file mode 100644
index 0000000000..7ee263ec13
--- /dev/null
+++ b/infra/aws/globgrph/tests/test_kuzu_fabric_overlay.py
@@ -0,0 +1,119 @@
+"""kuzu_fabric_overlay: the fabric layer lands in its own tables, never touches CloudNode/CloudEdge, reloads only new
+records, prefers a measured record over an inferred one, expires commits past the window, and links a surface to the
+estate nodes it names."""
+import datetime as dt
+import io
+import json
+import os
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(HERE))
+
+import kuzu  # noqa: E402
+
+import kuzu_fabric_overlay as fo  # noqa: E402
+
+NOW = dt.datetime(2026, 10, 8, 18, 0, 0, tzinfo=dt.timezone.utc)
+
+
+class FakeS3:
+    def __init__(self, objects):
+        self.objects = dict(objects)
+        self.gets = 0
+
+    def get_paginator(self, _name):
+        outer = self
+
+        class P:
+            def paginate(self, Bucket, Prefix):  # noqa: N803
+                yield {"Contents": [{"Key": k} for k in sorted(outer.objects) if k.startswith(Prefix)]}
+        return P()
+
+    def get_object(self, Bucket, Key):  # noqa: N803
+        self.gets += 1
+        return {"Body": io.BytesIO(json.dumps(self.objects[Key]).encode())}
+
+
+def rec(sha, when, box, claim="measured", surfaces=(("tf:shared-infra", "INFRA"),), infer_rev=None):
+    r = {"schema": "fabric-activity/1", "sha": sha, "when": when, "box": box, "box_claim": claim, "seat": "S~1",
+         "subject": "s", "files": [], "file_count": 1, "branch": "CLOUD",
+         "surfaces": [{"key": k, "cls": c} for k, c in surfaces], "projects": ["P1"]}
+    if infer_rev:
+        r["infer_rev"] = infer_rev
+    return r
+
+
+def key(r):
+    return "fabric/activity/v1/dt=%s/box=%s/%s_%s.json" % (r["when"][:10], r["box"],
+                                                            r["when"].replace("-", "").replace(":", ""), r["sha"][:12])
+
+
+def estate_db(path):
+    db = kuzu.Database(path)
+    c = kuzu.Connection(db)
+    c.execute("CREATE NODE TABLE CloudNode(node_id STRING PRIMARY KEY, arn STRING, node_type STRING, name STRING, "
+              "layer STRING, drift_class STRING, source STRING, snapshot_ts INT64, props STRING)")
+    c.execute("CREATE REL TABLE CloudEdge(FROM CloudNode TO CloudNode, edge_type STRING, layer STRING, "
+              "snapshot_ts INT64, props STRING)")
+    c.execute("CREATE (:CloudNode {node_id: 'b1', node_type: 'S3_BUCKET', name: 'b1', layer: 'aws', "
+              "props: '{\"provenance\": {\"tf_module\": \"shared-infra\"}}'})")
+    c.execute("CREATE (:CloudNode {node_id: 'b2', node_type: 'S3_BUCKET', name: 'b2', layer: 'aws', props: '{}'})")
+    c.execute("MATCH (a:CloudNode {node_id: 'b1'}), (b:CloudNode {node_id: 'b2'}) "
+              "CREATE (a)-[:CloudEdge {edge_type: 'X', layer: 'aws'}]->(b)")
+    del c, db
+
+
+def counts(path):
+    c = kuzu.Connection(kuzu.Database(path))
+    q = lambda s: c.execute(s).get_next()[0]  # noqa: E731
+    return {"cloud_nodes": q("MATCH (n:CloudNode) RETURN count(*)"),
+            "cloud_edges": q("MATCH ()-[e:CloudEdge]->() RETURN count(*)"),
+            "commits": q("MATCH (n:FabricNode) WHERE n.node_type = 'COMMIT' RETURN count(*)"),
+            "links": q("MATCH ()-[e:FabricLink]->() RETURN count(*)")}
+
+
+def test_overlay_isolated_incremental_ranked_and_expiring():
+    with tempfile.TemporaryDirectory() as td:
+        db = os.path.join(td, "g.kuzu")
+        estate_db(db)
+        a = rec("a" * 40, "2026-10-08T10:00:00Z", "laptop", claim="inferred", infer_rev=2)
+        b = rec("b" * 40, "2026-10-08T11:00:00Z", "dell1")
+        old = rec("c" * 40, "2026-09-20T11:00:00Z", "dell2")  # outside a 7-day window
+        s3 = FakeS3({key(r): r for r in (a, b, old)})
+        st = fo.overlay(db, days=30, s3=s3, now=NOW, log=lambda m: None)
+        assert st["upserted"] == 3
+        c = counts(db)
+        assert c["cloud_nodes"] == 2 and c["cloud_edges"] == 1   # estate untouched
+        assert c["links"] == 1                                    # tf:shared-infra -> b1 only
+
+        # second pass: nothing new fetched
+        s3.gets = 0
+        fo.overlay(db, days=30, s3=s3, now=NOW, log=lambda m: None)
+        assert s3.gets == 0
+
+        # a measured record for commit a (other box key) replaces the inferred one
+        a2 = rec("a" * 40, "2026-10-08T10:00:00Z", "dell2")
+        s3.objects[key(a2)] = a2
+        fo.overlay(db, days=30, s3=s3, now=NOW, log=lambda m: None)
+        cn = kuzu.Connection(kuzu.Database(db))
+        props = json.loads(cn.execute("MATCH (n:FabricNode {node_id: $k}) RETURN n.props",
+                                      {"k": "fabric:commit:" + "a" * 40}).get_next()[0])
+        assert props["box"] == "dell2" and props["box_claim"] == "measured"
+        del cn
+
+        # shrinking the window expires the old commit
+        fo.overlay(db, days=7, s3=s3, now=NOW, log=lambda m: None)
+        assert counts(db)["commits"] == 2
+
+
+def test_estate_delete_cascades_links():
+    with tempfile.TemporaryDirectory() as td:
+        db = os.path.join(td, "g.kuzu")
+        estate_db(db)
+        r = rec("d" * 40, "2026-10-08T10:00:00Z", "laptop")
+        fo.overlay(db, days=7, s3=FakeS3({key(r): r}), now=NOW, log=lambda m: None)

+        edges += int(conn.execute("MATCH ()-[e:FabricLink]->() RETURN count(*)").get_next()[0])
+    except RuntimeError:  # no fabric tables in this artifact
+        nodes, edges = 0, 0
+    finally:
+        del conn, db
+    return nodes, edges
+

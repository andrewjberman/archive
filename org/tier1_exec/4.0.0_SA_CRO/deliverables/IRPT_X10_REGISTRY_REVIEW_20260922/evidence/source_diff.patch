index 0000000000..2c5d4ded29
--- /dev/null
+++ b/lib/tests/test_irpt_destination.py
@@ -0,0 +1,156 @@
+"""X10 remains a private closed placement, not a change to default homes."""
+from __future__ import annotations
+
+import importlib.util
+import json
+import pathlib
+import sys
+
+import pytest
+
+_ROOT = pathlib.Path(__file__).resolve().parents[2]
+_SPEC = importlib.util.spec_from_file_location("irpt_naming_test_subject", _ROOT / "lib/opal_naming.py")
+_FALLBACK = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(_FALLBACK)
+
+
+def subject():
+    return sys.modules.get("opal_naming", _FALLBACK)
+
+
+REVISION = "irpt-x10-v1"
+FIRMS = ["49financial", "cottonwood", "inflection"]
+FAMILIES = {"ORIGINAL_CSV", "NORMALIZED_PORTFOLIO", "REQUEST_COMPOSITION", "ORIGINAL_VENDOR_PDF",
+            "EXTRACTION_EVIDENCE", "PERFORMANCE", "ANALYSIS", "EXPORT_BUNDLE", "EXPORT_PDF",
+            "EXPORT_RECEIPT", "SELECTED_ACCOUNTS", "PERFORMANCE_SOURCE_EVIDENCE"}
+ARTIFACT = "ART-" + "a" * 64
+DIGEST = "b" * 64
+
+
+@pytest.mark.parametrize("firm", FIRMS)
+@pytest.mark.parametrize("family", sorted(FAMILIES))
+def test_all_registered_preview_addresses_are_private_and_nonwritable(firm, family):
+    naming = subject()
+    preview = naming.preview_reporting_destination(firm, family, ARTIFACT, DIGEST, policy_revision=REVISION)
+    assert preview["writable"] is False
+    assert preview["bucket"] == "opal-data-irpt"
+    assert preview["key"].startswith("irpt/" + firm + "/")
+    assert "/" + ARTIFACT + "/" + DIGEST + "." in preview["key"]
+    with pytest.raises(ValueError, match="not writable"):
+        naming.reporting_destination(firm, family, ARTIFACT, DIGEST, policy_revision=REVISION)
+
+
+def test_exact_family_census_and_retention_metadata():
+    row = subject().reporting_policy(REVISION)
+    assert row["register_commit"] == "705dae3202cac873a133825bee9d0381c7dd6b7f"
+    assert row["register_id"] == "X10" and row["retention_policy_id"] == "irpt-retention-v1"
+    assert set(row["families"]) == FAMILIES
+    assert row["firms"] == FIRMS
+    assert sum(s["tier"] == "state" for s in row["families"].values()) == 10
+    assert row["families"]["SELECTED_ACCOUNTS"]["accepted_ceiling_days"] == 30
+    assert row["families"]["PERFORMANCE"]["unreferenced_days"] is None
+    assert row["families"]["PERFORMANCE_SOURCE_EVIDENCE"]["unreferenced_days"] == 30
+    assert row["physical_disposal"] == "OPEN"
+
+
+@pytest.mark.parametrize("firm,family,artifact,digest", [
+    ("global", "PERFORMANCE", ARTIFACT, DIGEST),
+    ("49f", "PERFORMANCE", ARTIFACT, DIGEST),
+    ("demo", "PERFORMANCE", ARTIFACT, DIGEST),
+    ("49financial", "UNREGISTERED", ARTIFACT, DIGEST),
+    ("49financial", "PERFORMANCE", "../input", DIGEST),
+    ("49financial", "PERFORMANCE", ARTIFACT + "/other", DIGEST),
+    ("49financial", "PERFORMANCE", ARTIFACT, ".."),
+    ("49financial", "PERFORMANCE", ARTIFACT, DIGEST.upper()),
+])
+def test_unregistered_alias_and_path_injection_refused(firm, family, artifact, digest):
+    with pytest.raises(ValueError):
+        subject().preview_reporting_destination(firm, family, artifact, digest, policy_revision=REVISION)
+
+
+def test_unknown_policy_revision_refused():
+    with pytest.raises(ValueError, match="unknown"):
+        subject().reporting_policy("irpt-x10-unknown")
+
+
+@pytest.fixture
+def registry(tmp_path, monkeypatch):
+    naming = subject()
+    for name in naming.REGISTRY_FILES:
+        (tmp_path / name).write_bytes((_ROOT / naming.REGISTRY_REL / name).read_bytes())
+    monkeypatch.setattr(naming, "REGISTRY_DIR", str(tmp_path))
+    naming._CACHE.clear()
+    yield naming, tmp_path
+    naming._CACHE.clear()
+
+
+def edit_policy(path, edit):
+    file = path / "reporting_policies.json"
+    doc = json.loads(file.read_text())
+    edit(doc["policies"][0])
+    file.write_text(json.dumps(doc))
+
+
+def test_active_candidate_requires_enforcement_record_and_fresh_disable(registry):
+    naming, path = registry
+    edit_policy(path, lambda row: row.update(state="ACTIVE"))
+    with pytest.raises(ValueError, match="enforcement"):
+        naming.reporting_destination(FIRMS[0], "PERFORMANCE", ARTIFACT, DIGEST, policy_revision=REVISION)
+    edit_policy(path, lambda row: row.update(enforcement_ref="c" * 40))
+    first = naming.reporting_policy(REVISION)["policy_sha256"]
+    bucket, key = naming.reporting_destination(FIRMS[0], "PERFORMANCE", ARTIFACT, DIGEST, policy_revision=REVISION)
+    assert bucket == "opal-data-irpt" and key.startswith("irpt/49financial/platinum/performance_reports/")
+    edit_policy(path, lambda row: row.update(state="DISABLED"))
+    assert naming.reporting_policy(REVISION)["policy_sha256"] != first
+    with pytest.raises(ValueError, match="not writable"):
+        naming.reporting_destination(FIRMS[0], "PERFORMANCE", ARTIFACT, DIGEST, policy_revision=REVISION)
+
+
+@pytest.mark.parametrize("mutation", [
+    lambda row: row.update(firms=["global"]),
+    lambda row: row.update(firms=["49f"]),
+    lambda row: row.update(register_id="X11"),
+    lambda row: row.update(register_commit="latest"),
+    lambda row: row.update(state="PENDING_BUT_WRITABLE"),
+    lambda row: row.update(physical_disposal="ACTIVE"),
+    lambda row: row["families"]["PERFORMANCE"].update(accepted_ceiling_days=None),
+    lambda row: row["families"]["PERFORMANCE"].update(accepted_ceiling_days=9999),
+    lambda row: row["families"]["PERFORMANCE"].update(extension="parquet"),
+    lambda row: row["families"]["ORIGINAL_CSV"].update(unreferenced_days=None),
+])
+def test_registry_validation_refuses_malformed_policy(registry, mutation):
+    naming, path = registry
+    edit_policy(path, mutation)
+    with pytest.raises(ValueError):
+        naming.reporting_policy(REVISION)
+    errors, _warnings = naming.validate()
+    assert any(where == "reporting_policies.json" for where, _, _ in errors)
+
+
+def test_policy_changes_do_not_change_default_custody_or_platinum_homes(registry):
+    naming, path = registry
+    before = { (firm, tier): naming.address("irpt", firm, tier, "holdings", "2026-09-22")
+              for firm in FIRMS for tier in ("gold", "platinum", "state") }
+    edit_policy(path, lambda row: row.update(state="DISABLED"))
+    naming._CACHE.clear()
+    after = { key: naming.address("irpt", key[0], key[1], "holdings", "2026-09-22") for key in before }
+    assert before == after
+    assert all("opal-data-" + firm + "/" in uri for (firm, _), uri in before.items())
+
+
+def test_returned_metadata_cannot_mutate_next_read():
+    naming = subject()
+    original = naming.reporting_policy(REVISION)
+    changed = naming.reporting_policy(REVISION)
+    changed["families"].clear()
+    assert naming.reporting_policy(REVISION) == original
+
+
+def test_older_default_home_reader_does_not_require_reporting_policy(registry):
+    naming, path = registry
+    before = naming.address("irpt", "49financial", "gold", "holdings", "2026-09-22")
+    (path / "reporting_policies.json").unlink()
+    naming._CACHE.clear()
+    assert naming.address("irpt", "49financial", "gold", "holdings", "2026-09-22") == before
+    with pytest.raises(ValueError):
+        naming.reporting_policy(REVISION)

+def test_admin_accepts_portal_only_candidate(tmp_path) -> None:
+    contract = sea.load_contract()
+    assert contract["portal_grant"]["scope_dimension"] == de.PORTAL_DIMENSION
+    held = sea.load_catalog_channels()
+    assert "capital_markets" in held and set(held) == set(query_v0._catalog()["catalog"]["channels"])
+
+    store = _FakeStore()
+    out = io.StringIO()
+    plan = sea.prepare(store, _candidate(["capital_markets"]), contract, out=out)
+    assert plan.scope.portal_only
+    assert "portal_channels" in out.getvalue()
+    result = sea.activate(store, plan, approver="andrew", source_authorization="ref-oa-g-1",
+                          at="2026-09-26T00:00:00Z")
+    assert result == {"profile_revision": 1, "grant_revision": 1, "diff": plan.diff}
+    gkey = de.grant_key(_TID, _OID, 1)
+    written = store.records[(gkey.pk, gkey.sk)]
+    assert written["scope"]["portal_channels"] == ["capital_markets"] and written["scope"]["masters"] == []
+    access = de.current_access(make_principal(_TID, _OID), store)
+    assert access.grant.scope.portal_channels == frozenset({"capital_markets"}) and access.tools == frozenset()
+
+    # the CLI activate path, end to end with an injected operator identity and store
+    cand = tmp_path / "candidate.json"
+    cand.write_text(json.dumps(_candidate(["capital_markets", "valuation"])), encoding="utf-8")
+    cli_store, cli_out = _FakeStore(), io.StringIO()
+    rc = sea.main(["activate", "--candidate", str(cand), "--approver", "andrew",
+                   "--source-authorization", "ref-oa-g-1", "--at", "2026-09-26T00:00:00Z"],
+                  store=cli_store, sts_client=_FakeSts(_OPERATOR_ARN), out=cli_out)
+    assert rc == 0, cli_out.getvalue()
+    assert "ACTIVATED profile_revision=1 grant_revision=1" in cli_out.getvalue()
+
+    # a Schwab-only candidate still writes the v1.1 shape (no portal_channels key)
+    schwab_store = _FakeStore()
+    splan = sea.prepare(schwab_store, {"tid": _TID, "oid": _OID, "scope": _schwab_scope()}, contract, out=io.StringIO())
+    sea.activate(schwab_store, splan, approver="andrew", source_authorization="ref", at="2026-09-26T00:00:00Z")
+    assert "portal_channels" not in schwab_store.records[(gkey.pk, gkey.sk)]["scope"]
+

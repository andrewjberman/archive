+def test_admin_rejects_unknown_portal_channel(tmp_path) -> None:
+    contract = sea.load_contract()
+    with pytest.raises(sea.CandidateRejected, match="does not hold"):
+        sea.validate_candidate(_candidate(["capital_markets", "no_such_channel"]), contract)
+    # a contract without portal_grant admits no portal channel at all
+    old_contract = {k: v for k, v in contract.items() if k != "portal_grant"}
+    with pytest.raises(sea.CandidateRejected, match="not admitted"):
+        sea.validate_candidate(_candidate(["capital_markets"]), old_contract)
+    # empty of both is rejected through parse_scope
+    with pytest.raises(sea.CandidateRejected):
+        sea.validate_candidate(_candidate([]), contract)
+
+    # the CLI refuses and writes nothing
+    cand = tmp_path / "candidate.json"
+    cand.write_text(json.dumps(_candidate(["no_such_channel"])), encoding="utf-8")
+    store, out = _FakeStore(), io.StringIO()
+    rc = sea.main(["activate", "--candidate", str(cand), "--approver", "andrew",
+                   "--source-authorization", "ref-oa-g-1", "--at", "2026-09-26T00:00:00Z"],
+                  store=store, sts_client=_FakeSts(_OPERATOR_ARN), out=out)
+    assert rc == 2 and "REFUSED" in out.getvalue() and "no_such_channel" in out.getvalue()
+    assert store.records == {} and store.transactions == []
+

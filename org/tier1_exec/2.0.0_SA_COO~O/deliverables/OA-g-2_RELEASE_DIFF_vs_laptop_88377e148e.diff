+    access = de.current_access(make_principal(_TID, _OID),
+                               _store_with_grant(_portal_scope(["capital_markets"])))
+    assert access.restricted and access.grant.scope.portal_only
+    assert access.tools == frozenset()
+    for tool in de.SCHWAB_TOOLS:
+        assert de.decide(tool, access) is not None
+    # the positive control: the same operations on a Schwab grant DO admit Schwab tools
+    schwab = de.current_access(make_principal(_TID, _OID), _store_with_grant(_schwab_scope()))
+    assert "schwab_query" in schwab.tools
+    # the data-level check fails closed for the portal-only grant too
+    auth = de.authorize({"operation": "query", "master": "08242234", "dataset": "dim_position"},
+                        make_principal(_TID, _OID), _store_with_grant(_portal_scope(["capital_markets"])))
+    assert auth.allowed is False
+

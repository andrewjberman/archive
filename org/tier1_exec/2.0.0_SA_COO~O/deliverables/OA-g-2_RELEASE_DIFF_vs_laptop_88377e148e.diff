+# --- AC2: the asker path --------------------------------------------------------------------------------------
+def test_asker_portal_scope_admits_granted_channel(fetches) -> None:
+    (granted, key), _ = _two_servable_channels()
+    audited = []
+    result = asc.handle_asker_query("chat", "msg", key, None, token="tok", calling_email=_CALLING_EMAIL,
+                                    graph_call=_graph_call, store=_store_with_grant(_portal_scope([granted])),
+                                    audit_log=lambda *a, **k: audited.append(a))
+    assert "guard_denied" not in result, result
+    assert result["key"] == key and result["data"] == {"key": key, "value": 1}
+    assert fetches == [key]
+    assert audited[-1][2]["verdict"] == "SERVE"
+
+
+def test_asker_portal_scope_refuses_other_channel(fetches) -> None:
+    (granted, _), (other, other_key) = _two_servable_channels()
+    # the calling identity's own gate WOULD serve this key -- so the refusal below is the asker's grant alone
+    pclass, pfirm = query_v0._principal(_CALLING_EMAIL)
+    assert catalog_gate.gate(query_v0._catalog(), other_key, pclass, pfirm)
+    audited = []
+    result = asc.handle_asker_query("chat", "msg", other_key, None, token="tok", calling_email=_CALLING_EMAIL,
+                                    graph_call=_graph_call, store=_store_with_grant(_portal_scope([granted])),
+                                    audit_log=lambda *a, **k: audited.append(a))
+    assert result["guard_denied"] is True and result["asker_scope_denied"] is True
+    assert result["code"] == "asker_channel_denied" and other in result["error"]
+    assert "data" not in result and fetches == []
+    assert audited[-1][2]["verdict"] == "DENY-CHANNEL"
+    # an off-catalog key is refused too (by the calling identity's gate, before the channel check)
+    off = asc.handle_asker_query("chat", "msg", "json/not/in/catalog.json", None, token="tok",
+                                 calling_email=_CALLING_EMAIL, graph_call=_graph_call,
+                                 store=_store_with_grant(_portal_scope([granted])), audit_log=lambda *a, **k: None)
+    assert off["guard_denied"] is True and fetches == []
+    # a grant WITHOUT portal_channels behaves as today: the same key is served
+    today = asc.handle_asker_query("chat", "msg", other_key, None, token="tok", calling_email=_CALLING_EMAIL,
+                                   graph_call=_graph_call, store=_store_with_grant(_schwab_scope()),
+                                   audit_log=lambda *a, **k: None)
+    assert "guard_denied" not in today and fetches == [other_key]
+

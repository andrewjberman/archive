  "bucket": {
    "head": {
      "rc": 0,
      "stdout": "# THE VERSION STORE -- the harvest estate's object store.\n#\n# STAGE 1: declared at its CURRENT name `opal-data-research` so this module can IMPORT it\n# without touching it. Stage 2 renames it to `opal-data-harvest` per Andrew's approved\n# rename map. ⚠ THAT RENAME IS NOT FREE AND THE COST IS MEASURED, NOT ASSUMED: S3 has no\n# rename -- it is create-copy-delete. Measured 2026-09-11 by 4.0.0_SA_CRO~Z:\n#   60 object versions total | 7 NON-LATEST versions | 1 delete marker\n# A copy carries CURRENT objects only, so those 7 non-latest versions and the delete marker\n# do NOT survive the move. They are the whole cost, and it is small and nameable.\n# ⭐ WHAT THE RENAME DOES *NOT* COST, because this was nearly got wrong: FWD-6's\n# \"snapshots accumulate rather than overwrite\" evidence lives in the KEY GRAMMAR -- distinct\n# timestamped prefixes, e.g. derived/model_block/BABA_US_Equity/20260910T224432Z/ and\n# .../20260910T225428Z/, four of them for BABA alone -- and distinct keys COPY INTACT.\n# This file's own contract says so: \"versioning below is the safety net for an accidental\n# overwrite, not the mechanism the grammar relies on.\"\n#\n# Key grammar (data contract): deliverables/0.9.0_WK_AMGT_RESAPP~7/STORE_CONTRACT.md\n#   raw/<vendor>/<security_key>/<YYYYMMDDTHHMMSSZ>/<artifact>\n#   derived/<engine>/<security_key>/<YYYYMMDDTHHMMSSZ>/<artifact>\n#   packs/<security_key>/<YYYYMMDDTHHMMSSZ>/pack.json\n# Nothing is ever written to a path that already exists.\n\nresource \"aws_s3_bucket\" \"harvest\" {\n  bucket = \"opal-data-harvest\"\n\n  tags = {\n    Name      = \"opal-data-harvest\"\n    project   = \"AMGT_RESAPP\"\n    directive = \"D5\"\n    owner     = \"2.0.0_SA_COO\"\n    Purpose   = \"THE VERSION STORE -- raw before derived - snapshots accumulate - never overwrite\"\n  }\n}\n\n# Versioning ON -- the accidental-overwrite safety net beneath the key grammar.\nresource \"aws_s3_bucket_versioning\" \"harvest\" {\n  bucket = aws_s3_bucket.harvest.id\n  versioning_configuration {\n    status = \"Enabled\"\n  }\n}\n\n# SSE-S3 (AES256) default encryption -- the estate's default for an internal store.\n# No DenyUnencryptedObjectUploads statement: bucket default encryption already guarantees\n# nothing lands unencrypted, and that statement's only measured effect elsewhere was an\n# AccessDenied footgun for callers who merely omit the SSE header (monolith.tf's reasoning).\nresource \"aws_s3_bucket_server_side_encryption_configuration\" \"harvest\" {\n  bucket = aws_s3_bucket.harvest.id\n  rule {\n    apply_server_side_encryption_by_default {\n      sse_algorithm = \"AES256\"\n    }\n  }\n}\n\n# All four public-access blocks ON -- research packs are internal.\nresource \"aws_s3_bucket_public_access_block\" \"harvest\" {\n  bucket                  = aws_s3_bucket.harvest.id\n  block_public_acls       = true\n  ignore_public_acls      = true\n  block_public_policy     = true\n  restrict_public_buckets = true\n}\n\n# Deliberately NOT declared: lifecycle expiration (so accumulation is never silently\n# truncated), replication, aws_s3_bucket_notification, any EventBridge/SNS wiring.\n# A version store is a store. MEASURED 2026-09-11: no lifecycle configuration exists\n# (NoSuchLifecycleConfiguration) and no bucket policy exists (NoSuchBucketPolicy), so\n# access is IAM-only -- both confirmed against the live plane, not assumed from this file.",
      "stderr": ""
    },
    "status": {
      "rc": 0,
      "stdout": "",
      "stderr": ""
    },

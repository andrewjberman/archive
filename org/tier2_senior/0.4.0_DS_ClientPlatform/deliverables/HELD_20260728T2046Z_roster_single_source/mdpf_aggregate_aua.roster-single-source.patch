+def load_partner_roster(path: "str | None" = None) -> list:
+    """The declared roster. FAIL-CLOSED, matching the gold-side precedent already
+    established in build_portal_gold_accrual.py: a missing roster or a zero-partner
+    roster is a SystemExit, never a silent empty expectation. An empty expectation
+    is precisely the state in which every completeness field goes quiet."""
+    p = path or _ROSTER_PATH
+    try:
+        with open(p, encoding="utf-8") as fh:
+            roster = json.load(fh)
+    except Exception as e:                       # noqa: BLE001
+        raise SystemExit(f"partner roster UNREADABLE at {p}: {e} -- refusing to run "
+                         f"with an undeclared partner set")
+    partners = roster.get("partners")
+    if not partners:
+        raise SystemExit(f"{p}: roster declares ZERO partners -- refusing to guess")
+    return partners
+

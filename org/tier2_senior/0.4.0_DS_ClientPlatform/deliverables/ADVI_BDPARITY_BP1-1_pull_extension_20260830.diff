+# --- BP1-1 (ADVI_BDPARITY P1-PROBE): the RULED period set QTD / YTD / 1Y / SI --------
+# The pre-existing builder emitted Custom + two trailing CALENDAR YEARS + SinceInception,
+# which does not carry YTD or a trailing-12m 1Y (issuer amendment 2026-08-29T17:5xZ, A2).
+# These close it WITHOUT a new vendor call: 1Y needs no new BD type, and YTD defaults to
+# the PROVEN Custom shape rather than betting the single authorized pull on a type that is
+# ATTESTED only on /Dashboard/data (singular dateRange), never on performancePeriod (plural).
+YTD_MODES = ("custom", "typed", "both")
+
+# Which inception anchors "Since Inception" is a METHODOLOGY cell owned by 3.0.0_SA_CVO
+# (Andrew-direct 2026-08-29T212315Z @7a4d8a1888). This module does NOT choose it -- it
+# carries the caller's choice and records which one was used, per face A3.
+INCEPTION_ANCHORS = ("roster-trade-start", "bd-funding-inception", "our-first-linked-date")
+
+
+def _minus_one_year(iso_date: str) -> str:
+    """iso_date minus exactly one year; 29 Feb folds to 28 Feb (no calendar-invalid date)."""
+    y, m, d = (int(x) for x in iso_date.split("-"))
+    if m == 2 and d == 29:
+        return "%04d-02-28" % (y - 1)
+    return "%04d-%02d-%02d" % (y - 1, m, d)
+
+
+def _trailing_12m_range(q_end: str) -> dict:
+    """1Y as a Custom with COMPUTED dates -- NO new BD dateRange type needed (A2: 'NOT AT RISK').
+
+    A trailing full CALENDAR year is not a trailing twelve months; this is the latter.
+    The start/end BOUNDARY convention (whether the first day is a base date or an earning
+    day) is a methodology detail the probe MEASURES AND NAMES -- it is not tuned here."""
+    return {"endDate": q_end, "name": "Trailing 12 Months",
+            "startDate": _minus_one_year(q_end), "type": "Custom"}
+
+
+def _ytd_ranges(run_year: int, q_end: str, ytd_mode: str) -> list:
+    """YTD. DEFAULT 'custom' = a Jan-1 Custom, the SAME shape already proven on this endpoint.
+
+    'typed' emits BD's YearToDate type -- upgraded GUESS->ATTESTED by 1.0.0_SA_CTO 83444 from
+    Andrew's 2026-08-20 HAR, but attested on /advisor/api/v1/Dashboard/data with a SINGULAR
+    dateRange, while this endpoint takes a PLURAL array. A type valid on one endpoint is
+    EVIDENCE about the other, not proof of it -- so it is OPT-IN, never the default: exactly
+    one bounded pull is authorized and an unknown type risks the whole request, not just YTD."""
+    if ytd_mode not in YTD_MODES:
+        raise ValueError("ytd_mode must be one of %r, got %r" % (YTD_MODES, ytd_mode))
+    jan1 = "%d-01-01" % run_year
+    custom = {"endDate": q_end, "name": "Year To Date", "startDate": jan1, "type": "Custom"}
+    typed = {"endDate": q_end, "name": "Year To Date", "startDate": jan1, "type": "YearToDate"}
+    return {"custom": [custom], "typed": [typed], "both": [custom, typed]}[ytd_mode]
+

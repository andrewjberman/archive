+def resolve_feeds(feeds=None) -> list:
+    """Which feeds ONE pull spends a vendor call on. P2-CENSUS item 1.
+
+    DEFAULT IS ALL THREE, AND IT IS RULED, not merely chosen.
+    2.0.0_SA_COO 86550 asked the selector to "default to the PERFORMANCE endpoint only" (relayed by
+    1.0.0_SA_CTO 86548 -- the wording is the ISSUER'S and this docstring first misattributed it to
+    the gate). Taken literally it CHANGES A RUNNING PRODUCTION PULL: `data/assets/scripts/silver/
+    build_fact_taxsma_report.py` (:7-8, :88-89) reads `reporting_costbasis` and
+    `reporting_allocation` bronze, and OPAL_TAXSMA_PT2's scheduled fire is what lands them. A
+    performance-only default would starve that silver build SILENTLY -- no error, just two feeds
+    that stop arriving.
+    RULED by 1.0.0_SA_CTO 86634 on that measurement: the literal default is WITHDRAWN and the ruled
+    default is today's behaviour. The default PRESERVES it and the CALLER narrows -- the intent is
+    met where it costs money: P2 passes feeds=["performance"] and spends one endpoint per account
+    instead of three.
+
+    An UNLISTED feed is REFUSED rather than ignored -- silently dropping an unknown name would pull
+    fewer feeds than the caller asked for and report success."""
+    if feeds is None:
+        return list(ENDPOINTS)
+    feeds = list(feeds)
+    if not feeds:
+        raise ValueError(
+            "EMPTY feed list: a pull with no feed is not a pull. Name at least one of %r, or pass "
+            "None for the full set." % (sorted(ENDPOINTS),))
+    unknown = [f for f in feeds if f not in ENDPOINTS]
+    if unknown:
+        raise ValueError(
+            "UNKNOWN FEED(S) %r -- known feeds are %r. REFUSING rather than pulling what was not "
+            "asked for or silently skipping what was: a vendor call spent on the wrong feed is not "
+            "recoverable." % (unknown, sorted(ENDPOINTS)))
+    return feeds
+
+

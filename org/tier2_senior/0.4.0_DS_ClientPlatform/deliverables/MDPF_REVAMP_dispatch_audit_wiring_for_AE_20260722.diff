+def _audit(name):
+    """Fold the audit verdict in. ABSENT IS NOT CLEAN -- if the file is missing the marker says
+    the audit DID NOT RUN, it does not omit the field (an omitted field reads as 'fine')."""
+    p = os.path.join(out_dir, f"audit_{name}.json")
+    try:
+        with open(p, encoding="utf-8") as fh:
+            return json.load(fh).get(name) or {"error": "audit json missing its firm block"}
+    except Exception as e:                                          # noqa: BLE001
+        return {"audit_did_not_run": True, "reason": str(e)[:200],
+                "read_as": "NOT clean -- absence of a verdict is not a passing verdict"}
 print(json.dumps({
     "schema_version": "1.0",
     "marker": "mdpf_revamp_cycle_complete",
     "run_date": run_date,
     "run_id": run_id,
     "completed_at": datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),

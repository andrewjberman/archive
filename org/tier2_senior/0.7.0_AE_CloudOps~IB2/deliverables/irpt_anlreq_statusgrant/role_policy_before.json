    "arn:aws:logs:us-east-1:313476888478:log-group:/aws/lambda/irpt-status:*",
    "arn:aws:logs:us-east-1:313476888478:log-group:/aws/lambda/irpt-status"
   ],
   "Sid": "OwnLogStreamOnly"
  }
 ],
 "Version": "2012-10-17"
}

   ],
   "Sid": "ReadRetainedAnalysisFamiliesUnderThePolicyPrefixesOnly"
  },
  {
   "Action": "kms:Decrypt",
   "Effect": "Allow",
   "Resource": "arn:aws:kms:us-east-1:313476888478:key/7f4d3042-10d8-49a7-b55e-3c963cea8111",
   "Sid": "UseSystemKeyToDecryptTheTenantTablesAndDirectoryObjects"
  },
  {
   "Action": [
    "logs:PutLogEvents",
    "logs:CreateLogStream",
    "logs:CreateLogGroup"
   ],
   "Effect": "Allow",

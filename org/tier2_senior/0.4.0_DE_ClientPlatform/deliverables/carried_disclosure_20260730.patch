+def _carried_disclosure(in_month: list[str], cap: date, m_start: date) -> str:
+    """The per-partner, COMPUTED-AT-RUN-TIME carried-forward disclosure line for the CSV.
+
+    Derived from the partner's OWN last real in-month slice date -- NEVER from `cap`.
+
+    WHY NOT `cap`: `_month_cap` returns `m_end` UNCONDITIONALLY once the month is
+    complete (the deliberate full-calendar-month BILLING window -- Andrew 2026-06-25,
+    CVO-verified 2026-07-07, +$790,884 on May 49F). So on a 1st-of-next-month run
+    `cap` is the month end for EVERY partner regardless of what actually landed, and a
+    disclosure computed from it would print "data through <month end>" for a partner
+    whose tail is carried -- AFFIRMATIVELY CERTIFYING CARRIED DAYS AS REAL on the
+    partner-rebate basis. This reads `in_month` instead and changes nothing about the
+    billing window: the window stays `m_start..cap`, and this states how much of it is
+    real. The three partners run on three different cadences (measured 2026-07-30:
+    T+0 / T+2 / batch), which is why no static sentence can be true for all of them.
+
+    Also states the INTERIOR carry count: weekends, holidays and vendor gaps within the
+    month carry too, so a tail-only sentence would invite the false inference that every
+    earlier date is real.
+    """
+    if not in_month:
+        # Currently unreachable -- write_month_csvs SKIPs a partner with no in-month
+        # data before reaching here, so no CSV exists to disclose on. Kept correct in
+        # case that guard is ever reordered: emit no date rather than a wrong one.
+        return ("No daily slices were received for this month; every date in this file is "
+                "carried forward at the last known value.")
+    last_real = to_date(in_month[-1])
+    real_in_window = len([to_date(d) for d in in_month if m_start <= to_date(d) <= cap])
+    window = (cap - m_start).days + 1
+    carried_total = window - real_in_window
+    if last_real >= cap:
+        tail = "No dates at the end of this file are carried forward."
+    elif (cap - last_real).days == 1:
+        tail = f"Date {cap.isoformat()} is carried forward at the last known value."
+    else:
+        tail = (f"Dates {(last_real + timedelta(days=1)).isoformat()} through "
+                f"{cap.isoformat()} are carried forward at the last known value.")
+    return (f"Data through {last_real.isoformat()} (last daily slice received). {tail} "
+            f"{carried_total} of {window} dates in this file have no daily slice and carry "
+            f"the last known value, per the full-calendar-month billing convention.")
+
+

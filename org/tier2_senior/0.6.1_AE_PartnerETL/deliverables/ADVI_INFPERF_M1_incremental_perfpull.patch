+def _load_prior_bronze(s3, pull_date: dt.date) -> tuple[dict[int, list[dict]] | None, str | None]:
+    """Load the most-recent bronze/performance/{date}.jsonl.gz BEFORE pull_date.
+
+    Returns (prior_by_client, prior_date_str) where prior_by_client maps
+    client_id -> the client's continuous [{date, factor}] index (sorted by date),
+    or (None, None) if no prior bronze exists (-> caller runs a full pull).
+    """
+    paginator = s3.get_paginator("list_objects_v2")
+    keys = []
+    for page in paginator.paginate(Bucket=S3_BUCKET, Prefix=BRONZE_PERF_PREFIX):
+        for obj in page.get("Contents", []):
+            k = obj["Key"]
+            if k.endswith(".jsonl.gz"):
+                # bronze/performance/{YYYY-MM-DD}.jsonl.gz
+                stem = k.rsplit("/", 1)[-1].replace(".jsonl.gz", "")
+                try:
+                    d = dt.date.fromisoformat(stem)
+                except ValueError:
+                    continue
+                if d < pull_date:
+                    keys.append((d, k))
+    if not keys:
+        _log("no prior bronze/performance partition < pull_date -- full pull")
+        return None, None
+    keys.sort()
+    prior_date, prior_key = keys[-1]
+    obj = s3.get_object(Bucket=S3_BUCKET, Key=prior_key)
+    raw = gzip.decompress(obj["Body"].read()).decode("utf-8")
+    by_client: dict[int, list[dict]] = {}
+    for line in raw.splitlines():
+        if not line.strip():
+            continue
+        rec = json.loads(line)
+        cid = int(rec["client_id"])
+        by_client.setdefault(cid, []).append({"date": rec["date"], "factor": rec["factor"]})
+    for cid in by_client:
+        by_client[cid].sort(key=lambda r: r["date"])
+    _log(f"prior bronze loaded: {prior_key} -- {len(by_client)} clients, "
+         f"{sum(len(v) for v in by_client.values()):,} rows")
+    return by_client, prior_date.isoformat()
+
+
+def _pull_client_incremental(
+    jwt: str, client_id: int, prior_rows: list[dict], end: dt.date,
+    limiter: AdaptiveRateLimiter,
+) -> tuple[list[dict] | None, str]:
+    """Extend a client's prior continuous index with ONE trailing window.
+
+    Pulls [anchor_date, end] (anchor_date = the client's last prior-bronze date),
+    chain-links the within-window daily returns onto the prior cumulative factor at
+    the splice, and returns the gap-free merged index. Status:
+      'ok'       -> merged rows returned
+      'escalate' -> caller must full-pull this client (new client / gap > TRAILING_DAYS
+                    / anchor missing / integrity fail -- NEVER splice onto a bad anchor)
+      'fail'     -> the trailing fetch hard-failed
+    """
+    if not prior_rows:
+        return None, "escalate"  # new client -> full pull
+
+    try:
+        last_date = dt.date.fromisoformat(prior_rows[-1]["date"][:10])
+    except (ValueError, TypeError, KeyError):
+        return None, "escalate"
+    if (end - last_date).days > TRAILING_DAYS:
+        return None, "escalate"  # data gap wider than the trailing window -> full pull
+
+    # Re-anchor SETTLE_DAYS back onto a SETTLED date (the prior bronze's last days are
+    # provisional and get revised); keep prior rows THROUGH the anchor, re-pull the rest.
+    settle_cutoff = last_date - dt.timedelta(days=SETTLE_DAYS)
+    anchor_idx = None
+    for i in range(len(prior_rows) - 1, -1, -1):
+        if prior_rows[i]["date"][:10] <= settle_cutoff.isoformat():
+            anchor_idx = i
+            break
+    if anchor_idx is None:
+        return None, "escalate"  # prior too short to find a settled anchor -> full pull
+
+    anchor_date_str = prior_rows[anchor_idx]["date"][:10]
+    try:
+        anchor_date = dt.date.fromisoformat(anchor_date_str)
+        anchor_factor = float(prior_rows[anchor_idx]["factor"])
+    except (ValueError, TypeError, KeyError):
+        return None, "escalate"
+    if (end - anchor_date).days <= 0:
+        return list(prior_rows), "ok"  # already current
+
+    details, status = _fetch_window(jwt, client_id, anchor_date, end, limiter)
+    if status != 200:
+        return None, "fail"
+    # CTO condition 1 -- ANCHOR-OVERLAP HARD-ASSERT: the window MUST anchor on the
+    # settled anchor_date with a usable factor. Never splice onto a missing/mismatched anchor.
+    if not details or (details[0].get("asOfDate") or "")[:10] != anchor_date_str:
+        return None, "escalate"
+    if details[0].get("factor") in (None, 0):
+        return None, "escalate"
+
+    cum = 1.0
+    new_rows: list[dict] = []
+    for i in range(1, len(details)):
+        prev_f = details[i - 1]["factor"]
+        cur_f = details[i]["factor"]
+        r = 0.0 if (prev_f in (None, 0) or cur_f is None) else (cur_f / prev_f - 1.0)
+        cum *= (1.0 + r)
+        d_str = (details[i].get("asOfDate") or "")[:10]
+        if d_str and d_str > anchor_date_str:  # dates strictly after the settled splice
+            new_rows.append({"date": d_str, "factor": anchor_factor * cum})
+
+    # keep prior THROUGH the settled anchor; the re-pull replaces the provisional tail.
+    merged = list(prior_rows[:anchor_idx + 1]) + new_rows
+
+    # CTO condition 2 -- INTEGRITY ASSERTS on the merged frame (per-client, fail-isolated):
+    # inception anchored at 1.0 + strictly positive factors. A fail escalates THIS client.
+    if abs(float(merged[0]["factor"]) - 1.0) > 1e-9:
+        return None, "escalate"
+    if any((r["factor"] is None or float(r["factor"]) <= 0) for r in merged):
+        return None, "escalate"
+    return merged, "ok"
+
+
+def _run_parity_check(
+    jwt: str, prior_by_client: dict[int, list[dict]], all_rows: list[dict],
+    end: dt.date, limiter: AdaptiveRateLimiter, tol: float = 1e-4,
+) -> bool:
+    """CTO condition 3: re-pull ONE incrementally-served client via the FULL path and
+    assert its continuous index matches the incremental one (relative tol on shared dates).
+
+    Picks the incrementally-served client with the most rows (a well-established series =
+    the strongest drift test). Returns True on parity, False on divergence.
+    """
+    inc_by_client: dict[int, dict[str, float]] = {}
+    for rec in all_rows:
+        inc_by_client.setdefault(int(rec["client_id"]), {})[rec["date"][:10]] = float(rec["factor"])
+    # candidates = clients that HAD a prior index (went the incremental path)
+    candidates = [cid for cid in inc_by_client if cid in prior_by_client]
+    if not candidates:
+        _log("parity: no incrementally-served client to check (all escalated) -- skip")
+        return True
+    cid = max(candidates, key=lambda c: len(inc_by_client[c]))
+    full_rows, status = _pull_client_continuous(jwt, cid, end, limiter)
+    if status != "ok" or not full_rows:
+        _log(f"parity: full re-pull of client {cid} returned {status} -- inconclusive, skip")
+        return True
+    full_map = {r["date"][:10]: float(r["factor"]) for r in full_rows}
+    inc_map = inc_by_client[cid]
+    shared = sorted(set(full_map) & set(inc_map))
+    if not shared:
+        _log(f"parity: no shared dates for client {cid} -- inconclusive, skip")
+        return True
+    max_rel = 0.0
+    worst_date = None
+    for d in shared:
+        f, g = full_map[d], inc_map[d]
+        if f == 0:
+            continue
+        rel = abs(g / f - 1.0)
+        if rel > max_rel:
+            max_rel, worst_date = rel, d
+    _log(f"parity: client={cid} shared_dates={len(shared)} max_rel_diff={max_rel:.2e} "
+         f"@ {worst_date} tol={tol:.0e} -> {'PASS' if max_rel <= tol else 'FAIL'}")
+    return max_rel <= tol
+

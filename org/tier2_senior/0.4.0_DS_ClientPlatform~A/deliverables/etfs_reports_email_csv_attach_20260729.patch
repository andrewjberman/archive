+def _month_csv_keys(month: str) -> list[str]:
+    """The per-firm simple CSV grids the renderer uploads beside the PDF
+    (render_month_end.write_month_csvs, Andrew-direct 2026-07-07):
+    {REPORTS_PREFIX}/{month}/opaletfs_{firm}_{YYYYMM}.csv. ENUMERATED from S3,
+    never constructed -- a partner with no in-month data has no CSV (the
+    renderer SKIPs it), and the email must reflect what exists."""
+    prefix = f"{REPORTS_PREFIX}/{month}/"
+    r = _s3.list_objects_v2(Bucket=ETFS_BUCKET, Prefix=prefix)
+    return sorted(o["Key"] for o in r.get("Contents", [])
+                  if o["Key"].endswith(".csv"))
+

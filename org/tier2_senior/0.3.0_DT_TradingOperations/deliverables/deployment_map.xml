    <module name="portfolio-management" authority="full">
      <path>infra/aws/terraform/portfolio-management/</path>
      <current_tag>none</current_tag>
      <state_key>none</state_key>
      <note>Not yet tagged. Portfolio management Terraform module.</note>
    </module>

  </terraform_modules>

  <!-- =========================================================== -->
  <!-- LAMBDA FUNCTIONS                                             -->
  <!-- =========================================================== -->

  <lambdas>

    <!-- smartx-pipeline -->
    <lambda pipeline="smartx-pipeline">
      <name>smartx-ec2-autostart</name>
      <deployed_tag>smartx-v2.0.0</deployed_tag>

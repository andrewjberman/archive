  <!-- =========================================================== -->

  <terraform_modules>

    <module name="smartx-pipeline" authority="full">
      <path>infra/aws/terraform/smartx-pipeline/</path>
      <current_tag>smartx-v2.0.0</current_tag>
      <state_key>smartx-pipeline/tfstate</state_key>

{
    "Statement": [
        {
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:GetBucketLocation",
                "s3:ListBucketVersions",
                "s3:GetBucket*"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::opal-*",
                "arn:aws:s3:::opal-*/*"
            ],
            "Sid": "S3ObjectsOnOpalBuckets"
        },
        {
            "Action": [
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:PublishVersion",
                "lambda:CreateAlias",
                "lambda:UpdateAlias",
                "lambda:InvokeFunction",
                "ecs:RegisterTaskDefinition",
                "ecs:DeregisterTaskDefinition",
                "ecs:CreateService",
                "ecs:UpdateService",
                "ecs:RunTask",
                "ecs:StopTask",
                "events:PutRule",
                "events:DeleteRule",
                "events:PutTargets",
                "events:RemoveTargets",
                "events:EnableRule",
                "events:DisableRule",
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan",
                "dynamodb:BatchGetItem",
                "dynamodb:BatchWriteItem",
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "logs:FilterLogEvents",
                "logs:StartQuery",
                "logs:StopQuery"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "DeployServices"
        },
        {
            "Action": [
                "sqs:SendMessage",
                "sqs:GetQueueUrl",
                "sqs:GetQueueAttributes"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:sqs:us-east-1:313476888478:agentbus-ajbdev-sitez-to-laptop.fifo",
                "arn:aws:sqs:us-east-1:313476888478:agentbus-ajbdev-laptop-to-sitez.fifo",
                "arn:aws:sqs:us-east-1:313476888478:agentbus-global-dell1-queue*",
                "arn:aws:sqs:us-east-1:313476888478:agentbus-global-dell2-queue*"
            ],
            "Sid": "AgentbusSendToInboundQueues"
        },
        {
            "Action": [
                "sts:GetCallerIdentity",
                "ec2:Describe*",
                "iam:Get*",
                "iam:List*",
                "kms:Describe*",
                "kms:Get*",
                "kms:List*",
                "lambda:Get*",
                "lambda:List*",
                "ecs:Describe*",
                "ecs:List*",
                "events:Describe*",
                "events:List*",
                "dynamodb:Describe*",
                "dynamodb:List*",
                "logs:Describe*",
                "logs:Get*",
                "logs:List*",
                "sqs:List*",
                "sns:Get*",
                "sns:List*",
                "cloudwatch:Describe*",
                "cloudwatch:Get*",
                "cloudwatch:List*",
                "cloudtrail:Describe*",
                "cloudtrail:Get*",
                "cloudtrail:List*",
                "cloudtrail:LookupEvents",
                "rds:Describe*",
                "rds:List*",
                "s3:ListAllMyBuckets",
                "ecr:Describe*",
                "ecr:Get*",
                "ecr:List*",
                "application-autoscaling:Describe*",
                "tag:Get*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "ReadOnlyForTerraformPlan"
        },
        {
            "Action": [
                "iam:Create*",
                "iam:Delete*",
                "iam:Put*",
                "iam:Attach*",
                "iam:Detach*",
                "iam:Update*",
                "iam:Add*",
                "iam:Remove*",
                "iam:Tag*",
                "iam:Untag*",
                "iam:Set*",
                "iam:Upload*",
                "iam:Enable*",
                "iam:Deactivate*",
                "iam:ChangePassword",
                "iam:PassRole"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "DenyEveryIamWrite"
        },
        {
            "Action": [
                "cloudtrail:Stop*",
                "cloudtrail:Delete*",
                "cloudtrail:Update*",
                "cloudtrail:Put*"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "DenyCloudTrailWrites"
        },
        {
            "Action": [
                "s3:DeleteBucket*",
                "s3:DeleteObject*",
                "s3:PutLifecycleConfiguration"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:s3:::opal-data-*",
                "arn:aws:s3:::opal-data-*/*"
            ],
            "Sid": "DenyS3DeletesOnProductionData"
        },
        {
            "Action": [
                "dynamodb:DeleteTable",
                "dynamodb:DeleteBackup",
                "rds:Delete*"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "DenyTableAndDatabaseDeletes"
        }
    ],
    "Version": "2012-10-17"
}

diff --git a/.tools/comp-which b/.tools/comp-which
index a6e6799c5..ecca17635 100644
--- a/.tools/comp-which
+++ b/.tools/comp-which
@@ -204,6 +204,31 @@ RULES = [
      "lambda",
      ["comp-iam service <fn>", "comp-aws", "pipescript --resource <fn>"],
      "what a lambda does + its IAM + its named thread"),
+    # THE THREE CLAUDE.md-MANDATED CALLS (CTO~Z ruling 223728Z). They were DECLARED in tools_index and
+    # still UNROUTABLE: the router ranks TOOLS off THIS curated vocabulary, and never reads tools_index.
+    # A declaration in a surface no consumer reads is not reachability. These sit BEFORE the generic IAM
+    # tuple so the specific intent wins over the generic one.
+    (["simulate", "simulate-principal-policy", "exact resource", "exact arn", "specific arn",
+      "brand new bucket", "new bucket", "new table", "new arn", "resource-arns", "positive control",
+      "can this role", "can the role", "write to a brand new"],
+     "IAM (action,resource)-PRECISE verification -- Rule 22a",
+     ["comp-iam simulate <role> <action> <resource_arn>"],
+     "a NEW bucket/table/ARN needs an (action,RESOURCE) verdict: `comp-iam gaps` models (action) ONLY "
+     "and is NECESSARY BUT NOT SUFFICIENT here -- a role holding the action on ANY resource reads "
+     "GRANTED for EVERY resource. ONE --resource-arns per call; positive control as a SEPARATE run"),
+    (["reconcile", "applied plane", "live iam", "iam drift", "match terraform", "matches terraform",
+      "declared vs live", "desired vs applied", "unmanaged grant", "aws-managed", "console-made",
+      "iam state", "live state", "terraform declares", "what terraform declares"],
+     "IAM APPLIED-vs-DESIRED reconcile",
+     ["comp-iam reconcile"],
+     "the ONLY comp-iam mode that overlays the APPLIED plane -- the default modes parse Terraform "
+     "(DESIRED) and are structurally blind to AWS-managed / console-made / unmanaged grants"),
+    (["postdeps", "post-run", "post run", "post-run steps", "after an ad-hoc", "ad-hoc run",
+      "adhoc run", "ad hoc run", "hand-run", "downstream rebuild", "what else must i rebuild"],
+     "required POST-STEPS for an ad-hoc gold run",
+     ["comp-pipescript postdeps [<script>]"],
+     "CLAUDE.md requires this BEFORE any ad-hoc (non-dispatch) gold run -- the $22M class: a hand-run "
+     "that leaves downstream artifacts unrebuilt half-updates the chain"),
     (["iam", "role", "perm", "permission", "policy", "grant", "allow", "deny", "principal"],
      "IAM role/policy",
      ["comp-iam service <lambda>", "comp-iam gaps"],
diff --git a/org/modules/graph/graph-call-manifest.yaml b/org/modules/graph/graph-call-manifest.yaml
index e2442f1b4..f309cf2b0 100644
--- a/org/modules/graph/graph-call-manifest.yaml
+++ b/org/modules/graph/graph-call-manifest.yaml
@@ -481,6 +481,45 @@ entries:
     anti_pattern: "dispatching a chain on stale upstream"
     status: canonical
 
+  # THE THREE CLAUDE.md-MANDATED CALLS, made ROUTABLE (CTO~Z ruling 223728Z, source-confirmed).
+  # They were DECLARED in tools_index and still UNREACHABLE: comp-which's fuzzy layer scores over
+  # entries[].{use_case,id,tool} and never reads tools_index (.tools/comp-which:1006-1010 @e6115fa66).
+  # A declaration in a surface no consumer reads is not reachability -- so the law mandated calls the
+  # router could not surface. Vocabulary lives in `use_case` because THAT is the scored field;
+  # canonical_call is DISPLAY only.
+  - id: cloud.iam.simulate_exact_resource
+    use_case: "Can this role perform this action on this EXACT resource ARN? Verify a NEW bucket / table / ARN with a positive control -- `comp-iam gaps` models (action) only and is NECESSARY BUT NOT SUFFICIENT here (CLAUDE.md Rule 22a)"
+    canonical_call: "comp-iam simulate <role> <action> <resource_arn>   # ONE arn per call; run the positive control as a SEPARATE invocation"
+    tool: comp-iam
+    mode: live
+    layer: cloud
+    cost: "~seconds (live aws iam simulate-principal-policy)"
+    freshness: "live IAM evaluation at run time (APPLIED)"
+    anti_pattern: "accepting `comp-iam gaps` GRANTED for a new bucket/table/ARN -- it models (action), never (action, resource), so a role holding the action on ANY resource reads GRANTED for EVERY resource"
+    status: canonical
+
+  - id: cloud.iam.applied_plane_reconcile
+    use_case: "Does the LIVE / APPLIED IAM state match what Terraform DECLARES? Overlay the applied plane over the desired plane -- catch AWS-managed, console-made and otherwise unmanaged grants that a Terraform parse cannot see"
+    canonical_call: "comp-iam reconcile [--census <file>] [--census-ttl-hours N]"
+    tool: comp-iam
+    mode: live
+    layer: cloud
+    cost: "~seconds (TF desired overlaid on a comp-aws live derive; age/TTL printed)"
+    freshness: "live derive snapshot, age + TTL disclosed; REFUSES past TTL rather than guessing"
+    anti_pattern: "reading comp-iam's DESIRED-plane default as the applied truth -- reconcile is the ONLY mode that overlays live"
+    status: canonical
+
+  - id: pipeline.pipescript.postdeps_before_adhoc_run
+    use_case: "What post-run steps are REQUIRED before or after an ad-hoc (non-dispatch) gold script run? Which downstream artifacts must be rebuilt so a hand-run does not leave the chain half-updated"
+    canonical_call: "comp-pipescript postdeps [<script>] [--firm bd|inf|cot|mdpf]"
+    tool: comp-pipescript
+    mode: cached
+    layer: pipeline
+    cost: "~instant (graph read)"
+    freshness: ".comp-graph build vintage"
+    anti_pattern: "an ad-hoc gold run with no postdeps check -- the $22M class (CLAUDE.md compiler-tools table makes this call REQUIRED before any ad-hoc run)"
+    status: canonical
+
   - id: pipeline.keys.enumerate
     use_case: "Which keys / partitions exist under this S3 prefix, and across which firms? (what EXISTS, not is-it-fresh)"
     canonical_call: "comp-keys prefix <bucket|s3://bucket/prefix> ; comp-keys partitions <bucket/prefix> ; comp-keys exists <suffix>"

+            return
+        except Exception:
+            pass  # marker unwritable -> fall through to the stderr last-resort (still not silent)
+    try:
+        sys.stderr.write(f"COMP_LOG_AUTO_DROP: {line}")
+    except Exception:
+        pass  # only reachable if BOTH the marker file AND stderr are unavailable

{
  "l0b_version": "1.0",
  "pairs": [
    {
      "kind": "grep_present",
      "unit": "ct-router",
      "ctype": "ADD",
      "limbs": [
        {
          "limb": "add a new (unmatched) section to the real doc",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "grep_present",
      "unit": "ct-router",
      "ctype": "REMOVE",
      "limbs": [
        {
          "limb": "UNTARGETED: remove a real non-matching line",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        },
        {
          "limb": "TARGETED: remove every line matching the unit's own pattern",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "grep_present",
      "unit": "ct-router",
      "ctype": "MODIFY",
      "limbs": [
        {
          "limb": "modify a non-matching real line's content, identity stable",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "grep_present",
      "unit": "ct-router",
      "ctype": "RENAME",
      "limbs": [
        {
          "limb": "rename the matched token estate-style (comp-which -> comp-route-v2) everywhere in the real doc",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "grep_present",
      "unit": "ct-router",
      "ctype": "REORDER",
      "limbs": [
        {
          "limb": "reverse the real doc's line order, set identity stable",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "version_pin",
      "unit": "ont-cse-version-current",
      "ctype": "ADD",
      "limbs": [
        {
          "limb": "ADD-with-discipline: new schema field + the source's own version bump (0.5 -> 0.6), real file",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        },
        {
          "limb": "ADD-without-bump: new field only, version untouched (the discipline-mediation limb)",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "version_pin",
      "unit": "ont-cse-version-current",
      "ctype": "MODIFY",
      "limbs": [
        {
          "limb": "MODIFY-with-bump: content change carrying the bump (0.5 -> 0.6)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        },
        {
          "limb": "MODIFY-without-bump: real non-version line changed, version untouched",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "version_pin",
      "unit": "ont-cse-version-current",
      "ctype": "RENAME",
      "limbs": [
        {
          "limb": "rename the CONSTANT itself (SCHEMA_VERSION -> SCHEMA_VER), content stable",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "ASSUMPTION"
        }
      ]
    },
    {
      "kind": "version_pin",
      "unit": "ont-cse-version-current",
      "ctype": "REMOVE",
      "limbs": [
        {
          "limb": "remove the version constant (the source loses its own head)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "ASSUMPTION"
        }
      ]
    },
    {
      "kind": "derived_count",
      "unit": "ct-catalog",
      "ctype": "ADD",
      "limbs": [
        {
          "limb": "add one member to the REAL tools_index mapping (yaml-level append)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "derived_count",
      "unit": "ct-catalog",
      "ctype": "REMOVE",
      "limbs": [
        {
          "limb": "remove one real member from tools_index",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "derived_count",
      "unit": "ct-catalog",
      "ctype": "RENAME",
      "limbs": [
        {
          "limb": "rename one real member key, content stable (cardinality unchanged)",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "derived_count",
      "unit": "ct-catalog",
      "ctype": "SPLIT",
      "limbs": [
        {
          "limb": "one real member becomes two (cardinality up, concept preserved)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "derived_count",
      "unit": "ct-catalog",
      "ctype": "MERGE",
      "limbs": [
        {
          "limb": "two real members become one (cardinality down)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "grep_absent",
      "unit": "ont-sdk-vocabulary-bound",
      "ctype": "ADD",
      "limbs": [
        {
          "limb": "ADD the forbidden marker back into the real file (regression limb)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        },
        {
          "limb": "ADD an unrelated member (untargeted)",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "file_exists",
      "unit": "eng-synthesis",
      "ctype": "REMOVE",
      "limbs": [
        {
          "limb": "the real doc disappears",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "file_exists",
      "unit": "eng-synthesis",
      "ctype": "MODIFY",
      "limbs": [
        {
          "limb": "gut the real doc to one byte, path stable",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "file_exists",
      "unit": "eng-synthesis",
      "ctype": "RENAME",
      "limbs": [
        {
          "limb": "the doc moves: old path absent, content lives at a new path",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    },
    {
      "kind": "glob_count_ge",
      "unit": "inf-sdk-tf",
      "ctype": "ADD",
      "limbs": [
        {
          "limb": "a new .tf lands (count 16 -> 17)",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        }
      ]
    },
    {
      "kind": "glob_count_ge",
      "unit": "inf-sdk-tf",
      "ctype": "REMOVE",
      "limbs": [
        {
          "limb": "one of 16 files leaves (floor min=1 not crossed)",
          "class": "MONOTONE-BLIND",
          "before": "PASS",
          "after": "PASS"
        },
        {
          "limb": "ALL files leave (floor crossed)",
          "class": "SENSITIVE",
          "before": "PASS",
          "after": "FAIL"
        }
      ]
    }
  ]

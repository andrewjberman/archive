{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "L3W3 view P (firm partition) -- the typed surface a consumer may reject on",
 "description": "Mechanises the three value_domain constraints the certified rectangle declares for L3W3-dc02-4 / -5 / -7 (rectangle.final.certified.json @94935b740e), plus the two refusals the face states in prose and nothing else enforced: ABSENT must stay a masked count and never become a comparable 0.0, and arms[P].effective_partition must NOT appear as a live second token beside firm_representation. A prose refusal that no validator can fire is a promise, not a control.",
 "type": "object",
 "required": ["schema", "view_id", "executor", "task_order", "rows"],
 "properties": {
  "schema": {"const": "nfra-c3materialize.l3w3.view-prep/1.0"},
  "view_id": {"const": "P"},
  "executor": {"const": "0.8.0_AE_CloudComp~Y"},
  "task_order": {"const": "NFRA_C3MATERIALIZE.TO-L3W3-CCY"},
  "rows": {
   "type": "object",
   "required": [
    "population_binding",
    "feature_derivation",
    "coverage_measured_absent",
    "role_typing",
    "basis_declarability",
    "base_rate",
    "firm_representation",
    "coverage_vs_fanout",
    "provenance"
   ],
   "properties": {
    "role_typing": {
     "type": "object",
     "required": ["cell_id", "value"],
     "properties": {
      "cell_id": {"const": "L3W3-dc02-4"},
      "value": {
       "type": "object",
       "required": ["role", "six_three"],
       "properties": {
        "role": {"enum": ["CONTROL_ONLY"]},
        "six_three": {"enum": ["6.3_NOT_A_RESULT"]}
       }
      }
     }
    },
    "basis_declarability": {
     "type": "object",
     "required": ["cell_id", "value"],
     "properties": {
      "cell_id": {"const": "L3W3-dc02-5"},
      "value": {
       "type": "object",
       "required": ["basis", "declarability"],
       "properties": {
        "basis": {"enum": ["INFERRED"]},
        "declarability": {"enum": ["NAMED_GAP_STORE_OWNER"]}
       }
      }
     }
    },
    "firm_representation": {
     "type": "object",
     "required": ["cell_id", "value"],
     "properties": {
      "cell_id": {"const": "L3W3-dc02-7"},
      "value": {
       "type": "object",
       "required": ["firm_representation", "mdpf_share_of_ones"],
       "not": {
        "anyOf": [
         {"required": ["effective_partition"]},
         {"required": ["arms[P].effective_partition"]}
        ]
       },
       "properties": {
        "firm_representation": {"enum": ["bd_vs_inf"]},
        "mdpf_share_of_ones": {"type": "number", "exclusiveMinimum": 0}
       }
      }
     }
    },
    "coverage_measured_absent": {
     "type": "object",
     "required": ["cell_id", "value"],
     "properties": {
      "cell_id": {"const": "L3W3-dc02-3"},
      "value": {
       "type": "object",
       "required": ["MEASURED", "ABSENT", "denominator", "absent_semantics",
                    "metric_domain_both_measured"],
       "properties": {
        "MEASURED": {"type": "integer", "exclusiveMinimum": 0},
        "ABSENT": {
         "type": "integer",
         "exclusiveMinimum": 0,
         "description": "STRICTLY POSITIVE ON PURPOSE. An ABSENT coerced to 0.0 -- the exact failure the face forbids -- lands here as 0 and is REFUSED. A schema that allowed 0 would admit the coercion silently."
        },
        "denominator": {"const": 19482},
        "metric_domain_both_measured": {"const": 893116}
       }
      }
     }
    }
   }
  }
 }
}

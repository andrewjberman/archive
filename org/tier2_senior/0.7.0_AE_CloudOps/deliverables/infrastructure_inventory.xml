    <pipeline name="portal-auth" terraform_dir="infra/aws/terraform/portal-auth/" tag="portal-auth-v1.11.0">

      <tf_files>
        <tf_file name="main.tf">Provider/backend (S3: portal-auth/tfstate), variable enable_lambda_edge</tf_file>
        <tf_file name="iam.tf">IAM roles: opalinvest-auth-lambda-role (DynamoDB, SecretsManager, SES), lambda-edge-execution-role (SecretsManager, CloudWatch). Data source for opal-portal-lambda-role.</tf_file>
        <tf_file name="lambdas.tf">Lambda functions: opalinvest-auth-handler, opal-portal-authorizer</tf_file>
        <tf_file name="lambda-edge.tf">5 Lambda@Edge functions: auth-validator-edge, tier-router-edge, cache-control-injector, public-data-router, shared-advisor-router</tf_file>
        <tf_file name="dynamodb.tf">6 DynamoDB tables: opal-firms, opal-sessions, user-permissions, opal-offices, opal-users, opal-users-v2</tf_file>
        <tf_file name="ses.tf">SES domain identity: opalinvest.dev</tf_file>
        <tf_file name="secrets.tf">Secrets Manager: opal/auth/jwt-private-key, opal/auth/jwt-public-key</tf_file>
        <tf_file name="cloudfront.tf">CloudFront cache policy: opal-scoped-advisor-by-firm (cache by X-Firm-Id, firm param, 24h TTL)</tf_file>
        <tf_file name="cloudfront-distribution.tf">CloudFront distribution EVTSA9VEHNZVH (opalinvest.dev). 5 origins, 13 ordered cache behaviors, edge function associations, ACM cert, SPA error responses.</tf_file>
      </tf_files>

      <lambda_functions>
        <lambda name="opalinvest-auth-handler"
                source_dir="infra/aws/lambda/portal_authorizer/"
                tf_resource="aws_lambda_function.auth_handler"
                runtime="nodejs20.x"
                memory_mb="256"
                timeout_s="30"
                trigger="API Gateway (/auth/*)"
                last_deployed="5c8ac135 @ 2026-04-06">
          Portal auth handler — login, signup, token refresh, password reset via Cognito + DynamoDB + SES
        </lambda>
        <lambda name="opal-portal-authorizer"
                source_dir="infra/aws/lambda/portal_authorizer/"
                tf_resource="aws_lambda_function.portal_authorizer"
                runtime="nodejs20.x"
                memory_mb="256"
                timeout_s="10"
                trigger="API Gateway (authorizer)"
                last_deployed="5c8ac135 @ 2026-04-06">
          API Gateway Lambda authorizer — JWT validation for /api/scoped/* and /api/private/* routes
        </lambda>
        <lambda name="auth-validator-edge"
                source_dir="infra/aws/lambda-edge/"
                tf_resource="aws_lambda_function.auth_validator_edge[0]"
                runtime="nodejs20.x"
                memory_mb="128"
                timeout_s="5"
                trigger="CloudFront Lambda@Edge (viewer-request)"
                last_deployed="5c8ac135 @ 2026-04-06">
          Lambda@Edge: JWT validation on viewer-request for auth-gated CloudFront behaviors. Version 9 pinned.
        </lambda>
        <lambda name="tier-router-edge"
                source_dir="infra/aws/lambda-edge/tier-router-edge/"
                tf_resource="aws_lambda_function.tier_router_edge[0]"
                runtime="nodejs20.x"
                memory_mb="128"
                timeout_s="5"
                trigger="CloudFront Lambda@Edge (origin-request)"
                last_deployed="5c8ac135 @ 2026-04-06">
          Lambda@Edge: tier-based routing for origin requests
        </lambda>
        <lambda name="cache-control-injector"
                source_dir="infra/aws/lambda-edge/"
                tf_resource="aws_lambda_function.cache_control_injector[0]"
                runtime="nodejs20.x"
                memory_mb="128"
                timeout_s="3"
                trigger="CloudFront Lambda@Edge (origin-response)"
                last_deployed="5c8ac135 @ 2026-04-06">
          Lambda@Edge: injects Cache-Control headers on origin responses
        </lambda>
        <lambda name="public-data-router"
                source_dir="infra/aws/lambda/public-data-router/"
                tf_resource="aws_lambda_function.public_data_router[0]"
                runtime="nodejs20.x"
                memory_mb="128"
                timeout_s="3"
                trigger="CloudFront Lambda@Edge (viewer-request)"
                last_deployed="5c8ac135 @ 2026-04-06">
          Lambda@Edge: rewrites public data paths (/api/general/*) to S3 origins
        </lambda>
        <lambda name="shared-advisor-router"
                source_dir="infra/aws/lambda/shared-advisor-router/"
                tf_resource="aws_lambda_function.shared_advisor_router[0]"
                runtime="nodejs20.x"
                memory_mb="128"
                timeout_s="5"
                trigger="CloudFront Lambda@Edge (origin-request)"
                last_deployed="5c8ac135 @ 2026-04-06">
          Lambda@Edge: rewrites /api/scoped/advisor-intelligence/*.json to S3-opal-data-bd paths by firmId
        </lambda>
      </lambda_functions>

      <iam_roles>
        <role name="opalinvest-auth-lambda-role" tf_resource="aws_iam_role.auth_handler">
          DynamoDB: opal-users, opal-users-v2, opal-sessions, opal-firms, opal-offices, user-permissions.
          SecretsManager: opalinvest/*, opal/*.
          SES: SendEmail/SendRawEmail on opalinvest.dev.
        </role>
        <role name="lambda-edge-execution-role" tf_resource="aws_iam_role.lambda_edge">
          SecretsManager: opal/auth/*.
          CloudWatch: logs in us-east-1.
          Basic Lambda execution.
        </role>
      </iam_roles>

      <triggers>
        <trigger type="CloudFront" resource="EVTSA9VEHNZVH">
          auth-validator-edge:9 on viewer-request for /api/general/trades/*, /api/scoped/data-refresh/*, /api/scoped/advisor-intelligence/*.json, /api/general/json-tiered/*, /api/general/*, /api/private/*, /v1/*, /api/scoped/partners/*, /api/partners.
          shared-advisor-router:8 on origin-request for /api/scoped/advisor-intelligence/*.json.
          public-data-router:4 on viewer-request for /api/general/json-tiered/*, /api/general/*.
          cache-control-injector:1 on origin-response for /api/general/json-tiered/*, /api/general/*.
        </trigger>
      </triggers>


{
  "aws_iam_policy.dell_agent_deploy": {
    "Statement": [
      {
        "Action": [
          "s3:GetObject",
          "s3:GetObjectVersion",
          "s3:PutObject",
          "s3:ListBucket",
          "s3:GetBucketLocation",
          "s3:ListBucketVersions",
          "s3:GetBucket*"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:s3:::opal-*",
          "arn:aws:s3:::opal-*/*"
        ],
        "Sid": "S3ObjectsOnOpalBuckets"
      },
      {
        "Action": [
          "lambda:UpdateFunctionCode",
          "lambda:UpdateFunctionConfiguration",
          "lambda:PublishVersion",
          "lambda:CreateAlias",
          "lambda:UpdateAlias",
          "lambda:InvokeFunction",
          "ecs:RegisterTaskDefinition",
          "ecs:DeregisterTaskDefinition",
          "ecs:CreateService",
          "ecs:UpdateService",
          "ecs:RunTask",
          "ecs:StopTask",
          "events:PutRule",
          "events:DeleteRule",
          "events:PutTargets",
          "events:RemoveTargets",
          "events:EnableRule",
          "events:DisableRule",
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:DeleteItem",
          "dynamodb:Query",
          "dynamodb:Scan",
          "dynamodb:BatchGetItem",
          "dynamodb:BatchWriteItem",
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents",
          "logs:FilterLogEvents",
          "logs:StartQuery",
          "logs:StopQuery"
        ],
        "Effect": "Allow",
        "Resource": "*",
        "Sid": "DeployServices"
      },
      {
        "Action": [
          "sqs:SendMessage",
          "sqs:GetQueueUrl",
          "sqs:GetQueueAttributes"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:sqs:us-east-1:313476888478:agentbus-ajbdev-sitez-to-laptop.fifo",
          "arn:aws:sqs:us-east-1:313476888478:agentbus-ajbdev-laptop-to-sitez.fifo",
          "arn:aws:sqs:us-east-1:313476888478:agentbus-global-dell1-queue*",
          "arn:aws:sqs:us-east-1:313476888478:agentbus-global-dell2-queue*"
        ],
        "Sid": "AgentbusSendToInboundQueues"
      },
      {
        "Action": [
          "sts:GetCallerIdentity",
          "ec2:Describe*",
          "iam:Get*",
          "iam:List*",
          "kms:Describe*",
          "kms:Get*",
          "kms:List*",
          "lambda:Get*",
          "lambda:List*",
          "ecs:Describe*",
          "ecs:List*",
          "events:Describe*",
          "events:List*",
          "dynamodb:Describe*",
          "dynamodb:List*",
          "logs:Describe*",
          "logs:Get*",
          "logs:List*",
          "sqs:List*",
          "sns:Get*",
          "sns:List*",
          "cloudwatch:Describe*",
          "cloudwatch:Get*",
          "cloudwatch:List*",
          "cloudtrail:Describe*",
          "cloudtrail:Get*",
          "cloudtrail:List*",
          "cloudtrail:LookupEvents",
          "rds:Describe*",
          "rds:List*",
          "s3:ListAllMyBuckets",
          "ecr:Describe*",
          "ecr:Get*",
          "ecr:List*",
          "application-autoscaling:Describe*",
          "tag:Get*"
        ],
        "Effect": "Allow",
        "Resource": "*",
        "Sid": "ReadOnlyForTerraformPlan"
      },
      {
        "Action": [
          "cloudtrail:Stop*",
          "cloudtrail:Update*",
          "cloudtrail:DeleteChannel",
          "cloudtrail:DeleteDashboard",
          "cloudtrail:DeleteEventDataStore",
          "cloudtrail:DeleteTrail",
          "cloudtrail:PutEventConfiguration",
          "cloudtrail:PutEventSelectors",
          "cloudtrail:PutInsightSelectors"
        ],
        "Effect": "Deny",
        "Resource": "*",
        "Sid": "DenyCloudTrailWrites"
      },
      {
        "Action": [
          "s3:DeleteBucket*",
          "s3:DeleteObject*",
          "s3:PutLifecycleConfiguration"
        ],
        "Effect": "Deny",
        "Resource": [
          "arn:aws:s3:::opal-data-*",
          "arn:aws:s3:::opal-data-*/*"
        ],
        "Sid": "DenyS3DeletesOnProductionData"
      },
      {
        "Action": [
          "dynamodb:DeleteTable",
          "dynamodb:DeleteBackup",
          "rds:Delete*"
        ],
        "Effect": "Deny",
        "Resource": "*",
        "Sid": "DenyTableAndDatabaseDeletes"
      },
      {
        "Action": "apigateway:GET",
        "Effect": "Deny",
        "Resource": [
          "arn:aws:apigateway:*::/apikeys",
          "arn:aws:apigateway:*::/apikeys/*"
        ],
        "Sid": "DenyApiKeyReads"
      },
      {
        "Action": [
          "lambda:UpdateFunctionCode",
          "lambda:UpdateFunctionConfiguration",
          "lambda:PublishVersion",
          "lambda:CreateAlias",
          "lambda:UpdateAlias",
          "lambda:DeleteFunction",
          "lambda:DeleteAlias",
          "lambda:PutFunctionConcurrency",
          "lambda:UpdateFunctionUrlConfig",
          "lambda:CreateFunctionUrlConfig"
        ],
        "Effect": "Deny",
        "Resource": [
          "arn:aws:lambda:us-east-1:313476888478:function:auth-validator-edge",
          "arn:aws:lambda:us-east-1:313476888478:function:auth-validator-edge:*",
          "arn:aws:lambda:us-east-1:313476888478:function:cache-control-injector",
          "arn:aws:lambda:us-east-1:313476888478:function:cache-control-injector:*",
          "arn:aws:lambda:us-east-1:313476888478:function:opal-portal-authorizer",
          "arn:aws:lambda:us-east-1:313476888478:function:opal-portal-authorizer:*",
          "arn:aws:lambda:us-east-1:313476888478:function:opal-portal-rest-authorizer",
          "arn:aws:lambda:us-east-1:313476888478:function:opal-portal-rest-authorizer:*",
          "arn:aws:lambda:us-east-1:313476888478:function:opalinvest-auth-handler",
          "arn:aws:lambda:us-east-1:313476888478:function:opalinvest-auth-handler:*",
          "arn:aws:lambda:us-east-1:313476888478:function:public-data-router",
          "arn:aws:lambda:us-east-1:313476888478:function:public-data-router:*",
          "arn:aws:lambda:us-east-1:313476888478:function:shared-advisor-router",
          "arn:aws:lambda:us-east-1:313476888478:function:shared-advisor-router:*",
          "arn:aws:lambda:us-east-1:313476888478:function:shared-advisor-router-response",
          "arn:aws:lambda:us-east-1:313476888478:function:shared-advisor-router-response:*",
          "arn:aws:lambda:us-east-1:313476888478:function:trade-auth-handler",
          "arn:aws:lambda:us-east-1:313476888478:function:trade-auth-handler:*",
          "arn:aws:lambda:us-east-1:313476888478:function:trade-authorizer",
          "arn:aws:lambda:us-east-1:313476888478:function:trade-authorizer:*"
        ],
        "Sid": "DenyProtectedFunctions"
      }
    ],
    "Version": "2012-10-17"
  },

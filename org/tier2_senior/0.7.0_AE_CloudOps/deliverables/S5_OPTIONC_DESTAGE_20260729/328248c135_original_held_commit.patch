+  # 7b. MDPF_REVAMP.S5 Option-C -- 9 exact-path direct behaviors -> opal-data-assets
+  # OAC origin. EXACT clones of behavior 8 (/api/general/*) below; ONLY path_pattern
+  # + target_origin_id differ. Placed BEFORE behavior 8 so the exact paths win over
+  # the catch-all (CloudFront evaluates ordered behaviors by position, first match
+  # wins). The retained public-data-router rewrites /api/general/X -> /json/X (the
+  # published assets key layout) and the assets OAC signs the rewritten request.
+  # THE FLIP = these 9 behaviors; ROLLBACK = remove this block (the 9 paths fall back
+  # to behavior 8 -> portal-v2, which the legacy nightly keeps writing = the shadow).
+  dynamic "ordered_cache_behavior" {
+    for_each = local.mdpf_assets_behavior_paths
+    content {
+      path_pattern           = ordered_cache_behavior.value
+      target_origin_id       = "S3-opal-data-assets"
+      viewer_protocol_policy = "redirect-to-https"
+      allowed_methods        = ["GET", "HEAD"]
+      cached_methods         = ["GET", "HEAD"]
+      compress               = true
+      cache_policy_id          = data.aws_cloudfront_cache_policy.caching_optimized.id
+      origin_request_policy_id = data.aws_cloudfront_origin_request_policy.cors_s3_origin.id
+
+      lambda_function_association {
+        event_type   = "viewer-request"
+        lambda_arn   = local.auth_validator_edge_arn
+        include_body = false
+      }
+
+      lambda_function_association {
+        event_type   = "origin-request"
+        lambda_arn   = local.public_data_router_arn
+        include_body = false
+      }
+
+      lambda_function_association {
+        event_type   = "origin-response"
+        lambda_arn   = local.cache_control_injector_arn
+        include_body = false
+      }
+    }
+  }
+
   # 8. /api/general/* -> S3 opal-data-portal-v2 (public + cache + rewrite)
   ordered_cache_behavior {
     path_pattern           = "/api/general/*"

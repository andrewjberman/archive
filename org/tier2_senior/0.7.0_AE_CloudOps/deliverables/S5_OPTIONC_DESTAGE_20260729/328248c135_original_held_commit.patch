+# ---------------------------------------------------------------------------
+# Origin Access Control -- opal-data-assets MDPF served keys (MDPF_REVAMP.S5, Option C)
+# ---------------------------------------------------------------------------
+# The 9 MDPF FE-read behaviors point DIRECTLY at an opal-data-assets S3 origin
+# signed by this dedicated OAC (sigv4 / always). The own-origin OAC signs natively
+# (b1-proven, isolated-distro test) so NO Lambda@Edge ORIGIN swap is needed -- an
+# L@E origin swap breaks OAC signing (403); the retained public-data-router only
+# rewrites the URI (/api/general/ -> /json/), which OAC signs after. The
+# opal-data-assets bucket policy grants THIS distribution GetObject on the 9 exact
+# keys (AllowMdpfPortalCloudFrontOACRead, SourceArn=EVTSA9VEHNZVH).
+resource "aws_cloudfront_origin_access_control" "assets" {
+  name                              = "opal-data-assets-mdpf-oac"
+  description                       = "OAC for opal-data-assets MDPF served keys (Option C direct behaviors)"
+  origin_access_control_origin_type = "s3"
+  signing_behavior                  = "always"
+  signing_protocol                  = "sigv4"
+}
+
 # ---------------------------------------------------------------------------
 # CloudFront Distribution
 # ---------------------------------------------------------------------------

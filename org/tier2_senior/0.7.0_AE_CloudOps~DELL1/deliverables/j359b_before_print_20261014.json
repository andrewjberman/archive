  "divisor": "scalars: sum of sleeve * basis share; returns: weight of the holdings with the window",
  "formula": "scalars (fee, yield, duration, beta): sum_m(sleeve_m * basis_share_m * model_value_m) / sum_m(sleeve_m * basis_share_m) over the registry's model sleeves with a model value; returns: sum(weight_pct * return over holdings WITH the window) / sum(weight_pct over holdings WITH the window)",
  "null_policy": "a model with no value for a scalar is left out of that scalar's numerator AND divisor; a holding with no return for a window is left out of that window's numerator and divisor and its weight is named in coverage.weight_null; a field with nothing behind it publishes NULL, never 0.0",
  "precedence_grain": "per ticker (a ticker's whole row comes from one source)",
  "renormalised": true,
  "return_windows": [

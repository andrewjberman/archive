+def _num(scorecard: dict, key: str) -> float:
+    """None-safe numeric coalesce. compute_scorecard leaves the observability deltas
+    (max_abs_diff / key_set_symmetric_diff / row_count_delta) as None on a clean
+    DELTA=0 run (the key is PRESENT-but-None, so dict.get's default never applies) ->
+    a bare float(None) raised TypeError and crashed _emit, so WeeklyScorecardClean
+    NEVER landed despite a clean run (0 datapoints + a paradoxically-firing absence
+    alarm on a working verifier -- the exact silent-blind class one level up). Coalesce
+    None/unparseable -> 0.0."""
+    v = scorecard.get(key)
+    try:
+        return float(v) if v is not None else 0.0
+    except (TypeError, ValueError):
+        return 0.0
+
+

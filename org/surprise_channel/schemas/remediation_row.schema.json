{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "surprise-channel remediation row (SURPRISE_CHANNEL_PROTOCOL.md section 5)",
 "type": "object",
 "required": ["id", "class", "mechanism", "evidence", "remedy", "owner", "round", "remediation"],
 "additionalProperties": false,
 "properties": {
  "id": {"type": "string", "pattern": "^[A-Z0-9_]+-S[0-9]+$", "description": "== the graduated investigation item's id"},
  "class": {"enum": ["BLOCKING", "OBSERVATION", "LATENT_HAZARD"]},
  "mechanism": {"type": "string", "minLength": 12, "description": "the GROUNDED attribution, carried verbatim"},
  "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
  "remedy": {"type": "string", "minLength": 8},
  "owner": {"type": "string", "minLength": 3, "description": "the lane that builds the remediation"},
  "round": {"type": "string", "pattern": "^v[0-9]+$"},
  "disarm": {
   "type": "object",
   "required": ["state", "owner", "at"],
   "additionalProperties": false,
   "properties": {
    "state": {"enum": ["ARMED", "DISARMED"]},
    "owner": {"type": "string", "minLength": 3},
    "at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"}
   }
  },
  "remediation": {
   "type": "object",
   "required": ["state", "owner", "round"],
   "additionalProperties": false,
   "properties": {
    "state": {"enum": ["OPEN", "REMEDIATED"]},
    "owner": {"type": "string", "minLength": 3},
    "round": {"type": "string", "pattern": "^v[0-9]+$"}
   }
  },
  "closed": {"type": "boolean", "description": "DISARMED IS NOT REMEDIATED: for LATENT_HAZARD, true requires disarm.state=DISARMED AND remediation.state=REMEDIATED; for other classes, remediation.state=REMEDIATED"}
 },
 "allOf": [
  {
   "comment": "LATENT_HAZARD rows carry the two-state block -- two states, two owners, two clocks",
   "if": {"properties": {"class": {"const": "LATENT_HAZARD"}}},
   "then": {"required": ["disarm"]}
  },
  {
   "comment": "a LATENT_HAZARD row is closable only when BOTH states have landed",
   "if": {"properties": {"class": {"const": "LATENT_HAZARD"}, "closed": {"const": true}}},
   "then": {
    "properties": {
     "disarm": {"properties": {"state": {"const": "DISARMED"}}},
     "remediation": {"properties": {"state": {"const": "REMEDIATED"}}}
    }
   }
  },
  {
   "comment": "non-hazard rows close only on REMEDIATED",
   "if": {"properties": {"class": {"enum": ["BLOCKING", "OBSERVATION"]}, "closed": {"const": true}}},
   "then": {"properties": {"remediation": {"properties": {"state": {"const": "REMEDIATED"}}}}}
  }
 ]
}
